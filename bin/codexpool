# Per-machine settings. settings.json is never committed; examples/settings.json shows every key.
SETTINGS_FILE = pathlib.Path(os.environ.get('CODEXPOOL_SETTINGS') or ROOT / 'settings.json').expanduser()
SETTINGS_DEFAULTS = {
    'pool_label': 'com.codexpool.pool',        # launchd label of the pool (CLIProxyAPI)
    'guard_label': 'com.codexpool.guard',      # launchd label of `codexpool guard` (every 60 s)
    'menubar_label': 'com.codexpool.menubar',  # launchd label of the menu bar app
    'bridge_label': 'com.codexpool.bridge',    # launchd label of the lane bridge (only while a lane needs it)
    'port': 8319,                              # loopback port the pool listens on
    'bridge_port': 8320,                       # loopback port of the lane bridge (lanes/bridge.py)
    'python': None,           # interpreter for the guard and the wrapper; null: ~/.codexpool/.venv/bin/python
    'menubar_python': None,   # interpreter with PyObjC for the menu bar app; null: same as python
    'codex_bin': None,        # the codex CLI; null: the one inside the Codex app, else codex on PATH
    'headline': 'all',        # the headline %: "all" non-disabled seats, reserve included, or "regular" (no reserve)
    'display': 'left',        # numbers count "left" (down from 100%) or "used" (up from 0%)
}
HEADLINES = ('all', 'regular')
DISPLAYS = ('left', 'used')
SETTABLE = {'display': DISPLAYS, 'headline': HEADLINES}  # what `codexpool set` changes: the menu bar's two choices
LABEL_OK = re.compile(r'^[A-Za-z0-9][A-Za-z0-9._-]*$')


class SettingsError(Exception):
    """settings.json is not valid; the message says what is wrong and names the file."""


def load_settings():
    """settings.json over the defaults. A broken file stops every command, the guard included, rather than
    letting it run against the wrong port or launchd labels."""
    try:
        raw = json.loads(SETTINGS_FILE.read_text())
    except FileNotFoundError:
        raw = {}
    except (OSError, ValueError) as e:
        sys.exit(f'codexpool: cannot read {SETTINGS_FILE}: {e}')
    try:
        return parse_settings(raw)
    except SettingsError as e:
        sys.exit(f'codexpool: {e}')


def parse_settings(raw, where=None):
    """The settings a parsed settings.json gives, over the defaults (pure). Raises SettingsError for anything
    load_settings must refuse: not an object, an unknown key, a bad label, port, interpreter or choice."""
    where = where or SETTINGS_FILE
    if not isinstance(raw, dict):
        raise SettingsError(f'{where} must hold a JSON object')
    unknown = [k for k in raw if k not in SETTINGS_DEFAULTS and not str(k).startswith('_')]
    if unknown:
        raise SettingsError(f'unknown key(s) {", ".join(map(str, unknown))} in {where} '
                            f'(known: {", ".join(SETTINGS_DEFAULTS)}; keys starting with _ are ignored)')
    s = {**SETTINGS_DEFAULTS, **{k: v for k, v in raw.items() if k in SETTINGS_DEFAULTS}}
    if 'bridge_port' not in raw and s['port'] == SETTINGS_DEFAULTS['bridge_port']:
        s['bridge_port'] = s['port'] + 1  # a pool moved to 8320 before bridge_port existed keeps working
    bad = [k for k in ('pool_label', 'guard_label', 'menubar_label', 'bridge_label')
           if not isinstance(s[k], str) or not LABEL_OK.match(s[k])]
    bad += [k for k in ('python', 'menubar_python', 'codex_bin')
            if s[k] is not None and (not isinstance(s[k], str) or not s[k].strip())]
    for k in ('port', 'bridge_port'):
        if isinstance(s[k], bool) or not isinstance(s[k], int) or not 0 < s[k] < 65536:
            bad.append(k)
    if 'port' not in bad and 'bridge_port' not in bad and s['bridge_port'] == s['port']:
        bad.append('bridge_port (must differ from port)')
    bad += [f'{k} (one of: {", ".join(choices)})' for k, choices in (('headline', HEADLINES), ('display', DISPLAYS))
            if s[k] not in choices]
    if bad:
        raise SettingsError(f'invalid {", ".join(bad)} in {where}')
    return s


SETTINGS = load_settings()
PORT = SETTINGS['port']
