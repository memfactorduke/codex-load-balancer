LOG_LINE = re.compile(r'^\[(\d{4}-\d\d-\d\d \d\d:\d\d):\d\d\] \[[^\]]*\] \[[^\]]*\] \[([A-Za-z0-9_.-]+\.go):\d+\] (.*)$')
