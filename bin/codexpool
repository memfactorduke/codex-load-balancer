_LOCAL = urllib.request.build_opener(urllib.request.ProxyHandler({}))


# ---------------------------------------------------------------- small helpers

class PoolDown(Exception):
    """The pool process is not answering."""


class PoolTimeout(PoolDown):
    """The pool accepted the request but did not reply in time (usually a slow upstream)."""


class KeyUnavailable(Exception):
    """The management key could not be read from the Keychain; .fix says what to do."""

    def __init__(self, message, fix):
        super().__init__(message)
        self.fix = fix


class ApiError(Exception):
    def __init__(self, code, body):
        super().__init__(f'HTTP {code}: {str(body)[:300]}')
        self.code = code
        self.body = body


def now_utc():
    return dt.datetime.now(dt.timezone.utc)


def iso(ts):
    if ts is None:
        return None
    if isinstance(ts, (int, float)):
        return dt.datetime.fromtimestamp(ts, dt.timezone.utc).isoformat()
    return ts


def parse_time(value):
    if not value:
        return None
    if isinstance(value, dt.datetime):
        return value
    if isinstance(value, (int, float)):
        return dt.datetime.fromtimestamp(value, dt.timezone.utc)
    try:
        t = dt.datetime.fromisoformat(str(value).replace('Z', '+00:00'))
    except ValueError:
        return None
    if t.year < 2000:  # Go zero time
        return None
    return t if t.tzinfo else t.replace(tzinfo=dt.timezone.utc)


def when(value):
    """Human local time: '15:10', 'Fri 05:00', or 'Sep 30 17:53'."""
    t = parse_time(value)
    if not t:
        return '?'
    local = t.astimezone()
    today = dt.datetime.now().astimezone().date()
    if local.date() == today:
        return local.strftime('%H:%M')
    if 0 < (local.date() - today).days < 7:
        return local.strftime('%a %H:%M')
    return local.strftime('%b %d %H:%M')


def read_json(path, default):
    try:
        return json.loads(pathlib.Path(path).read_text())
    except (OSError, ValueError):
        return default


def write_json(path, data):
    path = pathlib.Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=path.name + '.', suffix='.tmp')
    try:
        with os.fdopen(fd, 'w') as f:
            f.write(json.dumps(data, indent=2, default=str) + '\n')
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


def read_guard():
    """guard.json, strictly: a corrupt file is set aside and reported, never silently treated as empty."""
    try:
        data = json.loads(GUARD_FILE.read_text())
        if not isinstance(data, dict):
            raise ValueError('guard.json is not an object')
        return data
    except FileNotFoundError:
        return {}
    except (OSError, ValueError):
        bad = GUARD_FILE.with_name(f'guard.json.corrupt-{int(time.time())}')
        with contextlib.suppress(OSError):
            os.replace(GUARD_FILE, bad)
        notify('codexpool guard state was unreadable',
               f'Saved as {bad.name}. A seat it had parked may now show as disabled: codexpool enable <seat>.')
        return {}


def log_line(message):
    with contextlib.suppress(OSError):
        LOGS.mkdir(parents=True, exist_ok=True)
        with GUARD_LOG.open('a') as f:
            f.write(f'{now_utc().isoformat()} {message}\n')


def notify(title, body):
    """macOS notification. Never raises; text travels as argv, so any characters are safe."""
    log_line(f'notify: {title} | {body}')
    with contextlib.suppress(Exception):
        subprocess.run(['osascript', '-e', 'on run argv',
                        '-e', 'display notification (item 1 of argv) with title (item 2 of argv)',
                        '-e', 'end run', '--', str(body), str(title)],
                       capture_output=True, timeout=10)


def short(message, limit=90):
    """Readable one-liner from a CLIProxyAPI status message, which may be a raw upstream JSON body."""
    if not message:
        return ''
    with contextlib.suppress(ValueError, AttributeError, TypeError):
        err = json.loads(message).get('error')
        if isinstance(err, dict):
            message = err.get('message') or err.get('type') or err.get('code') or message
    message = ' '.join(str(message).split())
    return message if len(message) <= limit else message[:limit - 1] + '…'


def port_open(port):
    with socket.socket() as s:
        s.settimeout(1)
        return s.connect_ex(('127.0.0.1', port)) == 0


def launchd_loaded(label):
    r = subprocess.run(['launchctl', 'print', f'gui/{UID}/{label}'], capture_output=True, text=True)
    if r.returncode != 0:
        return False, None
    m = re.search(r'\bpid = (\d+)', r.stdout)
    return True, int(m.group(1)) if m else None


def pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def cpa_binary():
    return CURRENT / 'cli-proxy-api'


def cpa_version():
    try:
        return os.readlink(CURRENT).rstrip('/').rsplit('/', 1)[-1].lstrip('v')
    except OSError:
        return None


def setting_path(key):
    value = SETTINGS.get(key)
    return pathlib.Path(os.path.expanduser(value)) if value else None


def python_bin():
    """The interpreter the guard and the ~/.local/bin wrapper run codexpool with."""
    return setting_path('python') or ROOT / '.venv' / 'bin' / 'python'


def menubar_python_bin():
    """The interpreter (with PyObjC) the menu bar app runs with."""
    return setting_path('menubar_python') or python_bin()


def codex_bin():
    """The codex CLI: settings.json codex_bin, else the one inside the Codex app, else codex on PATH. None if there
    is none. The app is found by its bundle id (Spotlight), then as ChatGPT.app or Codex.app in /Applications or
    ~/Applications; inside it, the CLI is at the first of CODEX_APP_CLI that is executable."""
    configured = setting_path('codex_bin')
    if configured:
        return str(configured)
    apps = []
    with contextlib.suppress(OSError, subprocess.SubprocessError):
        r = subprocess.run(['mdfind', f'kMDItemCFBundleIdentifier == "{CODEX_BUNDLE_ID}"'],
                           capture_output=True, text=True, timeout=10)
        found = [pathlib.Path(line) for line in r.stdout.splitlines() if line.endswith('.app')]
        apps += sorted(found, key=lambda p: not str(p).startswith('/Applications/'))
    apps += [folder / name for folder in APP_FOLDERS for name in ('ChatGPT.app', 'Codex.app')]
    for app in apps:
        for rel in CODEX_APP_CLI:
            cli = app / rel
            if cli.is_file() and os.access(cli, os.X_OK):
                return str(cli)
    return shutil.which('codex')


def missing_install():
    """What an install has and this home lacks: the pool binary and config.yaml ([] once installed)."""
    return [tilde(p) for p in (cpa_binary(), CONFIG) if not p.exists()]


def require_installed(what):
    """login/status/doctor before install: one clear line instead of a traceback or launchctl advice."""
    missing = missing_install()
    if missing:
        sys.exit(f'codexpool {what}: not installed yet ({", ".join(missing)} missing). '
                 'Run ./bin/codexpool install from your checkout first.')


def python_ok_here():
    """Python 3.11+ with tarfile's data filter (build extracts upstream source with it)."""
    return sys.version_info >= MIN_PYTHON and hasattr(tarfile, 'data_filter')


def ensure_python(cmd):
    """An older interpreter (a bare python3 reached through a symlink or ./bin/codexpool) hands over to the
    configured one. install and uninstall also run on Python 3.9, so a fresh Mac can bootstrap (and version,
    which only prints)."""
    if python_ok_here():
        return
    target = python_bin()
    if os.environ.get('CODEXPOOL_REEXEC') != '1' and os.access(target, os.X_OK):
        os.environ['CODEXPOOL_REEXEC'] = '1'
        os.execv(str(target), [str(target), str(pathlib.Path(__file__).resolve())] + sys.argv[1:])
    if cmd not in ('install', 'uninstall', 'version'):
        sys.exit(f'codexpool needs Python {MIN_PYTHON[0]}.{MIN_PYTHON[1]}+ (this is {platform.python_version()}); '
                 f'run codexpool install, or set "python" in {SETTINGS_FILE}')


@contextlib.contextmanager
def guard_lock(wait=True, timeout=240):
    """One lock for every read-modify-write of guard.json and for selftest (held for its duration)."""
    STATE.mkdir(parents=True, exist_ok=True)
    with open(LOCK_FILE, 'a') as f:
        deadline = time.monotonic() + timeout
        while True:
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if not wait:
                    yield False
                    return
                if time.monotonic() > deadline:
                    sys.exit('codexpool: another codexpool operation (guard pass or selftest) is running; try again')
                time.sleep(0.2)
        try:
            yield True
        finally:
            fcntl.flock(f, fcntl.LOCK_UN)


# ---------------------------------------------------------------- management API

_KEY = None
KEY_FIX = ('re-run codexpool install (it mints a new key into the Keychain and config.yaml). By hand: config.yaml '
           'keeps only a bcrypt hash, so mint a new key: K=$(openssl rand -hex 24); '
           f'security add-generic-password -U -a "$USER" -s {KEYCHAIN_SERVICE} -w "$K"; '
           f'put it in remote-management.secret-key in {CONFIG}; codexpool restart')
KEYCHAIN_LOCKED_FIX = 'the key itself is fine: unlock the login keychain (security unlock-keychain) and retry'


def mgmt_key():
    global _KEY
    if _KEY is None:
        try:
            r = subprocess.run(['security', 'find-generic-password', '-s', KEYCHAIN_SERVICE, '-w'],
                               capture_output=True, text=True, timeout=15)
        except subprocess.TimeoutExpired:
            raise KeyUnavailable('the Keychain did not answer within 15s (locked, or waiting on a prompt)',
                                 KEYCHAIN_LOCKED_FIX) from None
        if r.returncode == 44:  # errSecItemNotFound
            raise KeyUnavailable(f'management key "{KEYCHAIN_SERVICE}" is not in the Keychain', KEY_FIX)
        if r.returncode != 0:
            raise KeyUnavailable(f'the Keychain would not release "{KEYCHAIN_SERVICE}" (security exit '
                                 f'{r.returncode}); it is probably locked', KEYCHAIN_LOCKED_FIX)
        _KEY = r.stdout.strip()
    return _KEY


def api(method, path, body=None, timeout=20, want_headers=False):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(BASE + path, data=data, method=method, headers={
        'Authorization': 'Bearer ' + mgmt_key(), 'Content-Type': 'application/json'})
    try:
        with _LOCAL.open(req, timeout=timeout) as r:
            raw = r.read()
            parsed = json.loads(raw) if raw else {}
            return (parsed, dict(r.headers)) if want_headers else parsed
    except urllib.error.HTTPError as e:
        body = e.read().decode(errors='replace')
        e.close()
        raise ApiError(e.code, body) from None
    except TimeoutError as e:
        raise PoolTimeout(str(e) or 'timed out') from None
    except (urllib.error.URLError, OSError) as e:
        if isinstance(getattr(e, 'reason', None), TimeoutError):
            raise PoolTimeout(str(e)) from None
        raise PoolDown(str(e)) from None


def set_disabled(name, disabled):
    api('PATCH', '/v0/management/auth-files/status', {'name': name, 'disabled': disabled})


def set_fields(name, **fields):
    api('PATCH', '/v0/management/auth-files/fields', {'name': name, **fields})


def running_version():
    """Version string reported by the live pool (X-CPA-VERSION), or None."""
    with contextlib.suppress(PoolDown, ApiError, KeyUnavailable):
        _, headers = api('GET', '/v0/management/auth-files', timeout=5, want_headers=True)
        return {k.lower(): v for k, v in headers.items()}.get('x-cpa-version')
    return None


# ---------------------------------------------------------------- seats

def jwt_claims(token):
    try:
        payload = token.split('.')[1]
        payload += '=' * (-len(payload) % 4)
        return json.loads(base64.urlsafe_b64decode(payload))
    except (AttributeError, IndexError, ValueError):
        return {}


def file_claims(path):
    """Non-secret identity facts from a seat file (email, plan, account). Tokens never leave here."""
    data = read_json(path, {})
    claims = jwt_claims(data.get('id_token', ''))
    auth = claims.get('https://api.openai.com/auth', {})
    return {
        'email': claims.get('email') or data.get('email'),
        'plan': auth.get('chatgpt_plan_type'),
        'account_id': auth.get('chatgpt_account_id') or data.get('account_id'),
        'priority': data.get('priority'),
    }


PLAN_WEIGHTS = {'pro': 20, 'prolite': 5, 'self_serve_business_prolite': 5, 'plus': 1}


def default_weight(plan):
    """Relative quota size (Plus = 1). Override per seat with: codexpool weight <seat> <n>."""
    return PLAN_WEIGHTS.get((plan or '').lower(), 1)


def valid_weight(w):
    return isinstance(w, (int, float)) and not isinstance(w, bool) and math.isfinite(w) and w > 0


def seat_weight(value, plan):
    """The weight from seats.json when it is a positive number, else the plan's default (a zero, negative, NaN
    or infinite weight would make the headline meaningless)."""
    try:
        w = float(value) if value is not None else None
    except (TypeError, ValueError):
        w = None
    return w if valid_weight(w) else float(default_weight(plan))


def read_meta():
    return read_json(SEATS_META, {})


def update_meta(name, **fields):
    meta = read_meta()
    entry = meta.setdefault(name, {})
    for k, v in fields.items():
        if v is None:
            entry.pop(k, None)
        else:
            entry[k] = v
    if not entry:
        meta.pop(name, None)
    write_json(SEATS_META, meta)


def default_label(email, plan):
    local, _, domain = (email or 'unknown').partition('@')
    return f'{domain.split(".")[0] or local}-{local}' + (f'-{plan}' if plan else '')


def _int(value):
    try:
        return int(str(value).strip())
    except (TypeError, ValueError):
        return 0


def load_seats():
    files = api('GET', '/v0/management/auth-files').get('files', [])
    meta = read_meta()
    seats = []
    for f in files:
        claims = file_claims(f['path']) if f.get('path') else {}
        name = f.get('name') or f.get('id')
        seats.append({
            'name': name,
            'id': f.get('id') or name,
            'provider': (f.get('provider') or f.get('type') or '').lower(),
            'auth_index': f.get('auth_index'),
            'label': meta.get(name, {}).get('label') or default_label(claims.get('email') or f.get('email'), claims.get('plan')),
            'weight': seat_weight(meta.get(name, {}).get('weight'), claims.get('plan')),
            'reserve': bool(meta.get(name, {}).get('reserve')),
            'email': claims.get('email') or f.get('email'),
            'plan': claims.get('plan'),
            'account_id': claims.get('account_id'),
            'priority': _int(f.get('priority', claims.get('priority'))),
            'disabled': bool(f.get('disabled')),
            'unavailable': bool(f.get('unavailable')),
            'status': f.get('status'),
            'status_message': f.get('status_message') or '',
            'next_retry_after': f.get('next_retry_after'),
            'cooldowns': f.get('cooldowns'),  # None when CLIProxyAPI cannot say
            'quota': f.get('quota') or {},
            'success': _int(f.get('success')),
            'failed': _int(f.get('failed')),
        })
    # Labels must be unique: menu actions and commands address seats by label.
    groups = {}
    for s in seats:
        groups.setdefault(s['label'].lower(), []).append(s)
    for group in groups.values():
        if len(group) > 1:
            ids = [s['account_id'] for s in group]
            for s in group:
                key = s['account_id'] if s['account_id'] and ids.count(s['account_id']) == 1 else s['name']
                s['label'] = f'{s["label"]}-{hashlib.sha256(key.encode()).hexdigest()[:4]}'
    # Same order CLIProxyAPI's fill-first uses: priority descending, then auth ID ascending.
    seats.sort(key=lambda s: (s['provider'] != 'codex', -s['priority'], s['id']))
    return seats


def match_seat(seats, query):
    q = query.lower()
    for key in ('label', 'name', 'email'):
        exact = [s for s in seats if (s[key] or '').lower() == q]
        if len(exact) == 1:
            return exact[0]
    hits = [s for s in seats if q in s['label'].lower() or q in s['name'].lower() or q in (s['email'] or '').lower()]
    if len(hits) == 1:
        return hits[0]
    names = ', '.join(s['label'] for s in (hits or seats))
    sys.exit(f'codexpool: "{query}" matches {"several" if hits else "no"} seats ({names})')


# ---------------------------------------------------------------- usage

def _window_from_signals(sig, prefix, observed):
    used = sig.get(f'x-codex-{prefix}-used-percent')
    if used is None:
        return None
    try:
        w = {'used': float(used)}
    except ValueError:
        return None
    with contextlib.suppress(ValueError, TypeError):
        if sig.get(f'x-codex-{prefix}-window-minutes'):
            w['window_min'] = int(float(sig[f'x-codex-{prefix}-window-minutes']))
    with contextlib.suppress(ValueError, TypeError, OverflowError, OSError):
        if sig.get(f'x-codex-{prefix}-reset-at'):
            w['reset_at'] = iso(int(float(sig[f'x-codex-{prefix}-reset-at'])))
        elif sig.get(f'x-codex-{prefix}-reset-after-seconds') and observed:
            w['reset_at'] = (observed + dt.timedelta(seconds=float(sig[f'x-codex-{prefix}-reset-after-seconds']))).isoformat()
    return w


def usage_from_signals(quota):
    sig = {k.lower(): v for k, v in (quota.get('signals') or {}).items()}
    if not sig:
        return None
    observed = parse_time(quota.get('observed_at'))
    credits = {}
    if 'x-codex-credits-has-credits' in sig:
        credits['has_credits'] = sig['x-codex-credits-has-credits'].lower() == 'true'
    if 'x-codex-credits-unlimited' in sig:
        credits['unlimited'] = sig['x-codex-credits-unlimited'].lower() == 'true'
    with contextlib.suppress(ValueError):
        if sig.get('x-codex-credits-balance'):
            credits['balance'] = float(sig['x-codex-credits-balance'])
    # Only a 429 refusal carries this header. limit_reached/allowed also describe a plan window that is
    # used up while credits keep paying, which is exactly what the credit guard must catch.
    refused = 'x-codex-rate-limit-reached-type' in sig
    allowed = {'true': True, 'false': False}.get(sig.get('x-codex-allowed', '').lower())
    return {'primary': _window_from_signals(sig, 'primary', observed),
            'secondary': _window_from_signals(sig, 'secondary', observed),
            'credits': credits, 'plan': sig.get('x-codex-plan-type'), 'refused': refused, 'allowed': allowed,
            'at': observed.isoformat() if observed else None, 'source': 'live'}


def _window_from_wham(w):
    if not isinstance(w, dict) or w.get('used_percent') is None:
        return None
    out = {'used': float(w['used_percent'])}
    if w.get('limit_window_seconds'):
        out['window_min'] = int(w['limit_window_seconds']) // 60
    if w.get('reset_at'):
        out['reset_at'] = iso(int(w['reset_at']))
    elif w.get('reset_after_seconds') is not None:
        out['reset_at'] = (now_utc() + dt.timedelta(seconds=float(w['reset_after_seconds']))).isoformat()
    return out


def usage_from_wham(body):
    rl = body.get('rate_limit') or {}
    credits_in = body.get('credits') or {}
    credits = {}
    if 'has_credits' in credits_in:
        credits['has_credits'] = bool(credits_in['has_credits'])
    if 'unlimited' in credits_in:
        credits['unlimited'] = bool(credits_in['unlimited'])
    with contextlib.suppress(TypeError, ValueError):
        if credits_in.get('balance') not in (None, ''):
            credits['balance'] = float(credits_in['balance'])
    return {'primary': _window_from_wham(rl.get('primary_window')),
            'secondary': _window_from_wham(rl.get('secondary_window')),
            'credits': credits, 'plan': body.get('plan_type'),
            # A 200 from wham/usage never proves a refusal; only an exhausted spend cap means credits stop.
            'refused': (body.get('spend_control') or {}).get('reached') is True,
            'allowed': rl.get('allowed') if isinstance(rl.get('allowed'), bool) else None,
            'at': now_utc().isoformat(), 'source': 'poll'}


def poll_usage(seat):
    """Ask chatgpt.com for a seat's usage via the pool (the pool substitutes the seat token)."""
    header = {'Authorization': 'Bearer $TOKEN$', 'Accept': 'application/json',
              'User-Agent': 'codex_cli_rs/0.155.0 (Mac OS 26.0.0; arm64) codexpool'}
    if seat.get('account_id'):
        header['ChatGPT-Account-Id'] = seat['account_id']
    try:
        r = api('POST', '/v0/management/api-call',
                {'auth_index': seat['auth_index'], 'method': 'GET', 'url': WHAM_URL, 'header': header}, timeout=65)
    except ApiError as e:
        if e.code == 502:  # the pool's own reply: chatgpt.com did not answer within its 60s
            raise PoolTimeout(f'chatgpt.com did not answer: {short(str(e.body), 80)}') from None
        raise
    code = r.get('status_code') or r.get('statusCode')
    body = r.get('body')
    if code != 200:
        raise ApiError(code, body if isinstance(body, str) else json.dumps(body))
    try:
        data = json.loads(body) if isinstance(body, str) else body
    except ValueError:
        raise ApiError(code, 'non-JSON usage body: ' + str(body)[:120]) from None
    if not isinstance(data, dict):
        raise ApiError(code, 'unexpected usage body: ' + str(body)[:120])
    try:
        return usage_from_wham(data)
    except (AttributeError, TypeError, ValueError) as e:
        raise ApiError(code, f'unexpected usage shape: {e}') from None


def _seat_call(seat, method, url, body=None, timeout=65):
    """Call chatgpt.com as a seat through the pool's api-call (the pool substitutes the seat token)."""
    header = {'Authorization': 'Bearer $TOKEN$', 'Accept': 'application/json',
              'User-Agent': 'codex_cli_rs/0.155.0 (Mac OS 26.0.0; arm64) codexpool'}
    if seat.get('account_id'):
        header['ChatGPT-Account-Id'] = seat['account_id']
    req = {'auth_index': seat['auth_index'], 'method': method, 'url': url, 'header': header}
    if body is not None:
        header['Content-Type'] = 'application/json'
        req['data'] = json.dumps(body)
    try:
        r = api('POST', '/v0/management/api-call', req, timeout=timeout)
    except ApiError as e:
        if e.code == 502:  # the pool's own reply: chatgpt.com did not answer within its 60s
            raise PoolTimeout(f'chatgpt.com did not answer: {short(str(e.body), 80)}') from None
        raise
    code = r.get('status_code') or r.get('statusCode')
    raw = r.get('body')
    try:
        data = json.loads(raw) if isinstance(raw, str) and raw else (raw or {})
    except ValueError:
        data = {'_raw': str(raw)[:200]}
    return code, data


def poll_resets(seat):
    """Banked free resets for a seat: {'available', 'credits': [{id, title, expires_at}]} (non-secret)."""
    code, data = _seat_call(seat, 'GET', RESETS_URL)
    if code != 200 or not isinstance(data, dict):
        raise ApiError(code, json.dumps(data)[:200])
    credits = [{'id': c.get('id'), 'title': c.get('title') or 'Usage reset', 'expires_at': c.get('expires_at')}
               for c in (data.get('credits') or []) if isinstance(c, dict)
               and c.get('status') == 'available' and c.get('is_supported_by_plan', True) and c.get('id')]
    credits.sort(key=lambda c: c.get('expires_at') or '9999')
    return {'available': len(credits), 'credits': credits, 'polled_at': now_utc().isoformat()}


def _open(w, now):
    """A window still in force. Past its reset_at, a snapshot's used% is stale."""
    if not w:
        return False
    reset = parse_time(w.get('reset_at'))
    return not (reset and reset <= now)


def split_windows(usage):
    """(weekly window, shorter window) of a usage record; Pro and Business seats are weekly-only."""
    if not usage:
        return None, None
    wins = [w for w in (usage.get('primary'), usage.get('secondary')) if w]
    week = next((w for w in wins if (w.get('window_min') or 0) >= 7 * 24 * 60 - 60), None)
    short_w = next((w for w in wins if w is not week), None)
    if week is None and short_w is not None and not (short_w.get('window_min') or 0):
        week, short_w = short_w, None  # unknown length: treat the only window as the long one
    return week, short_w


def best_usage(seat, cache, now=None):
    """Merge live signals and the last poll field by field, newest source first.

    CLIProxyAPI replaces the live snapshot on every response carrying any quota header (Retry-After
    alone, plan only, windows without credits), so a newer partial snapshot must not hide what the
    other source knows."""
    now = now or now_utc()
    sources = [u for u in (usage_from_signals(seat['quota']), cache.get(seat['name'])) if u]
    if not sources:
        return None
    sources.sort(key=lambda u: parse_time(u.get('at')) or dt.datetime(2000, 1, 1, tzinfo=dt.timezone.utc),
                 reverse=True)
    merged = {'primary': None, 'secondary': None, 'credits': {}, 'plan': None, 'refused': False,
              'at': sources[0].get('at'), 'source': sources[0].get('source')}
    for key in ('primary', 'secondary'):
        merged[key] = next((u[key] for u in sources if _open(u.get(key), now)), None)
    merged['credits'] = next((u['credits'] for u in sources if u.get('credits')), {})
    merged['plan'] = next((u['plan'] for u in sources if u.get('plan')), None)
    merged['refused'] = bool(sources[0].get('refused'))
    merged['allowed'] = next((u['allowed'] for u in sources if u.get('allowed') is not None), None)
    if not merged['primary'] and not merged['secondary']:
        return None if not merged['credits'] else merged
    return merged


def at_limit(usage, now=None):
    now = now or now_utc()
    return any(_open(w, now) and w.get('used', 0) >= 100 for w in (usage.get('primary'), usage.get('secondary')))


def will_spend_credits(usage):
    """True when a request past 100% would be paid with credits: unlimited, a positive balance,
    or has_credits with the balance hidden (workspace members; CLIProxyAPI drops empty balances)."""
    c = usage.get('credits') or {}
    if c.get('unlimited'):
        return True
    if c.get('balance') is not None:
        return c['balance'] > 0
    return c.get('has_credits') is True


def limit_reset(usage, now=None):
    """Latest future reset among windows still at 100%, or None."""
    now = now or now_utc()
    resets = [parse_time(w.get('reset_at')) for w in (usage.get('primary'), usage.get('secondary'))
              if _open(w, now) and w.get('used', 0) >= 100]
    resets = [r for r in resets if r and r > now]
    return max(resets).isoformat() if resets else None


# ---------------------------------------------------------------- state

def seat_state(seat, guard, now):
    """(state, detail, until) for one seat. States: ready, exhausted, cooldown, blocked, parked, disabled."""
    g = guard.get('seats', {}).get(seat['name'], {})
    if seat['disabled']:
        if g.get('parked_until'):
            return 'parked', 'credit guard: would spend credits', g['parked_until']
        return 'disabled', 'disabled by you', None
    cooldowns = seat.get('cooldowns')
    if cooldowns:
        # Model-scoped timers leave the seat serving every other model; only seat-wide ones count.
        entries = [(parse_time(c.get('retry_at')), c) for c in cooldowns if isinstance(c, dict)
                   and (c.get('scope') != 'model' or c.get('reason') in BLOCKED_REASONS or seat['unavailable'])]
        for t, c in entries:
            if c.get('reason') in BLOCKED_REASONS:
                return 'blocked', c['reason'].replace('_', ' '), t.isoformat() if t and t > now else None
        exhausted = [t for t, c in entries if c.get('reason') in EXHAUSTED_REASONS and t and t > now]
        if exhausted:
            return 'exhausted', 'usage limit reached', max(exhausted).isoformat()
        future = [(t, c) for t, c in entries if t and t > now]
        if future:
            t, c = max(future, key=lambda x: x[0])
            return 'cooldown', (c.get('reason') or 'cooling down').replace('_', ' '), t.isoformat()
    # Fallback when CLIProxyAPI gives no structured cooldown view.
    msg = seat['status_message']
    retry = parse_time(seat.get('next_retry_after'))
    if seat['unavailable'] or seat['status'] == 'error':
        if USAGE_LIMIT.search(msg) and retry and retry > now:
            return 'exhausted', 'usage limit reached', retry.isoformat()
        if AUTH_ERROR.search(msg):
            return 'blocked', short(msg) or 'authentication failed', retry.isoformat() if retry and retry > now else None
        if retry and retry > now:
            return 'cooldown', short(msg) or 'temporarily unavailable', retry.isoformat()
        if seat['unavailable']:
            return 'blocked', short(msg) or 'unavailable', None
    return 'ready', '', None


def _reset_summary(r):
    if not r:
        return None
    credits = r.get('credits') or []
    return {'available': int(r.get('available') or 0), 'next_expiry': credits[0].get('expires_at') if credits else None,
            'title': credits[0].get('title') if credits else None, 'polled_at': r.get('polled_at')}


def headline_rows(codex):
    """The seats the headline can count: every Codex seat that is not off and has a weekly figure."""
    return [r for r in codex if r['state'] != 'disabled' and r['week_used'] is not None]


def _weighted(rows):
    tw = sum(r['weight'] for r in rows)
    return round(sum(r['weight'] * r['week_used'] for r in rows) / tw, 1) if tw else None


def set_headline(pool, codex):
    """The headline fields of status.json, from the Codex seat rows and settings.json. used_pct_all covers every
    counted seat (reserve included), used_pct_regular leaves reserve seats out, and used_pct is the one that
    `headline` selects. `display` tells readers (the menu bar) whether to show it as used or as left."""
    counted = headline_rows(codex)
    every, regular = _weighted(counted), _weighted([r for r in counted if not r['reserve']])
    pool['used_pct'] = every if SETTINGS['headline'] == 'all' else regular
    pool['used_pct_all'] = every
    pool['used_pct_regular'] = regular
    pool['headline'] = SETTINGS['headline']
    pool['display'] = SETTINGS['display']


def build_status(seats, guard, extra_pool=None):
    now = now_utc()
    cache = guard.get('usage', {})
    rows = []
    for s in seats:
        state, detail, until = seat_state(s, guard, now)
        usage = best_usage(s, cache, now) if s['provider'] == 'codex' else None
        if state == 'ready' and usage and (not will_spend_credits(usage) or usage.get('refused')) and \
                (at_limit(usage, now) or usage.get('allowed') is False):
            # The seat's own usage says it is out; the pool learns on its next request (instant 429, then cooldown).
            state, detail, until = 'exhausted', 'usage limit reached', limit_reset(usage, now)
        week, short_w = split_windows(usage)
        week_used = week['used'] if week else (100.0 if state in ('exhausted', 'blocked') else None)
        rows.append({
            'label': s['label'], 'name': s['name'], 'provider': s['provider'], 'email': s['email'],
            'plan': (usage or {}).get('plan') or s['plan'], 'priority': s['priority'], 'state': state,
            'detail': detail, 'until': until, 'usage': usage, 'weight': s.get('weight', 1.0),
            'reserve': s.get('reserve', False),
            'week': week, 'short': short_w, 'week_used': min(week_used, 100.0) if week_used is not None else None,
            'poll_error': cache.get(s['name'], {}).get('poll_error'),
            'resets': _reset_summary(guard.get('resets', {}).get(s['name'])),
        })
    codex = [r for r in rows if r['provider'] == 'codex']
    active_row = next((r for r in codex if r['state'] == 'ready'), None)
    if active_row:
        active_row['state'] = 'active'
    upcoming = sorted((parse_time(r['until']), r['label']) for r in codex
                      if r['state'] in ('exhausted', 'parked', 'cooldown') and parse_time(r['until']))
    pool = {'running': True, 'version': cpa_version(), 'port': PORT}
    pool.update(extra_pool or {})
    counted = headline_rows(codex)
    set_headline(pool, codex)
    serving = next((r for r in codex if r['state'] == 'active'), None)
    pool['reserve_in_use'] = bool(serving and serving['reserve'])
    pool['regular_available'] = len([r for r in codex if r['state'] in ('active', 'ready') and not r['reserve']])
    pool['left_weight'] = round(sum(r['weight'] * (100 - r['week_used']) / 100 for r in counted
                                    if r['state'] in ('active', 'ready')), 2)
    pool['counted'] = len(counted)
    pool['seats'] = len([r for r in codex if r['state'] != 'disabled'])
    pool['available'] = len([r for r in codex if r['state'] in ('active', 'ready')])
    pool['resets_available'] = sum((r.get('resets') or {}).get('available', 0) for r in codex)
    return {
        'generated_at': now.isoformat(),
        'pool': pool,
        'active': active_row['label'] if active_row else None,
        'active_name': active_row['name'] if active_row else None,
        'next_back': {'label': upcoming[0][1], 'at': upcoming[0][0].isoformat()} if upcoming else None,
        'seats': rows,
    }


def status_down(reason, running):
    # headline and display too, so the menu bar keeps drawing its chart the way settings.json says while down.
    return {'generated_at': now_utc().isoformat(),
            'pool': {'running': running, 'version': cpa_version(), 'port': PORT, 'error': reason,
                     'headline': SETTINGS['headline'], 'display': SETTINGS['display']},
            'active': None, 'active_name': None, 'next_back': None, 'seats': []}


def status_now(poll=False):
    guard = read_guard()
    try:
        seats = load_seats()
    except PoolDown as e:
        return status_down(str(e), False)
    except KeyUnavailable as e:  # raised before any connection, so look at the port for running
        return status_down(str(e), port_open(PORT))
    except ApiError as e:
        return status_down(str(e), True)
    if poll:
        fresh, fresh_resets = {}, {}
        for s in seats:
            if s['provider'] == 'codex' and not s['disabled']:
                with contextlib.suppress(ApiError, PoolDown):
                    fresh[s['name']] = {**poll_usage(s), 'polled_at': now_utc().isoformat()}
            if s['provider'] == 'codex':
                with contextlib.suppress(ApiError, PoolDown):
                    fresh_resets[s['name']] = poll_resets(s)
        with guard_lock(wait=False) as got:  # share fresh numbers with the guard and the menu bar
            if got:
                g = read_guard()
                g.setdefault('usage', {}).update(fresh)
                g.setdefault('resets', {}).update(fresh_resets)
                write_json(GUARD_FILE, g)
                guard = g
            else:
                guard.setdefault('usage', {}).update(fresh)
                guard.setdefault('resets', {}).update(fresh_resets)
        st = build_status(seats, guard)
        with contextlib.suppress(OSError):
            write_json(STATUS_FILE, st)
        return st
    return build_status(seats, guard)


def show_left():
    return SETTINGS['display'] == 'left'


def pct_text(used, left=False):
    """A used percentage as it is shown: '44%', or with left=True what remains of it, '56%'."""
    return f'{min(100.0, max(0.0, 100 - used)) if left else used:.0f}%'


def pct(w, left=False):
    return pct_text(w['used'], left) if w else '—'


def window_name(w):
    m = (w or {}).get('window_min') or 0
    return 'wk' if m >= 7 * 24 * 60 - 60 else (f'{m // 60}h' if m >= 60 else (f'{m}m' if m else ''))


def usage_cells(u, left=False):
    if not u:
        return '—', '', ''
    p, s = u.get('primary'), u.get('secondary')
    first = f'{pct(p, left)} {window_name(p)}'.strip() if p else '—'
    second = f'{pct(s, left)} {window_name(s)}'.strip() if s else ''
    credits = u.get('credits') or {}
    bal = credits.get('balance')
    cred = f'credits {bal:g}' if bal else ('credits ∞' if credits.get('unlimited') else '')
    return first, second, cred


STATE_ICON = {'active': '●', 'ready': '○', 'exhausted': '◌', 'parked': '⏸', 'cooldown': '◌',
              'blocked': '✕', 'disabled': '–'}


def print_status(st):
    pool = st.get('pool', {})
    if not pool.get('running'):
        print(f'Pool is NOT running on :{PORT}. Try: codexpool restart ; codexpool doctor')
        return
    if pool.get('error'):
        print(f'Pool is running but codexpool cannot read it: {pool["error"]}\nTry: codexpool doctor')
        return
    used, left = pool.get('used_pct'), show_left()
    scope = 'all seats' if pool.get('headline') == 'all' else 'regular seats'
    headline = f'{pct_text(used, left)} {"left" if left else "used"} this week ({scope})' if used is not None \
        else 'usage unknown'
    print(f'Codex pool  {headline}'
          f'{"  ·  ON RESERVE" if pool.get("reserve_in_use") else ""}  ·  '
          f'{pool.get("available", 0)} of {pool.get("seats", 0)} seats available  ·  '
          f'new threads → {st["active"] or "NONE"}')
    if st.get('next_back') and not st['active']:
        print(f'next seat back: {st["next_back"]["label"]} at {when(st["next_back"]["at"])}')
    print()
    print(f'  {"seat":<22} {"plan":<10} {"size":>5} {"prio":>4}  {"state":<10} {"left" if left else "usage":<9} '
          f'{"":<9} {"":<12} note')
    for r in st['seats']:
        first, second, cred = usage_cells(r['usage'], left)
        note = r['detail']
        if r['until']:
            note = f'{note}; back {when(r["until"])}' if note else f'back {when(r["until"])}'
        if r['provider'] != 'codex':
            first, second, cred = '', '', ''
            note = f'{r["provider"]} (not a Codex seat)' + (f'; {note}' if note else '')
        if r.get('poll_error') and not r['usage']:
            note = (note + '; ' if note else '') + 'usage unknown: ' + short(r['poll_error'], 50)
        rs = r.get('resets') or {}
        if rs.get('available'):
            note = (note + '; ' if note else '') + f'{rs["available"]} reset{"s" if rs["available"] != 1 else ""} banked'
        plan = 'business' if 'business' in (r['plan'] or '') else (r['plan'] or '')
        size = '' if r['provider'] != 'codex' else f'{r.get("weight") or 1:g}×' + ('R' if r.get('reserve') else '')
        print(f'{STATE_ICON.get(r["state"], "?")} {r["label"]:<22} {plan:<10} {size:>5} {r["priority"]:>4}  '
              f'{r["state"]:<10} {first:<9} {second:<9} {cred:<12} {note}')
    footnote = headline_footnote(st, left)
    if footnote:
        print()
        print(footnote)


def headline_footnote(st, left=False, width=None):
    """How the headline is made: each counted seat's size and weekly figure, then the result, wrapped to the
    terminal with a hanging indent:
    'Left this week, weighted by size: Work A 5× 0% · ... · Pro 20x 20× 66% reserve → 54% left'.
    With the regular headline the reserve comes last: '(reserve not counted: Pro 20x 66% left)'."""
    pool = st.get('pool', {})
    used = pool.get('used_pct')
    counted = headline_rows([r for r in st.get('seats', []) if r.get('provider') == 'codex'])
    if used is None or not counted:
        return None
    every = pool.get('headline') == 'all'
    word = 'left' if left else 'used'
    cells = [f'{r["label"]} {r["weight"]:g}× {pct_text(r["week_used"], left)}' + (' reserve' if r['reserve'] else '')
             for r in counted if every or not r['reserve']]
    if not cells:
        return None
    cells[-1] += f' → {pct_text(used, left)} {word}'
    out = [f'{r["label"]} {pct_text(r["week_used"], left)} {word}' for r in counted if r['reserve'] and not every]
    if out:
        cells.append(f'(reserve not counted: {", ".join(out)})')
    width = width or shutil.get_terminal_size().columns
    lines, line = [], f'{word.capitalize()} this week, weighted by size:'
    for i, cell in enumerate(cells):
        sep = '' if i == 0 or cell.startswith('(') else ' ·'   # the separator ends the line it follows
        if len(line) + len(sep) + 1 + len(cell) > width:
            lines.append(line + sep)
            line = '    ' + cell
        else:
            line += f'{sep} {cell}'
    return '\n'.join(lines + [line])


def refresh_headline(st):
    """Re-derives the headline fields of a status.json that was read from disk, for the current settings.json
    (an older guard wrote only used_pct, for the regular seats)."""
    pool, seats = st.get('pool'), st.get('seats')
    if isinstance(pool, dict) and pool.get('running') and not pool.get('error') and isinstance(seats, list) and \
            all(isinstance(r, dict) for r in seats):
        with contextlib.suppress(KeyError, TypeError, ValueError):
            set_headline(pool, [r for r in seats if r.get('provider') == 'codex'])
    return st


# ---------------------------------------------------------------- guard (launchd, every 60s)

def recover_selftest(guard):
    """A selftest that died (even SIGKILL) left seats disabled; restore exactly what it toggled."""
    j = read_json(SELFTEST_JOURNAL, None)
    if not j or pid_alive(j.get('pid')):
        return
    ok = True
    for name, was_disabled in (j.get('toggled') or {}).items():
        try:
            set_disabled(name, was_disabled)
        except (ApiError, PoolDown):
            ok = False
    if ok:
        with contextlib.suppress(OSError):
            SELFTEST_JOURNAL.unlink()
        notify('codexpool restored seats', 'A selftest was interrupted; its temporary seat changes were undone.')


def guard_pass():
    guard = read_guard()
    guard.setdefault('seats', {})
    guard.setdefault('usage', {})

    def save():
        write_json(GUARD_FILE, guard)

    try:
        seats = load_seats()
    except PoolDown as e:
        guard['down_count'] = guard.get('down_count', 0) + 1
        if guard['down_count'] == DOWN_ALERT_AFTER:
            notify('Codex pool is not responding', 'launchd keeps restarting it. Run: codexpool doctor')
        save()
        write_json(STATUS_FILE, status_down(str(e), False))
        return
    except (ApiError, KeyUnavailable) as e:
        msg = short(str(e), 160)
        if not guard.get('mgmt_error_notified'):
            notify('codexpool is locked out of the pool', f'{msg[:90]}. The credit guard is off. Run: codexpool doctor')
            guard['mgmt_error_notified'] = True
        save()
        # A Keychain failure happens before any connection is made, so only the port says whether it runs.
        write_json(STATUS_FILE, status_down(msg, port_open(PORT) if isinstance(e, KeyUnavailable) else True))
        return
    if guard.get('down_count', 0) >= DOWN_ALERT_AFTER or guard.get('mgmt_error_notified'):
        notify('Codex pool is back', 'codexpool can see the pool again.')
    guard['down_count'] = 0
    guard.pop('mgmt_error_notified', None)
    recover_selftest(guard)

    now = now_utc()
    codex = [s for s in seats if s['provider'] == 'codex']
    by_name = {s['name']: s for s in codex}
    for name in list(guard['seats']):
        if name not in by_name:
            del guard['seats'][name]
    for name in list(guard['usage']):
        if name not in by_name:
            del guard['usage'][name]
    for name in list(guard.get('resets', {})):
        if name not in by_name:
            del guard['resets'][name]

    # 1. Poll usage for seats whose numbers are stale (live signals cover the busy seat for free).
    #    Seats that timed out last time go last so one slow seat cannot starve the others.
    order = sorted(codex, key=lambda s: guard['usage'].get(s['name'], {}).get('timed_out', False))
    for s in order:
        g = guard['seats'].get(s['name'], {})
        if s['disabled'] and not g.get('parked_until'):
            continue
        cached = guard['usage'].get(s['name'], {})
        last = parse_time(cached.get('polled_at'))
        if last and (now - last).total_seconds() < POLL_EVERY:
            continue
        try:
            usage = poll_usage(s)
            usage['polled_at'] = now.isoformat()
            guard['usage'][s['name']] = usage
        except PoolTimeout:
            guard['usage'][s['name']] = {**cached, 'polled_at': now.isoformat(), 'timed_out': True,
                                         'poll_error': 'usage poll timed out'}
            break
        except ApiError as e:
            guard['usage'][s['name']] = {**cached, 'polled_at': now.isoformat(), 'poll_error': short(str(e), 160)}
        except PoolDown:
            break
    save()

    # 1b. Banked resets, on their own cadence (cheap GET per seat).
    for s in codex:
        r = guard.setdefault('resets', {}).get(s['name'], {})
        last = parse_time(r.get('polled_at'))
        if last and (now - last).total_seconds() < POLL_EVERY:
            continue
        try:
            guard['resets'][s['name']] = poll_resets(s)
        except (ApiError, PoolTimeout):
            guard['resets'][s['name']] = {**r, 'polled_at': now.isoformat()}
        except PoolDown:
            break
    save()

    # 2. Unpark seats whose limit window has reset; drop park records that never took effect; expire overrides.
    for name, g in guard['seats'].items():
        if name not in by_name:
            continue
        until = parse_time(g.get('parked_until'))
        if until and not by_name[name]['disabled']:
            # The park PATCH failed, or something re-enabled the seat: forget it; step 3 re-evaluates now.
            g.pop('parked_until', None)
            g.pop('parked_reason', None)
            save()
        elif until and now >= until:
            try:
                set_disabled(name, False)
            except (ApiError, PoolDown):
                continue  # keep the record; retry next pass
            g.pop('parked_until', None)
            g.pop('parked_reason', None)
            guard['usage'].pop(name, None)  # force a fresh poll
            by_name[name]['disabled'] = False
            save()
            notify('Codex seat back in the pool', f'{by_name[name]["label"]} has reset.')
        override = parse_time(g.get('override_until'))
        if override and now >= override:
            g.pop('override_until', None)
            save()

    # 3. Credit guard: a seat at 100% that still answers is spending credits. Park it until it resets.
    for s in codex:
        g = guard['seats'].setdefault(s['name'], {})
        if s['disabled'] or g.get('override_until'):
            continue
        if seat_state(s, guard, now)[0] != 'ready':
            continue  # CLIProxyAPI is already refusing it (cooldown/exhausted/blocked): nothing is spent
        usage = best_usage(s, guard['usage'], now)
        if not usage or usage.get('refused') or not at_limit(usage, now) or not will_spend_credits(usage):
            continue
        until = limit_reset(usage, now)
        if not until:
            continue
        g['parked_until'] = until
        g['parked_reason'] = 'credits'
        save()  # write the record before changing the pool, so a crash cannot orphan a disabled seat
        try:
            set_disabled(s['name'], True)
        except (ApiError, PoolDown) as e:
            log_line(f'guard: could not park {s["label"]}: {short(str(e), 120)}')
            continue  # step 2 drops the record next pass if the seat is still enabled; step 3 retries
        s['disabled'] = True
        notify('Codex seat parked', f'{s["label"]} is at its limit and would spend credits. '
                                    f'Back {when(until)}. Override: codexpool enable {s["label"]}')

    # 4. Heal seats blocked by auth errors (e.g. the no-expiry 401 block): refresh, then ask for re-login.
    for s in codex:
        g = guard['seats'].setdefault(s['name'], {})
        state, detail, _ = seat_state(s, guard, now)
        if state != 'blocked':
            if g.get('heal_failures'):
                base = g.get('heal_success', 0)
                last = parse_time(g.get('last_heal'))
                if s['success'] < base:          # pool restarted: its in-memory counter reset
                    g['heal_success'] = s['success']
                elif s['success'] > base or (last and (now - last).total_seconds() > 8 * HEAL_EVERY):
                    for k in ('heal_failures', 'relogin_notified', 'heal_success'):
                        g.pop(k, None)
            continue
        last = parse_time(g.get('last_heal'))
        every = HEAL_EVERY * (4 if g.get('relogin_notified') else 1)
        if last and (now - last).total_seconds() < every:
            continue
        g['last_heal'] = now.isoformat()
        g['heal_failures'] = g.get('heal_failures', 0) + 1
        g['heal_success'] = s['success']        # a real request must succeed after this to clear it
        save()
        with contextlib.suppress(ApiError, PoolDown):
            api('POST', '/v0/management/auth-files/refresh', {'name': s['name']}, timeout=60)
        log_line(f'heal: refreshed {s["label"]} (attempt {g["heal_failures"]}): {detail}')
        if g['heal_failures'] >= 3 and not g.get('relogin_notified'):
            g['relogin_notified'] = True
            save()
            notify('Codex seat needs a re-login', f'{s["label"]}: {short(detail, 70)}. Run: codexpool login '
                   f'{shlex.quote(s["label"])} --priority {s["priority"]}')

    # 5. Tell the user when the pool moves on, or runs dry. Short transient cooldowns are blips.
    with contextlib.suppress(PoolDown, ApiError, KeyUnavailable):
        seats = load_seats()
    st = build_status(seats, guard)
    t = now_utc()

    def holds_slot(r):
        if guard['seats'].get(r['name'], {}).get('heal_failures'):
            return False  # on heal probation: it flips between ready and blocked; don't announce it
        if r['state'] in ('active', 'ready'):
            return True
        u = parse_time(r['until'])
        return r['state'] == 'cooldown' and u is not None and (u - t).total_seconds() <= BLIP_SECONDS

    rows = [r for r in st['seats'] if r['provider'] == 'codex']
    cur_row = next((r for r in rows if holds_slot(r)), None)
    # A seat on heal probation that CLIProxyAPI still serves means the pool is not dry: stay quiet.
    probation_ready = any(r['state'] in ('active', 'ready') and guard['seats'].get(r['name'], {}).get('heal_failures')
                          for r in rows)
    prev_name, cur_name = guard.get('announced'), cur_row['name'] if cur_row else None
    labels = {r['name']: r for r in rows}
    if prev_name and cur_name and prev_name != cur_name:
        old = labels.get(prev_name)
        why = (f'{old["label"]}: {old["detail"] or old["state"]}' + (f', back {when(old["until"])}' if old['until'] else '')
               if old else 'previous seat removed')
        notify(f'Codex now on {cur_row["label"]}', why)
    if prev_name and not cur_name and rows and not probation_ready:
        nb = st.get('next_back')
        notify('All Codex seats are exhausted', f'Next back: {nb["label"]} at {when(nb["at"])}' if nb else 'No reset time known.')
    if cur_name and not prev_name and guard.get('announced_known'):
        notify('Codex pool has capacity again', f'Now on {cur_row["label"]}.')
    if cur_row and cur_row.get('reserve') and prev_name and not labels.get(prev_name, {}).get('reserve'):
        notify('Codex is now on the reserve seat', f'{cur_row["label"]} is serving: the regular seats are spent.')
    guard['announced'] = cur_name if cur_name or not probation_ready else prev_name
    guard['announced_known'] = bool(rows)
    guard['last_pass'] = now.isoformat()
    save()
    write_json(STATUS_FILE, st)
    record_history(st, guard, now)


def record_history(st, guard, now):
    """Append one headline sample every HISTORY_EVERY; keep HISTORY_KEEP_DAYS (bounded file)."""
    last = parse_time(guard.get('history_at'))
    if last and (now - last).total_seconds() < HISTORY_EVERY:
        return
    # 'used' is the regular seats and 'all' every seat, whatever `headline` selects, so old samples keep their meaning.
    sample = {'t': now.isoformat(), 'used': st['pool'].get('used_pct_regular'), 'all': st['pool'].get('used_pct_all'),
              'reserve': st['pool'].get('reserve_in_use'),
              'seats': {r['label']: r['week_used'] for r in st['seats'] if r['provider'] == 'codex'}}
    with contextlib.suppress(OSError):
        with HISTORY_FILE.open('a') as f:
            f.write(json.dumps(sample) + '\n')
        cutoff = (now - dt.timedelta(days=HISTORY_KEEP_DAYS)).isoformat()
        lines = HISTORY_FILE.read_text().splitlines()
        if len(lines) > HISTORY_KEEP_DAYS * 24 * 6 + 50:
            keep = [l for l in lines if l[7:39] >= cutoff[:32]]
            write_text_atomic(HISTORY_FILE, '\n'.join(keep) + '\n')
    guard['history_at'] = now.isoformat()
    write_json(GUARD_FILE, guard)


def write_text_atomic(path, text):
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=path.name + '.', suffix='.tmp')
    with os.fdopen(fd, 'w') as f:
        f.write(text)
    os.replace(tmp, path)


def cmd_guard(args):
    with guard_lock(wait=False) as got:
        if not got:
            return  # a selftest or another pass holds the lock
        try:
            guard_pass()
        except Exception as e:  # keep a record; launchd simply runs the next pass in 60s
            log_line(f'guard error: {type(e).__name__}: {e}')
            raise


# ---------------------------------------------------------------- read-only commands

def cmd_status(args):
    require_installed('status')
    if args.live or not STATUS_FILE.exists():
        st = status_now(poll=args.live)
    else:
        st = read_json(STATUS_FILE, {})
        age = (now_utc() - (parse_time(st.get('generated_at')) or dt.datetime(2000, 1, 1, tzinfo=dt.timezone.utc))).total_seconds()
        st = status_now() if age > 180 else refresh_headline(st)
    if args.json:
        print(json.dumps(st, indent=2))
    else:
        print_status(st)
        pool = st.get('pool') or {}
        if pool.get('running') and not pool.get('error') and LANES_FILE.exists():
            lines = []
            with contextlib.suppress(Exception):  # quick checks; they never fail the command
                lines = lane_status_lines(st)
            if lines:
                print()
                print('\n'.join(lines))


def cmd_menubar(args):
    """SwiftBar/xbar output. Reads the guard's status.json; falls back to a live read if it is stale."""
    st = read_json(STATUS_FILE, {})
    age = (now_utc() - (parse_time(st.get('generated_at')) or dt.datetime(2000, 1, 1, tzinfo=dt.timezone.utc))).total_seconds()
    if age > 180:
        st = status_now()
    me = str(HOME / '.local/bin/codexpool')
    pool = st.get('pool', {})
    if not pool.get('running') or pool.get('error'):
        print('Codex ✕ | sfimage=exclamationmark.triangle.fill sfcolor=#d9534f')
        print('---')
        print(('Pool is not running' if not pool.get('running') else 'codexpool cannot read the pool') + ' | color=#d9534f')
        if pool.get('error'):
            print(f'{short(pool["error"], 70)} | size=11')
        print(f'Restart pool | bash={me} param1=restart terminal=false refresh=true')
        print(f'Doctor | bash={me} param1=doctor terminal=true')
        return
    codex = [r for r in st.get('seats', []) if r['provider'] == 'codex']
    active = next((r for r in codex if r['state'] == 'active'), None)
    left = show_left()
    if active:
        u = active['usage'] or {}
        worst = max([w['used'] for w in (u.get('primary'), u.get('secondary')) if w] or [0])
        color = '#5cb85c' if worst < 70 else ('#f0ad4e' if worst < 90 else '#d9534f')
        print(f'{active["label"]} {pct_text(worst, left)}{" left" if left else ""} '
              f'| sfimage=circle.hexagongrid.fill sfcolor={color}')
    elif codex:
        nb = st.get('next_back')
        print(f'Codex: none until {when(nb["at"]) if nb else "?"} | sfimage=pause.circle.fill sfcolor=#d9534f')
    else:
        print('Codex: no seats | sfimage=circle.dashed')
    print('---')
    ready = sum(1 for r in codex if r['state'] in ('active', 'ready'))
    print(f'{ready} of {len(codex)} seats available | size=12')
    for r in codex:
        first, second, cred = usage_cells(r['usage'], left)
        wins = ' · '.join(x for x in (first, second) if x and x != '—')
        usage = ' · '.join(x for x in (f'{wins} left' if wins and left else wins, cred) if x)
        tail = f' — back {when(r["until"])}' if r['until'] else (f' — {r["detail"]}' if r['state'] == 'blocked' else '')
        color = {'active': '#5cb85c', 'exhausted': '#999999', 'parked': '#f0ad4e', 'cooldown': '#999999',
                 'blocked': '#d9534f', 'disabled': '#999999'}.get(r['state'])
        print(f'{STATE_ICON.get(r["state"], "?")} {r["label"]}  {usage}{tail}' + (f' | color={color}' if color else ''))
        if r['state'] == 'blocked':
            print(f'--Re-login {r["label"]} | bash={me} param1=login param2={r["label"]} terminal=true')
        if r['state'] in ('ready', 'active'):
            print(f'--Disable {r["label"]} | bash={me} param1=disable param2={r["name"]} terminal=false refresh=true')
        if r['state'] in ('disabled', 'parked'):
            print(f'--Enable {r["label"]} | bash={me} param1=enable param2={r["name"]} terminal=false refresh=true')
    print('---')
    print(f'Status (live) | bash={me} param1=status param2=--live terminal=true')
    print(f'Doctor | bash={me} param1=doctor terminal=true')
    print(f'Pool log | bash={me} param1=logs param2=-f terminal=true')
    print(f'Restart pool | bash={me} param1=restart terminal=false refresh=true')
    print(f'CLIProxyAPI v{pool.get("version")} · updated {when(st.get("generated_at"))} | size=11')


# ---------------------------------------------------------------- seat commands

def refresh_status_file():
    """Rewrite status.json now, the way a guard pass ends (build_status over the pool's seats and guard.json), so
    codexpool status and the menu bar show a change at once instead of at the next pass. The caller holds the guard
    lock. Best effort: the next guard pass writes it anyway. True when it wrote the file."""
    with contextlib.suppress(PoolDown, ApiError, KeyUnavailable, OSError):
        write_json(STATUS_FILE, build_status(load_seats(), read_guard()))
        return True
    return False


def restamp_status_file():
    """For when the pool cannot be read: status.json as it is, with its headline and display fields redone for the
    current settings (the menu bar draws those). generated_at stays, so a stale file still reads as stale. The
    caller holds the guard lock. True when it wrote the file."""
    st = read_json(STATUS_FILE, None)
    if not isinstance(st, dict) or not isinstance(st.get('pool'), dict):
        return False
    refresh_headline(st)
    st['pool'].update(headline=SETTINGS['headline'], display=SETTINGS['display'])
    with contextlib.suppress(OSError):
        write_json(STATUS_FILE, st)
        return True
    return False


def cmd_enable(args):
    with guard_lock():
        s = match_seat(load_seats(), args.seat)
        set_disabled(s['name'], False)  # first: if this fails the park record stays and the guard unparks at reset
        guard = read_guard()
        g = guard.setdefault('seats', {}).setdefault(s['name'], {})
        if g.get('parked_until'):
            g['override_until'] = g.pop('parked_until')
            g.pop('parked_reason', None)
            write_json(GUARD_FILE, guard)
            print(f'Credit guard overridden for {s["label"]} until {when(g["override_until"])}; it may spend credits.')
        refresh_status_file()
    print(f'{s["label"]} enabled')


def cmd_disable(args):
    with guard_lock():
        s = match_seat(load_seats(), args.seat)
        guard = read_guard()
        g = guard.setdefault('seats', {}).setdefault(s['name'], {})
        g.pop('parked_until', None)
        g.pop('parked_reason', None)
        write_json(GUARD_FILE, guard)
        set_disabled(s['name'], True)
        refresh_status_file()
    print(f'{s["label"]} disabled (threads on it move to the next seat)')


def cmd_priority(args):
    s = match_seat(load_seats(), args.seat)
    set_fields(s['name'], priority=args.priority)
    print(f'{s["label"]} priority {s["priority"]} → {args.priority} (higher is used first)')


def cmd_label(args):
    problem = label_problem(args.label)
    if problem:
        sys.exit(f'codexpool label: {problem}')
    s = match_seat(load_seats(), args.seat)
    update_meta(s['name'], label=args.label)
    print(f'{s["name"]} is now labelled {args.label}')


def cmd_reserve(args):
    """Mark a seat as reserve (or not, with --off), and move it in the fill order when it is out of place: a reserve
    fills after every regular seat, a regular seat before every reserve."""
    seats = load_seats()
    s = match_seat(seats, args.seat)
    update_meta(s['name'], reserve=None if args.off else True)
    moved = ''
    if s['provider'] == 'codex':
        p, moves = fill_order(seats, reserve=not args.off, name=s['name'])
        if p != s['priority'] or moves:
            apply_fill_order(s['name'], p, moves)
        if p != s['priority']:
            moved = (f' It now fills {"before the reserve seats" if args.off else "after every regular seat"} '
                     f'(priority {s["priority"]} → {p}).')
    print(f'{s["label"]} is {"no longer " if args.off else ""}a reserve seat.{moved} The menu bar turns red while a '
          f'reserve seat serves; "headline": "regular" leaves reserve seats out of the headline %.')


def cmd_reset(args):
    """Redeem one banked free reset for a seat (soonest-expiring credit), then clear the pool's cooldown."""
    seats = load_seats()
    s = match_seat(seats, args.seat)
    if s['provider'] != 'codex':
        sys.exit(f'{s["label"]} is not a Codex seat')
    info = poll_resets(s)
    if not info['available']:
        sys.exit(f'{s["label"]} has no banked resets.')
    credit = info['credits'][0]
    guard = read_guard()
    usage = best_usage(s, guard.get('usage', {}))
    week, short_w = split_windows(usage)
    left = show_left()
    used = ', '.join(f'{name} {pct_text(w["used"], left)}{" left" if left else ""}'
                     for name, w in (('week', week), ('5h', short_w)) if w) or 'usage unknown'
    print(f'{s["label"]}: {used}. Banked resets: {info["available"]}. '
          f'Using "{credit["title"]}" (expires {when(credit.get("expires_at"))}).')
    if not args.yes:
        if input('Reset this seat\'s usage limit now? [y/N] ').strip().lower() not in ('y', 'yes'):
            sys.exit('cancelled')
    import uuid
    body = {'credit_id': credit['id'], 'redeem_request_id': str(uuid.uuid4())}
    code = data = None
    for attempt in (1, 2):  # the same redeem_request_id on retry, so a network blip cannot spend two credits
        try:
            code, data = _seat_call(s, 'POST', RESETS_CONSUME_URL, body)
            break
        except PoolTimeout:
            if attempt == 2:
                raise
    outcome = (data or {}).get('code') if isinstance(data, dict) else None
    record = {'at': now_utc().isoformat(), 'seat': s['label'], 'credit_id': credit['id'], 'http': code, 'outcome': outcome}
    with contextlib.suppress(OSError):
        with RESET_LOG.open('a') as f:
            f.write(json.dumps(record) + '\n')
    log_line(f'reset: {s["label"]} credit {credit["id"][-8:]} -> HTTP {code} {outcome}')
    if outcome == 'reset' or (code == 200 and outcome is None):
        with contextlib.suppress(ApiError, PoolDown):
            api('POST', '/v0/management/reset-quota', {'auth_index': s['auth_index']})
        with guard_lock():  # fresh numbers for the menu bar
            g = read_guard()
            with contextlib.suppress(ApiError, PoolDown):
                g.setdefault('usage', {})[s['name']] = {**poll_usage(s), 'polled_at': now_utc().isoformat()}
            with contextlib.suppress(ApiError, PoolDown):
                g.setdefault('resets', {})[s['name']] = poll_resets(s)
            write_json(GUARD_FILE, g)
        with contextlib.suppress(Exception):
            write_json(STATUS_FILE, status_now())
        notify('Codex seat reset', f'{s["label"]} is back to full usage.')
        print(f'{s["label"]} reset: usage limits are back to full and the pool can use it again.')
        return
    messages = {'already_redeemed': 'That reset was already used.',
                'nothing_to_reset': 'This seat\'s usage does not need a reset right now; the credit was not used.',
                'no_credit': 'No resets are available.'}
    sys.exit(messages.get(outcome) or f'Reset failed (HTTP {code}, {short(json.dumps(data), 160)}).')


def cmd_weight(args):
    if not valid_weight(args.weight):
        sys.exit(f'weight must be a positive number (Plus = 1, Pro = 20), not {args.weight:g}')
    s = match_seat(load_seats(), args.seat)
    update_meta(s['name'], weight=args.weight)
    print(f'{s["label"]} weight {s["weight"]:g} → {args.weight:g} (its share of the pool total; Plus = 1)')


def cmd_refresh(args):
    """Force token refreshes. The single-seat response embeds the seat's tokens, so only status is printed."""
    if args.seat:
        s = match_seat(load_seats(), args.seat)
        r = api('POST', '/v0/management/auth-files/refresh', {'name': s['name']}, timeout=90)
        a = r.get('auth') or {}
        msg = short(a.get('status_message') or '')
        print(f'{s["label"]}: refresh {"ok" if r.get("ok", True) else "failed"}, status {a.get("status") or "?"}'
              + (f' ({msg})' if msg else ''))
    else:
        r = api('POST', '/v0/management/auth-files/refresh', {'all': True}, timeout=180)
        labels = {s['name']: s['label'] for s in load_seats()}
        results = r.get('results') or []
        if not results:
            print('no seats with a refresh token to refresh')
        for x in results:
            name = x.get('id', '?')
            print(f'{labels.get(name, name)}: ' + ('ok' if x.get('success') else f'FAILED {short(str(x.get("error", "")))}'))


SEAT_LABEL_MAX = 64
URL_IN_TEXT = re.compile(r'https://[^\s"\'<>]+')
SAVED_LINE = re.compile(r'Authentication saved to (.+\.json)\s*$')


def label_problem(label):
    """Why a seat label will not do, or None. A label names the seat in status, the menu bar and every command
    (codexpool disable <label>): one line of text, no leading or trailing space, not starting with - (it would read
    as an option), at most SEAT_LABEL_MAX characters."""
    if not isinstance(label, str) or not label.strip():
        return 'a label cannot be empty'
    if label != label.strip():
        return 'a label cannot start or end with a space'
    if label.startswith('-'):
        return 'a label cannot start with - (it would read as an option)'
    if len(label) > SEAT_LABEL_MAX:
        return f'a label has at most {SEAT_LABEL_MAX} characters'
    if any(unicodedata.category(c) in ('Cc', 'Cs', 'Zl', 'Zp') for c in label):
        return 'a label is one line, without control characters'
    return None


def first_url(text):
    """The first https:// URL in a piece of CLIProxyAPI output (its sign-in link), or None."""
    m = URL_IN_TEXT.search(text or '')
    return m.group(0).rstrip('.,;:') if m else None


LOGIN_SOURCE = re.compile(r'openai_(device_)?login\.go')  # where CLIProxyAPI logs a failed Codex sign-in
# CLIProxyAPI's sign-in instructions: the link's heading, the wait, and the SSH-tunnel block it prints with -no-browser
SIGN_IN_NOISE = re.compile(r'(Visit the following URL to continue authentication:|Waiting for Codex authentication '
                           r'callback|Opening browser for Codex authentication|To authenticate from a remote machine|'
                           r'=+$|Run one of the following commands|# Standard SSH command|# If using an SSH key|'
                           r'ssh (-i \S+ )?-L |NOTE: If your server)')


def log_mark(path=None):
    """How long the pool log (main.log) is now, so sign_in_errors reads only what is written after (0: missing)."""
    try:
        return (path or MAIN_LOG).stat().st_size
    except OSError:
        return 0


def sign_in_errors(since, path=None):
    """The errors a CLIProxyAPI sign-in logged to main.log from byte since on. With logging-to-file on, as install
    configures it, its failures go there and not to its output: the link expired (its callback wait is 5 minutes),
    a state mismatch, a failed code exchange, a busy callback port. The pool writes to the same file; only lines
    from the sign-in's own source file count."""
    path = path or MAIN_LOG
    try:
        with path.open('rb') as f:
            if f.seek(0, os.SEEK_END) < since:  # rotated since: the new file holds only lines written after
                since = 0
            f.seek(since)
            text = f.read(1 << 20).decode(errors='replace')
    except OSError:
        return []
    return [m.group(3) for m in map(LOG_LINE.match, text.splitlines()) if m and LOGIN_SOURCE.fullmatch(m.group(2))]


def sign_in_failure(lines, since):
    """Why a sign-in did not finish, as at most four lines: what CLIProxyAPI printed apart from the link and its
    instructions (a log line only when it comes from the sign-in), then the errors it logged to main.log. Empty
    when neither says anything."""
    said = []
    for line in lines:
        text = line.replace(CPA_PASTE_PROMPT, '').strip()
        m = LOG_LINE.match(text)
        if m:  # logging-to-file off: CLIProxyAPI's log lines come on its output
            text = m.group(3) if LOGIN_SOURCE.fullmatch(m.group(2)) else ''
        if text and not first_url(text) and not SIGN_IN_NOISE.match(text) and text not in said:
            said.append(text)
    said += [e for e in sign_in_errors(since) if e not in said]
    return said[-4:]


def login_seat(device=False, no_open=False, echo=True, on_url=None, stdin=None):
    """One sign-in through CLIProxyAPI's own flow (codexpool login and codexpool setup). echo streams its output;
    on_url(url) runs once, with the first https:// URL in it (the sign-in link). Returns (seat file, output lines);
    the file is None when the sign-in did not complete. CLIProxyAPI's output never holds token material."""
    if device:
        flow = ['-codex-device-login', '-no-browser']
    else:
        flow = ['-codex-login'] + (['-no-browser'] if no_open else [])
    saved, url, lines = None, None, []
    with subprocess.Popen([str(cpa_binary()), '-config', str(CONFIG)] + flow, cwd=ROOT, stdin=stdin,
                          stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1) as p:
        try:
            for line in p.stdout:
                lines.append(line.rstrip('\n'))
                if echo:
                    sys.stdout.write(line)
                    sys.stdout.flush()
                if url is None:
                    url = first_url(line)
                    if url and on_url:
                        on_url(url)
                # search, not match: after 15 s CLIProxyAPI prompts for a pasted callback URL without a line break,
                # so the prompt and this line can share a line
                m = SAVED_LINE.search(line)
                if m:
                    saved = pathlib.Path(m.group(1))
                    saved = saved if saved.is_absolute() else ROOT / saved
        finally:
            if p.poll() is None:  # Ctrl-C, or on_url stopped: don't leave CLIProxyAPI's callback listener running
                p.terminate()
                try:
                    p.wait(5)
                except subprocess.TimeoutExpired:
                    p.kill()
    if not saved or not saved.exists():  # CLIProxyAPI exits 0 on failure; only this line proves success
        return None, lines
    return saved, lines


FILL_STEP = 100  # fill_order: how far below the last regular seat a new one goes, room for later seats


def fill_order(seats, reserve=False, name=None):
    """Where a seat goes in the fill order (priority, higher first), as (its priority, moves): moves is
    [(seat, new priority)] for reserve seats that have to move down to stay last. Regular seats fill in the order
    they were added and every reserve seat comes after all of them, so a regular seat goes below every other
    regular seat and above every reserve; a reserve goes below every seat. name: a seat already in the pool to place
    again (left out of the others; it keeps its priority when that is already in its place); without it the seat is
    a new one, not in seats. Priorities come out unique, so doctor has nothing to say about them."""
    codex = [s for s in seats if s['provider'] == 'codex' and s['name'] != name]
    me = next((s for s in seats if name is not None and s['name'] == name), None)
    regular = [s['priority'] for s in codex if not s['reserve']]
    reserves = [s for s in codex if s['reserve']]
    top_reserve = max((s['priority'] for s in reserves), default=None)
    if reserve:
        if me and all(me['priority'] < p for p in regular):
            return me['priority'], []
        return (min(s['priority'] for s in codex) - 10 if codex else 10), []
    if me and (top_reserve is None or me['priority'] > top_reserve):
        return me['priority'], []
    if not regular:
        return (top_reserve or 0) + 5 * FILL_STEP, []
    last = min(regular)  # every priority below it belongs to a reserve seat
    if top_reserve is None or top_reserve < last - 1:
        if top_reserve is None or last - FILL_STEP > top_reserve:
            return last - FILL_STEP, []
        return (last + top_reserve) // 2, []  # a whole number strictly between the two
    # No whole number is left between the last regular seat and the reserves (or a reserve fills before a regular
    # seat): the reserves move below the new place, keeping their own order.
    p = last - FILL_STEP
    ordered = sorted(reserves, key=lambda s: (-s['priority'], s['id']))  # CLIProxyAPI's fill-first order
    moves = [(s, p - FILL_STEP * (i + 1)) for i, s in enumerate(ordered)]
    return p, [(s, q) for s, q in moves if s['priority'] != q]


def apply_fill_order(name, priority, moves):
    """Set a seat's priority, and first move the reserve seats fill_order said to move."""
    for s, q in moves:
        set_fields(s['name'], priority=q)
    set_fields(name, priority=priority)


def set_priority_when_loaded(name, priority, label=None):
    """Set a new seat's priority once the pool's watcher has loaded its file (up to 20 s). priority is a number, or
    a function of the pool's seats that returns (priority, moves) the way fill_order does. Returns the priority
    set, or None, after saying how to set it later, when the seat did not load in time."""
    deadline = time.time() + 20
    seats = []
    while time.time() < deadline:
        with contextlib.suppress(PoolDown, ApiError):
            seats = load_seats()
            if any(s['name'] == name for s in seats):
                p, moves = priority(seats) if callable(priority) else (priority, [])
                apply_fill_order(name, p, moves)
                return p
        time.sleep(1)
    p = priority(seats)[0] if callable(priority) else priority
    print(f'warning: pool did not load {name} in time; set priority later with: '
          f'codexpool priority {shlex.quote(label or name)} {p}')
    return None


def duplicate_seat_warnings():
    """A warning for each ChatGPT account and workspace that has more than one seat file."""
    ids = {}
    for f in AUTH.glob('codex-*.json'):
        fc = file_claims(f)
        ids.setdefault((fc['email'], fc['account_id']), []).append(f.name)
    return [f'WARNING: {email} / {acct} is in the pool {len(names)} times: {", ".join(names)}. '
            'Remove the stale one with: codexpool remove <seat> --yes'
            for (email, acct), names in ids.items() if len(names) > 1]


def new_seat_place(name, reserve=False):
    """For set_priority_when_loaded: a new seat's place in the fill order, from the pool's seats with it loaded."""
    return lambda seats: fill_order([s for s in seats if s['name'] != name], reserve)


def fresh_seat_meta(name, label=None):
    """seats.json for a seat file that was not in the pool before: label, and no size or reserve flag left over
    from an earlier seat with that file name (the same account removed and signed in again)."""
    update_meta(name, label=label or None, weight=None, reserve=None)


def cmd_login(args):
    require_installed('login')
    problem = label_problem(args.label) if args.label is not None else None
    if problem:
        sys.exit(f'codexpool login: {problem}')
    if args.device:
        print('Starting a Codex device login. Open the URL, enter the code, and pick the workspace for this seat.\n')
    else:
        print('Opening the ChatGPT sign-in in your browser. Sign in and pick the workspace for this seat.\n'
              '(If the browser does not open, use the URL printed below.)\n')
    before = {p.name for p in AUTH.glob('codex-*.json')}
    mark = log_mark()
    saved, _ = login_seat(device=args.device, no_open=args.no_open)
    if not saved:
        errors = sign_in_errors(mark)  # its output was on screen already; these went to main.log
        sys.exit('\nlogin did not complete; nothing changed' + (f' (the pool said: {errors[-1]})' if errors else ''))
    c = file_claims(saved)
    new = saved.name not in before
    if new:
        fresh_seat_meta(saved.name, args.label)
    elif args.label:
        update_meta(saved.name, label=args.label)
    priority = args.priority
    if priority is not None:
        set_priority_when_loaded(saved.name, priority, args.label)
    elif new:  # after the seats already in the pool and before the reserve, as setup does
        priority = set_priority_when_loaded(saved.name, new_seat_place(saved.name), args.label)
    print(f'\nseat {saved.name}: {c["email"]} plan={c["plan"]} account={c["account_id"]}'
          + (f' label={args.label}' if args.label else '') + (f' priority={priority}' if priority is not None else ''))
    for warning in duplicate_seat_warnings():
        print(warning)


def cmd_remove(args):
    s = match_seat(load_seats(), args.seat)
    if not args.yes:
        sys.exit(f'This deletes {s["name"]} from the pool (the login is not revoked). Re-run with --yes.')
    api('DELETE', '/v0/management/auth-files?name=' + urllib.parse.quote(s['name']))
    update_meta(s['name'], label=None, weight=None, reserve=None)
    print(f'removed {s["name"]}')


def wait_healthy(timeout=30, want_version=None):
    deadline = time.time() + timeout
    while time.time() < deadline:
        if port_open(PORT):
            v = running_version()
            if v and (want_version is None or v == want_version):
                return True
        time.sleep(0.5)
    return False


def kick_pool():
    r = subprocess.run(['launchctl', 'kickstart', '-k', f'gui/{UID}/{POOL_JOB}'], capture_output=True, text=True)
    if r.returncode != 0:
        raise RuntimeError(f'launchctl kickstart failed: {r.stderr.strip() or r.returncode}')


def cmd_restart(args):
    kick_pool()
    print('pool restarted' if wait_healthy() else 'pool did not come back within 30s; run: codexpool doctor')


def cmd_logs(args):
    target = GUARD_LOG if args.guard else MAIN_LOG
    os.execvp('tail', ['tail', '-n', str(args.lines)] + (['-F'] if args.follow else []) + [str(target)])


# ---------------------------------------------------------------- selftest

def _run_codex(argv, timeout=600):
    # stdin must be closed: codex exec waits for end-of-input on a non-terminal stdin before it starts.
    p = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
    thread_id, answer, usage, errors = None, '', {}, []
    for line in p.stdout.splitlines():
        with contextlib.suppress(ValueError):
            ev = json.loads(line)
            kind = ev.get('type', '')
            if kind == 'thread.started':
                thread_id = ev.get('thread_id')
            elif kind == 'item.completed' and (ev.get('item') or {}).get('type') == 'agent_message':
                answer = ev['item'].get('text', '')
            elif kind == 'turn.completed':
                usage = ev.get('usage') or {}
            elif kind in ('turn.failed', 'error'):
                errors.append(json.dumps(ev)[:400])
    if p.returncode != 0 and not errors:
        errors.append((p.stderr or p.stdout)[-400:])
    return {'code': p.returncode, 'thread_id': thread_id, 'answer': answer, 'usage': usage, 'errors': errors}


def _rollout_for(thread_id):
    hits = sorted((HOME / '.codex/sessions').glob(f'**/rollout-*{thread_id}.jsonl'))
    return hits[-1] if hits else None


def _thread_facts(thread_id):
    """What a test thread really contains: encrypted reasoning items, compactions, per-request token sizes."""
    facts = {'reasoning_encrypted': 0, 'compactions': 0, 'requests': []}
    path = _rollout_for(thread_id) if thread_id else None
    if not path:
        return facts
    for line in path.read_text(errors='replace').splitlines():
        with contextlib.suppress(ValueError, AttributeError):
            e = json.loads(line)
            kind, payload = e.get('type'), e.get('payload') or {}
            ptype = payload.get('type') if isinstance(payload, dict) else None
            if ptype == 'reasoning' and payload.get('encrypted_content'):
                facts['reasoning_encrypted'] += 1
            if kind == 'compacted' or ptype in ('compaction', 'compaction_summary'):
                facts['compactions'] += 1
            if kind == 'event_msg' and ptype == 'token_count':
                last = ((payload.get('info') or {}).get('last_token_usage') or {})
                if last.get('input_tokens'):
                    facts['requests'].append((int(last['input_tokens']), int(last.get('output_tokens') or 0)))
    return facts


def _raise_exit(signum, frame):
    raise SystemExit(128 + signum)


def cmd_selftest(args):
    """Move one real Codex thread from seat A to seat B and check it survives (spends a few requests)."""
    codex = codex_bin()
    if not codex:
        sys.exit('codexpool: the Codex CLI was not found (not in the Codex app, not on PATH); '
                 f'set "codex_bin" in {SETTINGS_FILE}')
    with guard_lock():
        recover_selftest({})
        now = now_utc()
        guard = read_guard()
        seats = [s for s in load_seats() if s['provider'] == 'codex']
        a, b = match_seat(seats, args.from_seat), match_seat(seats, args.to_seat)
        if a['name'] == b['name']:
            sys.exit('pick two different seats')
        for s in (a, b):
            state, detail, until = seat_state(s, guard, now)
            if state != 'ready':
                sys.exit(f'{s["label"]} is {state}' + (f' until {when(until)}' if until else '') + '; pick seats that are ready')
        # Only seats that are enabled and ready get paused; seats already out of rotation are left alone
        # (disabling wipes CLIProxyAPI's cooldown memory for them).
        horizon = now + dt.timedelta(minutes=15)

        def pausable(s):
            state, _, until = seat_state(s, guard, now)
            if state == 'ready':
                return True
            t = parse_time(until)
            return state in ('cooldown', 'exhausted') and t is not None and t <= horizon  # could return mid-test

        movable = [s for s in seats if not s['disabled'] and pausable(s)]
        toggled = {}
        log_start = MAIN_LOG.stat().st_size if MAIN_LOG.exists() else 0
        work = tempfile.mkdtemp(prefix='codexpool-selftest-')
        common = [codex, 'exec', '--json', '--skip-git-repo-check', '-s', 'read-only', '-C', work,
                  '-c', f'openai_base_url="{BASE}/v1"', '-c', f'model="{args.model}"',
                  '-c', f'model_reasoning_effort="{args.effort}"', '-c', 'notify=[]']

        def only(seat):
            for s in movable:
                want = s['name'] != seat['name']
                if s['name'] not in toggled:
                    toggled[s['name']] = s['disabled']
                    write_json(SELFTEST_JOURNAL, {'pid': os.getpid(), 'toggled': toggled})
                set_disabled(s['name'], want)

        results = []
        print(f'selftest: {a["label"]} → {b["label"]} (model {args.model}); other seats paused for ~1-3 minutes')
        for sig in (signal.SIGHUP, signal.SIGTERM):
            signal.signal(sig, _raise_exit)
        try:
            only(a)
            t1 = _run_codex(common + ['First, without using any tool, find the smallest positive integer n with '
                                      'n mod 7 = 3, n mod 11 = 5 and n mod 13 = 9, and state it as N=<n>. '
                                      'Then run the shell command `echo $((17*23))`. Then write about 1500 words, '
                                      'with worked examples, on why multiplication distributes over addition. '
                                      'End with: ANSWER=<the number the shell printed>.'])
            results.append(('turn 1 on ' + a['label'], t1))
            if not t1['thread_id'] or t1['errors']:
                raise RuntimeError('turn 1 failed')
            if args.compact:
                # Put the compaction threshold between the first request of turn 1 and the context after it,
                # so the next turn on this seat must compact once (and fits afterwards).
                reqs = _thread_facts(t1['thread_id'])['requests']
                base = reqs[0][0] if reqs else 20000
                after = (reqs[-1][0] + reqs[-1][1]) if reqs else base + 2000
                limit = int((base + after) // 2)
                t2 = _run_codex(common + ['-c', f'model_auto_compact_token_limit={limit}', 'resume', t1['thread_id'],
                                          'Add 9 to the previous ANSWER. Reply only with ANSWER2=<number>.'])
                results.append((f'turn 2 on {a["label"]} (forced compaction at {limit} tokens)', t2))
                if t2['errors']:
                    raise RuntimeError('turn 2 failed')
            only(b)
            t3 = _run_codex(common + ['resume', t1['thread_id'],
                                      'Multiply the first ANSWER by 2 using the shell (`echo $((ANSWER*2))`). '
                                      'Reply only with ANSWER3=<number>.'])
            results.append(('turn 3 on ' + b['label'] + ' (cross-seat)', t3))
        except RuntimeError:
            pass
        finally:
            for sig in (signal.SIGHUP, signal.SIGTERM, signal.SIGINT):
                signal.signal(sig, signal.SIG_IGN)
            restored = True
            for name, was in toggled.items():
                try:
                    set_disabled(name, was)
                except (ApiError, PoolDown):
                    restored = False
            if restored:
                with contextlib.suppress(OSError):
                    SELFTEST_JOURNAL.unlink()
            else:
                print('WARNING: could not restore every seat; the guard will retry from the journal.')
            shutil.rmtree(work, ignore_errors=True)
    log_tail = ''
    if MAIN_LOG.exists():
        with MAIN_LOG.open('rb') as f:
            f.seek(log_start)
            log_tail = f.read().decode(errors='replace')
    bad = re.findall(r'.*(?:invalid_encrypted_content|thinking_signature_invalid|could not be verified|'
                     r'Item with id .* not found).*', log_tail)
    tid = results[0][1]['thread_id'] if results else None
    facts = _thread_facts(tid)
    failed = len(results) < 2 or any(r['errors'] for _, r in results) or bool(bad)
    missing = []
    if facts['reasoning_encrypted'] == 0:
        missing.append('no encrypted reasoning in the thread')
    if args.compact and facts['compactions'] == 0:
        missing.append('no compaction happened')
    verdict = 'FAIL' if failed else ('INCONCLUSIVE' if missing else 'PASS')
    ok = verdict == 'PASS'
    for title, r in results:
        print(f'  [{"ok " if not r["errors"] else "FAIL"}] {title}: {r["answer"][-80:]!r}')
        for e in r['errors']:
            print(f'         {e}')
    for line in bad[:5]:
        print(f'  pool log: {line[:200]}')
    print(f'  carried across: {facts["reasoning_encrypted"]} encrypted reasoning item(s), '
          f'{facts["compactions"]} compaction(s)')
    print('RESULT:', {'PASS': 'PASS: encrypted reasoning' + (' and a compaction' if args.compact else '') +
                      ' survived the seat move',
                      'FAIL': 'FAIL: see above',
                      'INCONCLUSIVE': 'INCONCLUSIVE: ' + '; '.join(missing)}[verdict])
    record = read_json(STATE / 'selftests.json', [])
    record.append({'at': now_utc().isoformat(), 'from': a['label'], 'to': b['label'], 'compact': args.compact,
                   'model': args.model, 'effort': args.effort, 'result': verdict,
                   'reasoning_items': facts['reasoning_encrypted'], 'compactions': facts['compactions']})
    write_json(STATE / 'selftests.json', record)
    sys.exit({'PASS': 0, 'FAIL': 1, 'INCONCLUSIVE': 2}[verdict])


# ---------------------------------------------------------------- doctor

def toml_top_level(path=CODEX_CONFIG):
    """Top-level key = value pairs of a TOML file (before the first table)."""
    out = {}
    try:
        for line in pathlib.Path(path).read_text().splitlines():
            if line.lstrip().startswith('['):
                break
            m = re.match(r'\s*([A-Za-z0-9_.-]+)\s*=\s*(.+?)\s*$', line)
            if m and not line.lstrip().startswith('#'):
                out[m.group(1)] = m.group(2)
    except OSError:
        pass
    return out


def unquote(v):
    """The value of a TOML scalar as toml_top_level() returns it: "basic" or 'literal' strings, trailing # comments."""
    v = (v or '').strip()
    m = re.match(r'"((?:[^"\\]|\\.)*)"', v) or re.match(r"'([^']*)'", v)
    if m:
        return m.group(1)
    return v.split('#', 1)[0].strip()


def gate_probe(port=PORT):
    """(plain_status, browser_status): a Codex-like request must pass, a browser one must get 403."""
    def get(headers):
        req = urllib.request.Request(f'http://127.0.0.1:{port}/v1/models', headers=headers)
        try:
            with _LOCAL.open(req, timeout=5) as r:
                return r.status
        except urllib.error.HTTPError as e:
            e.close()
            return e.code
        except (urllib.error.URLError, OSError):
            return None
    return get({}), get({'Origin': PROBE_ORIGIN, 'Sec-Fetch-Site': 'cross-site'})


class DoctorReport:
    """What codexpool doctor finds, section by section. With echo each check is printed as it is made (the text
    report); without, it is only collected (doctor --json). A failed check is a problem, a failed warn=True check
    a warning; a fix is kept only for a check that failed, which is also the only time the text report shows it."""

    def __init__(self, echo=True):
        self.echo = echo
        self.sections = []
        self.problems = 0
        self.warnings = 0

    def section(self, title):
        if self.echo:
            print(f'\n{title}' if self.sections else title)
        self.sections.append({'title': title, 'checks': []})

    def check(self, ok, text, fix=None, warn=False):
        status = 'ok' if ok else ('warn' if warn else 'fail')
        if self.echo:
            print(f' {"✓" if ok else ("!" if warn else "✗")} {text}' + ('' if ok or not fix else f'\n     → {fix}'))
        self.sections[-1]['checks'].append({'status': status, 'text': text, 'fix': None if ok or not fix else fix})
        self.problems += status == 'fail'
        self.warnings += status == 'warn'

    def verdict(self):
        return 'OK' if not self.problems else f'{self.problems} problem(s)'

    def as_json(self):
        return {'ok': not self.problems, 'problems': self.problems, 'warnings': self.warnings,
                'sections': self.sections}


def cmd_doctor(args):
    rep = DoctorReport(echo=not args.json)
    if not args.json:
        require_installed('doctor')
        doctor_checks(rep)
        print(f'\n{rep.verdict()}')
        sys.exit(1 if rep.problems else 0)
    missing = missing_install()
    with contextlib.redirect_stdout(sys.stderr):  # stdout carries the JSON and nothing else
        if missing:
            rep.section('Install')
            rep.check(False, f'codexpool is not installed yet ({", ".join(missing)} missing)',
                      'run the installer, or ./bin/codexpool install from a checkout')
        else:
            doctor_checks(rep)
    print(json.dumps(rep.as_json(), indent=2))
    sys.exit(1 if rep.problems else 0)


def doctor_checks(rep):
    """Every check codexpool doctor makes, reported to rep (a DoctorReport). Needs an install."""
    check = rep.check
    rep.section('Pool process')
    loaded, pid = launchd_loaded(POOL_JOB)
    check(loaded and pid, f'launchd job {POOL_JOB} ' + (f'running (pid {pid})' if pid else 'not running'),
          f'launchctl bootstrap gui/{UID} {LAUNCH_AGENTS / (POOL_JOB + ".plist")}')
    check(port_open(PORT), f'listening on 127.0.0.1:{PORT}', 'codexpool restart ; codexpool logs')
    key_error = None
    try:
        mgmt_key()
    except KeyUnavailable as e:
        key_error = e
        check(False, f'management key: {e}', e.fix)
    live = None if key_error else running_version()
    if not key_error:
        check(bool(live) and '+gate' in live, f'running build: {live or "unknown"} (installed {cpa_version()})',
              'the pool must run a +gate build: codexpool upgrade <version>')
    plain, browser = gate_probe()
    check(plain == 200 and browser == 403, f'origin gate: Codex-like request {plain}, browser request {browser}',
          'expected 200 and 403; run: codexpool upgrade <version> --force')
    cfg = CONFIG.read_text() if CONFIG.exists() else ''
    check('host: "127.0.0.1"' in cfg, 'bound to loopback only')
    check(re.search(r'^api-keys:\s*\[\]', cfg, re.M) is not None, 'client auth open on loopback (api-keys: [])',
          'the Codex app sends its own bearer; api-keys must be [] (the origin gate protects the pool)')
    try:
        if key_error:
            raise key_error
        seats = load_seats()
        check(True, 'management API reachable (Keychain key ok)')
    except KeyUnavailable:
        seats = []  # already reported above
    except (PoolDown, ApiError) as e:
        seats = []
        check(False, f'management API: {short(str(e), 120)}', 'codexpool restart')

    rep.section('Codex app')
    top = toml_top_level()
    base_url = unquote(top.get('openai_base_url'))
    check(base_url == f'{BASE}/v1', f'openai_base_url = {base_url or "(unset)"}',
          f'set openai_base_url = "{BASE}/v1" in {CODEX_CONFIG}')
    check('model_provider' not in top, 'built-in openai provider (thread history visible)',
          'remove model_provider from config.toml; a custom provider hides all existing threads')
    check('model_catalog_json' not in top, 'live model catalog (no static model_catalog_json)',
          'remove model_catalog_json from config.toml', warn=True)

    rep.section('Seats')
    st = build_status(seats, read_guard()) if seats else {'seats': [], 'active': None}
    codex = [r for r in st['seats'] if r['provider'] == 'codex']
    check(len(codex) >= 1, f'{len(codex)} Codex seats in the pool', 'codexpool login <label> --priority <n>')
    for r in codex:
        ok = r['state'] in ('active', 'ready', 'exhausted', 'parked', 'cooldown', 'disabled')
        text = f'{r["label"]}: {r["state"]}' + (f' ({r["detail"]})' if r['detail'] else '') + \
               (f', back {when(r["until"])}' if r['until'] else '')
        q = shlex.quote(r['label'])
        check(ok, text, f'codexpool refresh {q} ; if it stays blocked: codexpool login {q} --priority {r["priority"]}')
        cred = (r['usage'] or {}).get('credits') or {}
        if cred.get('balance'):
            check(False, f'{r["label"]} holds {cred["balance"]:g} credits (spent silently past 100%)',
                  'turn off auto top-up in ChatGPT billing; the credit guard parks the seat at 100% meanwhile', warn=True)
    prios = {}
    for r in codex:
        if r['state'] != 'disabled':
            prios.setdefault(r['priority'], []).append(r['label'])
    for p, names in prios.items():
        check(len(names) == 1, f'priority {p} is unique', f'{", ".join(names)} share priority {p}; fill order among them '
              'follows file names. Make it explicit: codexpool priority <seat> <n>', warn=True)
    ids = {}
    for f in AUTH.glob('codex-*.json'):
        c = file_claims(f)
        ids.setdefault((c['email'], c['account_id']), []).append(f.name)
    for (email, acct), names in ids.items():
        check(len(names) == 1, f'{email} / {acct} appears once', f'duplicate seat files: {names}', warn=True)
    logins = sorted(AUTH.glob('*.json')) + [p for p in (HOME / '.codex' / 'auth.json',) if p.exists()]
    loose = [p for p in logins if os.stat(p).st_mode & 0o777 != 0o600]
    check(not loose, f'login files are private (mode 600): {len(logins)} checked' if not loose else
          f'login files readable by others: {", ".join(tilde(p) for p in loose)}',
          'chmod 600 ' + ' '.join(shlex.quote(str(p)) if ' ' in str(p) else tilde(p) for p in loose))
    check(st.get('active') is not None, f'new threads land on: {st.get("active") or "nothing available"}', warn=True)

    rep.section('Guard and visibility')
    check(launchd_loaded(GUARD_JOB)[0], f'launchd job {GUARD_JOB} loaded',
          f'launchctl bootstrap gui/{UID} {LAUNCH_AGENTS / (GUARD_JOB + ".plist")}')
    last = parse_time(read_guard().get('last_pass'))
    check(bool(last) and (now_utc() - last).total_seconds() < 300, f'guard last completed {when(last) if last else "never"}',
          'codexpool logs --guard')
    mb_loaded, mb_pid = launchd_loaded(MENUBAR_JOB)
    check(mb_loaded and mb_pid, f'menu bar app running' + (f' (pid {mb_pid})' if mb_pid else ''),
          f'launchctl bootstrap gui/{UID} {LAUNCH_AGENTS / (MENUBAR_JOB + ".plist")}  (log: {LOGS / "menubar.log"})', warn=True)
    j = read_json(SELFTEST_JOURNAL, None)
    check(not j or pid_alive(j.get('pid')), 'no interrupted selftest', 'the guard restores its seats on its next pass', warn=True)

    if LANES_FILE.exists():
        rep.section('Lanes')
        doctor_lanes(check, seats)

    rep.section('Recent pool errors (last 24h of logs)')
    counts = {}
    cutoff = (dt.datetime.now() - dt.timedelta(hours=24)).strftime('%Y-%m-%d %H:%M')
    for log in sorted(LOGS.glob('main*.log')):
        with contextlib.suppress(OSError):
            if dt.datetime.fromtimestamp(log.stat().st_mtime) < dt.datetime.now() - dt.timedelta(hours=24):
                continue
            for line in log.read_text(errors='replace').splitlines():
                m = LOG_LINE.match(line)
                if not m or m.group(1) < cutoff:
                    continue  # continuation lines and old lines
                src, msg = m.group(2), m.group(3)
                if src == 'codexpool_gate.go':
                    g = GATE_FIELDS.search(msg)
                    if not (g and g.group(1) == PROBE_ORIGIN):
                        counts['codexpool gate: rejected'] = counts.get('codexpool gate: rejected', 0) + 1
                    continue
                if src == 'gin_logger.go':
                    continue  # access-log lines echo request paths, which any client controls
                for pat in ('invalid_encrypted_content', 'thinking_signature_invalid', 'auth_unavailable',
                            'usage_limit_reached', 'refresh_token_reused'):
                    if pat in msg:
                        counts[pat] = counts.get(pat, 0) + 1
    check(not counts.get('invalid_encrypted_content') and not counts.get('thinking_signature_invalid'),
          'no cross-seat encrypted-content failures',
          "a seat pair rejects each other's thread state; run codexpool selftest on that pair")
    check(not counts.get('refresh_token_reused'), 'no refresh_token_reused',
          'a seat file is shared with another tool; never copy seat files; re-login the affected seat')
    if counts.get('codexpool gate: rejected'):
        check(False, f'{counts["codexpool gate: rejected"]} browser/non-loopback requests blocked by the gate',
              'something local tried to use the pool from a web context; see: grep "codexpool gate" ~/.codexpool/logs/main.log',
              warn=True)


# ---------------------------------------------------------------- build / upgrade

def _download(url, dest):
    req = urllib.request.Request(url, headers={'User-Agent': 'codexpool'})
    with urllib.request.urlopen(req, timeout=180) as r, open(dest, 'wb') as f:
        shutil.copyfileobj(r, f)


def _github_json(path):
    req = urllib.request.Request(f'https://api.github.com/repos/{REPO}/{path}',
                                 headers={'User-Agent': 'codexpool', 'Accept': 'application/vnd.github+json'})
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.loads(r.read())


def gate_selftest(binary):
    """Run a built binary on a scratch port with an empty auth dir and check the gate end to end."""
    work = pathlib.Path(tempfile.mkdtemp(prefix='codexpool-gate-'))
    with socket.socket() as s:
        s.bind(('127.0.0.1', 0))
        port = s.getsockname()[1]
    key = hashlib.sha256(os.urandom(16)).hexdigest()
    (work / 'auth').mkdir()
    (work / 'config.yaml').write_text(
        f'host: "127.0.0.1"\nport: {port}\nauth-dir: "{work / "auth"}"\napi-keys: []\nlogging-to-file: false\n'
        f'remote-management: {{allow-remote: false, secret-key: "{key}", disable-control-panel: true}}\n')
    proc = subprocess.Popen([str(binary), '-config', str(work / 'config.yaml')], cwd=work,
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        deadline = time.time() + 20
        while time.time() < deadline and not port_open(port):
            time.sleep(0.2)
        if not port_open(port):
            return False, 'built binary did not start'

        def code(path, headers=None, method='GET'):
            req = urllib.request.Request(f'http://127.0.0.1:{port}{path}', headers=headers or {}, method=method)
            try:
                with _LOCAL.open(req, timeout=5) as r:
                    return r.status
            except urllib.error.HTTPError as e:
                return e.code
            except (urllib.error.URLError, OSError):
                return None
        evil = {'Origin': 'https://example.com'}
        cases = [
            ('Codex-like GET /v1/models', code('/v1/models'), 200),
            ('browser Origin', code('/v1/models', evil), 403),
            ('CORS preflight', code('/v1/responses', {**evil, 'Access-Control-Request-Method': 'POST'}, 'OPTIONS'), 403),
            ('no-cors cross-site', code('/v1/models', {'Sec-Fetch-Site': 'cross-site'}), 403),
            ('DNS rebinding Host', code('/v1/models', {'Host': f'attacker.example:{port}'}), 403),
            ('Codex renderer app://-', code('/v1/models', {'Origin': 'app://-', 'Sec-Fetch-Site': 'cross-site'}), 200),
            ('management with key', code('/v0/management/auth-files', {'Authorization': f'Bearer {key}'}), 200),
        ]
        for _ in range(6):  # browser-originated keyless management calls must not get loopback banned
            code('/v0/management/auth-files', evil)
        cases.append(('management after 6 browser attempts', code('/v0/management/auth-files',
                                                                 {'Authorization': f'Bearer {key}'}), 200))
        def ws_code(headers=None, host=None):
            extra = ''.join(f'{k}: {v}\r\n' for k, v in (headers or {}).items())
            try:
                with socket.create_connection(('127.0.0.1', port), timeout=5) as s:
                    s.sendall(f'GET /v1/responses HTTP/1.1\r\nHost: {host or f"127.0.0.1:{port}"}\r\n'
                              'Connection: Upgrade\r\nUpgrade: websocket\r\nSec-WebSocket-Version: 13\r\n'
                              f'Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n{extra}\r\n'.encode())
                    parts = s.recv(200).decode(errors='replace').split('\r\n')[0].split()
                    return int(parts[1]) if len(parts) > 1 and parts[1].isdigit() else None
            except OSError:
                return None
        cases += [
            ('WebSocket upgrade (Codex-like)', ws_code(), 101),
            ('WebSocket upgrade from a browser page', ws_code(evil), 403),
            ('WebSocket upgrade via DNS rebinding', ws_code(host=f'attacker.example:{port}'), 403),
        ]
        failed = [f'{n}: got {got}, want {want}' for n, got, want in cases if got != want]
        return not failed, '; '.join(failed) or f'{len(cases)} gate checks passed'
    finally:
        proc.terminate()
        with contextlib.suppress(subprocess.TimeoutExpired):
            proc.wait(timeout=10)
        if proc.poll() is None:
            proc.kill()
        shutil.rmtree(work, ignore_errors=True)


def gate_id(gate_src=None):
    """Short hash of everything codexpool changes in upstream; part of the build dir and version."""
    gate_src = GATE_SOURCE.read_bytes() if gate_src is None else gate_src
    return hashlib.sha256(gate_src + b'\0' + GATE_ANCHOR.encode() + b'\0' +
                          GATE_REPLACEMENT.encode()).hexdigest()[:10]


def gate_version(version):
    return f'{version}+gate.{gate_id()}'


def build(version):
    """Build CLIProxyAPI <version> from its release tag plus codexpool_gate.go; return the version dir."""
    gate_src = GATE_SOURCE.read_bytes()
    gid = gate_id(gate_src)
    dest = VERSIONS / f'v{version}-gate-{gid}'
    if (dest / 'cli-proxy-api').exists():
        return dest
    go = TOOLCHAIN / 'current' / 'bin' / 'go'
    if not go.exists():
        sys.exit(f'Go toolchain missing at {go}; run: codexpool install (it fetches the official build from go.dev)')
    commit = _github_json(f'commits/v{version}')['sha'][:8]
    src = pathlib.Path(tempfile.mkdtemp(prefix=f'codexpool-src-v{version}-', dir=BUILD))
    try:
        print(f'fetching v{version} source (commit {commit})')
        tgz = src / 'src.tgz'
        _download(f'https://codeload.github.com/{REPO}/tar.gz/refs/tags/v{version}', tgz)
        with tarfile.open(tgz) as t:
            root = t.getnames()[0].split('/')[0]
            t.extractall(src, filter='data')
        tree = src / root
        main_go = tree / 'cmd/server/main.go'
        text = main_go.read_text()
        if text.count(GATE_ANCHOR) != 1:
            sys.exit(f'v{version}: gate anchor not found exactly once in cmd/server/main.go; upstream changed. '
                     f'Update GATE_ANCHOR in codexpool before upgrading. Nothing was changed.')
        if 'WithEngineConfigurator' in text:
            sys.exit(f'v{version}: upstream now sets its own engine configurator; the gate would replace it. '
                     'Move the gate to api.WithMiddleware before upgrading. Nothing was changed.')
        main_go.write_text(text.replace(GATE_ANCHOR, GATE_REPLACEMENT))
        (tree / 'cmd/server/codexpool_gate.go').write_bytes(gate_src)
        env = {**os.environ, 'GOROOT': str(TOOLCHAIN / 'current'), 'GOPATH': str(TOOLCHAIN / 'gopath'),
               'GOTOOLCHAIN': 'local', 'CGO_ENABLED': '0', 'GOFLAGS': '-mod=mod',
               'PATH': f'{TOOLCHAIN / "current" / "bin"}:{os.environ.get("PATH", "")}'}
        stamp = now_utc().strftime('%Y-%m-%dT%H:%M:%SZ')
        out = src / 'cli-proxy-api'
        print('building (CGO off; plugins unsupported, not used)')
        r = subprocess.run([str(go), 'build', '-trimpath', '-buildvcs=false', '-ldflags',
                            f'-s -w -X main.Version={version}+gate.{gid} -X main.Commit={commit} -X main.BuildDate={stamp}',
                            '-o', str(out), './cmd/server'], cwd=tree, env=env, capture_output=True, text=True)
        if r.returncode != 0:
            sys.exit(f'build failed:\n{r.stderr[-2000:]}')
        ok, detail = gate_selftest(out)
        if not ok:
            sys.exit(f'built binary failed the gate self-test: {detail}. Nothing was changed.')
        print(f'gate self-test: {detail}')
        staging = VERSIONS / f'.{dest.name}.partial'
        shutil.rmtree(staging, ignore_errors=True)
        staging.mkdir(parents=True)
        shutil.copy2(out, staging / 'cli-proxy-api')
        shutil.copy2(tree / 'config.example.yaml', staging / 'config.example.yaml')
        shutil.copy2(tree / 'LICENSE', staging / 'LICENSE')
        (staging / 'BUILD-INFO').write_text(f'upstream v{version} commit {commit}\n+ build/codexpool_gate.go gate {gid}\n'
                                            f'built {stamp} with {subprocess.run([str(go), "version"], capture_output=True, text=True, env=env).stdout.strip()}\n')
        os.replace(staging, dest)
        return dest
    finally:
        shutil.rmtree(src, ignore_errors=True)


def _point_current(target):
    link = BIN / '.current.tmp'
    with contextlib.suppress(FileNotFoundError):
        link.unlink()
    link.symlink_to(target)
    os.replace(link, CURRENT)


def cmd_build(args):
    version = args.version.lstrip('v')
    if version == 'latest':
        version = _github_json('releases/latest')['tag_name'].lstrip('v')
    print(f'ready: {build(version)}')


def cmd_upgrade(args):
    version = args.version.lstrip('v')
    if version == 'latest':
        version = _github_json('releases/latest')['tag_name'].lstrip('v')
    target_version = gate_version(version)
    if running_version() == target_version and not args.force:
        print(f'already running {target_version}')
        return
    dest = build(version)
    try:
        seats_before = len(load_seats())
    except (PoolDown, ApiError, KeyUnavailable):
        seats_before = None  # pool already down: allow upgrade/downgrade as recovery
    previous = os.readlink(CURRENT) if CURRENT.is_symlink() else None
    swapped = False
    try:
        if not (previous and pathlib.Path(previous).resolve() == dest.resolve()):
            swapped = True  # set first: re-pointing to previous is harmless if the swap never happened
            _point_current(dest)
        kick_pool()
        healthy = wait_healthy(45, want_version=target_version)
        if healthy and seats_before is not None:
            try:
                healthy = len(load_seats()) == seats_before
            except (PoolDown, ApiError, KeyUnavailable):
                healthy = False
        if healthy:
            plain, browser = gate_probe()
            healthy = plain == 200 and browser == 403
        if not healthy:
            raise RuntimeError('health check failed')
    except BaseException as e:
        for sig in (signal.SIGHUP, signal.SIGTERM, signal.SIGINT):
            signal.signal(sig, signal.SIG_IGN)  # a second signal must not cut the restore short
        back = None
        if swapped and previous:
            _point_current(previous)
            with contextlib.suppress(Exception):
                kick_pool()
            back = wait_healthy(45)
        reason = e if not isinstance(e, SystemExit) else f'signal {e.code}'
        if back is None:
            where = 'the pool was restarted and is unhealthy' if not swapped else f'current now points at {dest}'
            sys.exit(f'{target_version} failed ({reason}); {where}. Run: codexpool doctor')
        if back:
            sys.exit(f'{target_version} failed ({reason}); rolled back to {previous}, pool is up')
        sys.exit(f'{target_version} failed ({reason}); rolled back to {previous} but nothing answers on :{PORT}. '
                 'Run: codexpool doctor')
    print(f'now running {target_version}. Previous build kept at {previous}.')


# ---------------------------------------------------------------- install / uninstall

def set_toml_top_level(key, value, path=CODEX_CONFIG):
    """Set (value: TOML literal) or delete (value None) a top-level key, leaving everything else as is.
    A symlinked file (dotfiles) is edited where it points, so the link stays a link."""
    path = pathlib.Path(path).resolve()
    lines = path.read_text().splitlines(keepends=True)
    first_table = next((i for i, l in enumerate(lines) if l.lstrip().startswith('[')), len(lines))
    pat = re.compile(rf'^\s*{re.escape(key)}\s*=')
    idx = next((i for i in range(first_table) if pat.match(lines[i])), None)
    if value is None:
        if idx is not None:
            del lines[idx]
    elif idx is not None:
        lines[idx] = f'{key} = {value}\n'
    else:
        lines.insert(0, f'{key} = {value}\n')
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=path.name + '.', suffix='.tmp')
    with os.fdopen(fd, 'w') as f:
        f.write(''.join(lines))
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


REPO_URL = 'https://github.com/memfactorduke/codex-load-balancer'
CODEX_BACKUP = 'codex-config.pre-install-{stamp}.toml'  # in STATE; one per install, never overwritten
CODEX_KEYS = ('openai_base_url', 'model_provider', 'model_catalog_json')  # what install may change, recorded first
CONFIG_WARNINGS = {'model_provider': 'a custom provider hides every existing Codex thread',
                   'model_catalog_json': 'a static catalog freezes the model picker'}
WRAPPER = HOME / '.local' / 'bin' / 'codexpool'
WRAPPER_MARK = '# codexpool wrapper, written by `codexpool install`'
CODE_FILES = ('bin/codexpool', 'build/codexpool_gate.go', 'menubar/codexpool_menubar.py',
              'menubar/codexpool_settings.py', 'menubar/SPEC.md', 'lanes/bridge.py', 'launchd', 'examples', 'docs',
              'README.md', 'AGENTS.md', 'LICENSE', 'NOTICE')
MENUBAR_PACKAGES = ('pyobjc-core', 'pyobjc-framework-Cocoa')
VENV_PYTHON = '3.13'  # what uv creates the venv with (it downloads a standalone build if needed)
GO_RELEASES = 'https://go.dev/dl/?mode=json'


def tilde(path):
    s, h = str(path), str(HOME)
    return '~' + s[len(h):] if s == h or s.startswith(h + '/') else s


class Steps:
    """Prints the install plan while running it. In a dry run, change() only says what it would do."""
    TOTAL = 7

    def __init__(self, dry_run):
        self.dry = dry_run
        self.n = 0
        self.problems = []

    def step(self, title):
        self.n += 1
        print(f'\n[{self.n}/{self.TOTAL}] {title}')

    def ok(self, text):
        print(f'  ✓ {text}')

    def warn(self, text, fix=None):
        print(f'  ! {text}' + (f'\n      → {fix}' if fix else ''))

    def fail(self, text, fix=None):
        print(f'  ✗ {text}' + (f'\n      → {fix}' if fix else ''))
        self.problems.append(text)

    def change(self, text, fn=None, *args):
        print(f'  {"[dry-run] " if self.dry else "+ "}{text}')
        sys.stdout.flush()
        if not self.dry and fn is not None:
            return fn(*args)
        return None


def run_checked(argv, what, **kwargs):
    r = subprocess.run([str(a) for a in argv], capture_output=True, text=True, **kwargs)
    if r.returncode != 0:
        tail = ' '.join((r.stderr or r.stdout or '').split())[-300:]
        raise RuntimeError(f'{what} failed (exit {r.returncode}): {tail}')
    return r


NETWORK_HOSTS = ('go.dev', 'api.github.com', 'codeload.github.com', 'proxy.golang.org')  # what install downloads from


def network_error(host):
    """None if https://<host>/ answers (any HTTP status), else why not, in words."""
    req = urllib.request.Request(f'https://{host}/', method='HEAD', headers={'User-Agent': 'codexpool'})
    try:
        with urllib.request.urlopen(req, timeout=15):
            return None
    except urllib.error.HTTPError:
        return None  # the server answered
    except (urllib.error.URLError, OSError) as e:
        reason = getattr(e, 'reason', e)
        return f'{type(reason).__name__}: {reason}'


def python_version_ok(python):
    """'3.13.5' if `python` runs and is 3.11+ with tarfile's data filter, else None."""
    code = ('import sys, tarfile; print("%d.%d.%d" % sys.version_info[:3]); '
            'sys.exit(0 if sys.version_info >= (3, 11) and hasattr(tarfile, "data_filter") else 3)')
    try:
        r = subprocess.run([str(python), '-c', code], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return None
    return r.stdout.strip() if r.returncode == 0 else None


def python_has(python, module):
    try:
        return subprocess.run([str(python), '-c', f'import {module}'], capture_output=True, timeout=60).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def find_uv():
    for c in (shutil.which('uv'), HOME / '.local/bin/uv', HOME / '.cargo/bin/uv', '/opt/homebrew/bin/uv',
              '/usr/local/bin/uv'):
        if c and os.access(str(c), os.X_OK):
            return str(c)
    return None


def find_python():
    """A Python 3.11+ already on this Mac to build a venv from (the running one first)."""
    seen = set()
    names = ('python3.13', 'python3.12', 'python3.11', 'python3.14', 'python3')
    for c in [sys.executable] + [shutil.which(n) for n in names] + ['/opt/homebrew/bin/python3', '/usr/local/bin/python3']:
        if c and c not in seen and os.access(c, os.X_OK):
            seen.add(c)
            if python_version_ok(c):
                return c
    return None


def create_venv(python, how):
    env_dir = pathlib.Path(python).parent.parent
    tool, exe = how
    env_dir.parent.mkdir(parents=True, exist_ok=True)
    if tool == 'uv':
        run_checked([exe, 'venv', '--python', VENV_PYTHON, env_dir], f'uv venv {tilde(env_dir)}')
    else:
        run_checked([exe, '-m', 'venv', env_dir], f'{exe} -m venv {tilde(env_dir)}')
    if not python_version_ok(python):
        raise RuntimeError(f'{tilde(python)} was created but is not a usable Python 3.11+')


def pip_install(python, packages):
    uv = find_uv()
    if uv:
        run_checked([uv, 'pip', 'install', '--python', python] + list(packages), 'uv pip install ' + ' '.join(packages))
    else:
        run_checked([python, '-m', 'pip', 'install', '--quiet'] + list(packages), 'pip install ' + ' '.join(packages))


def code_files():
    """(source, destination) for each code file of this checkout, when it is not ROOT itself."""
    out = []
    for rel in CODE_FILES:
        src = CODE_DIR / rel
        if src.is_file():
            files = [src]
        elif src.is_dir():
            files = sorted(p for p in src.rglob('*') if p.is_file() and '__pycache__' not in p.parts)
        else:
            files = []
        out += [(f, ROOT / f.relative_to(CODE_DIR)) for f in files]
    return out


def copy_code():
    for src, dest in code_files():
        dest.parent.mkdir(parents=True, exist_ok=True)
        if not dest.exists() or dest.read_bytes() != src.read_bytes():
            shutil.copy2(src, dest)


def make_dirs():
    for d in (ROOT, STATE, LOGS):
        d.mkdir(parents=True, exist_ok=True)
    AUTH.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(AUTH, 0o700)  # seat logins: only you


def write_private(path, text):
    """Atomic write, mode 0600 (mkstemp's default)."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=path.name + '.', suffix='.tmp')
    try:
        with os.fdopen(fd, 'w') as f:
            f.write(text)
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


# -- install steps --------------------------------------------------------------------------------------

def install_preflight(st):
    st.step('Preflight')
    if platform.system() != 'Darwin':
        sys.exit('codexpool needs macOS (launchd, the Keychain, the AppKit menu bar); nothing was changed.')
    arch = platform.machine()
    st.ok(f'macOS {platform.mac_ver()[0] or "?"} on {arch}')
    if arch != 'arm64':
        st.warn('Intel Macs are untested')
    codex = codex_bin()
    if codex:
        st.ok(f'Codex: {tilde(codex)}')
    else:
        st.fail('Codex app not found', f'install the Codex app from OpenAI, or set "codex_bin" in {tilde(SETTINGS_FILE)}')

    codex_home = os.environ.get('CODEX_HOME')
    if codex_home and pathlib.Path(codex_home).expanduser().resolve() != CODEX_CONFIG.parent.resolve():
        st.warn(f'CODEX_HOME is set to {codex_home} in this shell; install configures {tilde(CODEX_CONFIG)}, which '
                'is what the Codex app reads', f'for the codex CLI in this shell, also add openai_base_url = '
                f'"{BASE}/v1" to {codex_home}/config.toml')

    venvs = []  # (python, how) to create
    checked = []
    for key, py in (('python', python_bin()), ('menubar_python', menubar_python_bin())):
        if py in checked:
            continue
        checked.append(py)
        version = python_version_ok(py)
        if version:
            st.ok(f'{key}: Python {version} ({tilde(py)})')
            continue
        where = f'"{key}" in {tilde(SETTINGS_FILE)}'
        if py.exists():
            fix = (f'delete {tilde(py.parent.parent)} and re-run' if not SETTINGS[key]
                   else f'point {where} at Python 3.11+, or set it to null for codexpool\'s own venv')
            st.fail(f'{tilde(py)} is not Python 3.11+', fix)
            continue
        if py.parent.name != 'bin' or py.parent.parent.exists():
            st.fail(f'{tilde(py)} does not exist',
                    f'fix {where}' if SETTINGS[key] else f'delete {tilde(py.parent.parent)} and re-run')
            continue
        uv = find_uv()
        base = None if uv else find_python()
        how = ('uv', uv) if uv else (('venv', base) if base else None)
        if not how:
            st.fail('no Python 3.11+ and no uv on this Mac',
                    'install uv (https://docs.astral.sh/uv/) or Python (brew install python@3.13), then re-run')
            continue
        st.ok(f'{key}: will be a new venv at {tilde(py.parent.parent)} '
              + (f'(uv, Python {VENV_PYTHON})' if how[0] == 'uv' else f'(from {tilde(how[1])})'))
        venvs.append((py, how))

    need_network = not (TOOLCHAIN / 'current' / 'bin' / 'go').exists() or not (CURRENT / 'cli-proxy-api').exists()
    errors = {h: e for h in NETWORK_HOSTS if (e := network_error(h))}
    if not errors:
        st.ok('network: ' + ', '.join(NETWORK_HOSTS) + ' answer')
    elif need_network:
        certs = any('CERTIFICATE_VERIFY_FAILED' in e or 'SSLCertVerification' in e for e in errors.values())
        st.fail('cannot reach ' + '; '.join(f'{h} ({short(e, 80)})' for h, e in errors.items()),
                'this Python cannot verify HTTPS certificates: run "Install Certificates.command" in '
                '/Applications/Python 3.x, or start the installer with Homebrew Python or uv' if certs else
                'install downloads Go (go.dev, proxy.golang.org) and the CLIProxyAPI source (github.com) once')
    else:
        st.ok('network: not reachable, but not needed (Go and a pool build are already here)')
    loaded, pid = launchd_loaded(POOL_JOB)
    if loaded:
        st.ok(f'{POOL_JOB} already loaded' + (f' (pid {pid})' if pid else ''))
    elif port_open(PORT):
        st.fail(f'something else is listening on 127.0.0.1:{PORT}',
                f'stop it (lsof -nP -iTCP:{PORT} -sTCP:LISTEN), or pick another port: ' +
                (f'set "port" in {tilde(SETTINGS_FILE)}' if SETTINGS_FILE.exists() else
                 f'mkdir -p {tilde(SETTINGS_FILE.parent)} && echo \'{{"port": {PORT + 10}}}\' > {tilde(SETTINGS_FILE)}'))
    else:
        st.ok(f'port {PORT} is free')

    if st.problems and not st.dry:
        sys.exit(f'\n{len(st.problems)} problem(s) above. Fix them and re-run codexpool install; nothing was changed.')

    if CODE_DIR != ROOT.resolve():
        files = code_files()
        st.change(f'copy the code ({len(files)} files) from {tilde(CODE_DIR)} to {tilde(ROOT)} '
                  '(re-run install from the checkout after a git pull to update it)', copy_code)
    if not SETTINGS_FILE.exists():
        st.change(f'write {tilde(SETTINGS_FILE)} with the defaults (launchd labels, port {PORT}, interpreters)',
                  write_json, SETTINGS_FILE, SETTINGS_DEFAULTS)
    if not AUTH.is_dir() or not STATE.is_dir() or not LOGS.is_dir():
        st.change(f'create {tilde(AUTH)} (mode 700), {tilde(STATE)}, {tilde(LOGS)}', make_dirs)
    for py, (tool, exe) in venvs:
        st.change(f'create the venv {tilde(py.parent.parent)} '
                  + (f'with uv (Python {VENV_PYTHON})' if tool == 'uv' else f'with {tilde(exe)} -m venv'),
                  create_venv, py, (tool, exe))
    if not st.dry and not python_ok_here() and os.environ.get('CODEXPOOL_REEXEC') != '1':
        py = python_bin()
        print(f'  + continuing under {tilde(py)}')
        sys.stdout.flush()
        os.environ['CODEXPOOL_REEXEC'] = '1'
        os.execv(str(py), [str(py), str(ROOT / 'bin' / 'codexpool')] + sys.argv[1:])


def go_release():
    req = urllib.request.Request(GO_RELEASES, headers={'User-Agent': 'codexpool'})
    with urllib.request.urlopen(req, timeout=30) as r:
        releases = json.loads(r.read())
    arch = 'arm64' if platform.machine() == 'arm64' else 'amd64'
    for rel in releases:
        if not rel.get('stable'):
            continue
        for f in rel.get('files') or []:
            if f.get('os') == 'darwin' and f.get('arch') == arch and f.get('kind') == 'archive':
                return rel['version'], f['filename'], f['sha256']
    raise ValueError(f'go.dev lists no stable darwin-{arch} archive')


def install_go(version, filename, sha256):
    TOOLCHAIN.mkdir(parents=True, exist_ok=True)
    work = pathlib.Path(tempfile.mkdtemp(prefix='.go-', dir=TOOLCHAIN))
    try:
        tgz = work / filename
        _download('https://go.dev/dl/' + filename, tgz)
        h = hashlib.sha256()
        with open(tgz, 'rb') as f:
            for chunk in iter(lambda: f.read(1 << 20), b''):
                h.update(chunk)
        if h.hexdigest() != sha256:
            raise RuntimeError(f'{filename}: sha256 {h.hexdigest()} does not match go.dev ({sha256}); nothing installed')
        run_checked(['/usr/bin/tar', '-xzf', tgz, '-C', work], f'unpacking {filename}')
        dest = TOOLCHAIN / version
        shutil.rmtree(dest, ignore_errors=True)
        os.replace(work / 'go', dest)
        link = TOOLCHAIN / '.current.tmp'
        with contextlib.suppress(FileNotFoundError):
            link.unlink()
        link.symlink_to(version)
        os.replace(link, TOOLCHAIN / 'current')
        (TOOLCHAIN / 'gopath').mkdir(exist_ok=True)
    finally:
        shutil.rmtree(work, ignore_errors=True)


def install_toolchain(st):
    st.step('Go toolchain (to build CLIProxyAPI from source)')
    go = TOOLCHAIN / 'current' / 'bin' / 'go'
    if os.access(go, os.X_OK):
        out = subprocess.run([str(go), 'version'], capture_output=True, text=True).stdout.split()
        st.ok(f'{out[2] if len(out) > 2 else "go"} in {tilde(TOOLCHAIN / "current")}')
        return
    try:
        version, filename, sha256 = go_release()
    except (urllib.error.URLError, OSError, ValueError, KeyError) as e:
        if not st.dry:
            raise RuntimeError(f'cannot read the Go release list from go.dev: {e}') from None
        st.change(f'download the latest stable Go from go.dev into {tilde(TOOLCHAIN)} (go.dev did not answer: {e})')
        return
    st.change(f'download {filename} from go.dev, check its sha256 ({sha256[:16]}…) and unpack it to '
              f'{tilde(TOOLCHAIN / version)} (toolchain/current)', install_go, version, filename, sha256)


def install_build(st):
    st.step('CLIProxyAPI with the origin gate')
    if (CURRENT / 'cli-proxy-api').exists():
        st.ok(f'bin/current → v{cpa_version()} (newer releases: codexpool upgrade latest)')
        return
    try:
        version = _github_json('releases/latest')['tag_name'].lstrip('v')
    except (urllib.error.URLError, OSError, ValueError, KeyError) as e:
        if not st.dry:
            raise RuntimeError(f'cannot ask GitHub for the latest CLIProxyAPI release: {e}') from None
        version = 'latest'
    gid = gate_id((CODE_DIR / 'build' / 'codexpool_gate.go').read_bytes())
    st.change(f'build CLIProxyAPI v{version} from its release source + build/codexpool_gate.go (gate {gid}), '
              'run the gate self-test on a scratch port, and point bin/current at it',
              lambda: _point_current(build(version)))


def keychain_has_key():
    """True, False (errSecItemNotFound only), or None when the Keychain does not answer or errs (locked, no GUI
    session). A locked Keychain must never read as "no key": install would mint a second one. Never reads the
    secret itself."""
    try:
        r = subprocess.run(['security', 'find-generic-password', '-s', KEYCHAIN_SERVICE],
                           capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return True if r.returncode == 0 else (False if r.returncode == 44 else None)


def store_key(key):
    # `security -i` reads the command from stdin, so the key never shows up in the process list.
    cmd = f'add-generic-password -U -a "{getpass.getuser()}" -s "{KEYCHAIN_SERVICE}" -w "{key}"\n'
    with contextlib.suppress(OSError, subprocess.SubprocessError):
        subprocess.run(['security', '-i'], input=cmd, capture_output=True, text=True, timeout=30)
    if keychain_has_key() is not True:
        raise RuntimeError(f'could not store the management key in the Keychain ({KEYCHAIN_SERVICE}); '
                           'unlock the login keychain and re-run')


SECRET_LINE = re.compile(r'(?m)^(\s*secret-key:).*$')


def render_config(key):
    text = (CODE_DIR / 'examples' / 'config.yaml').read_text()
    if not re.search(r'(?m)^port:', text) or not SECRET_LINE.search(text):
        raise RuntimeError('examples/config.yaml has no port: or secret-key: line')
    text = re.sub(r'(?m)^port:.*$', f'port: {PORT}', text, count=1).replace('127.0.0.1:8319', f'127.0.0.1:{PORT}')
    return SECRET_LINE.sub(lambda m: f'{m.group(1)} "{key}"  # hashed by CLIProxyAPI on first start; '
                                     f'plaintext in the Keychain ({KEYCHAIN_SERVICE})', text, count=1)


def new_key_and_config():
    key = secrets.token_hex(24)
    make_dirs()
    write_private(CONFIG, render_config(key))  # config first: a failed Keychain write then just re-runs
    store_key(key)


def config_from_keychain():
    make_dirs()
    write_private(CONFIG, render_config(mgmt_key()))


def rekey_config():
    key = secrets.token_hex(24)
    text = CONFIG.read_text()
    if not SECRET_LINE.search(text):
        raise RuntimeError(f'{tilde(CONFIG)} has no remote-management secret-key line')
    write_private(STATE / f'config.yaml.pre-rekey-{time.strftime("%Y%m%d-%H%M%S")}', text)  # mode 600
    write_private(CONFIG, SECRET_LINE.sub(lambda m: f'{m.group(1)} "{key}"', text, count=1))
    store_key(key)


def install_key_and_config(st):
    st.step('Management key and config.yaml')
    have_key = keychain_has_key()
    if have_key is None:
        raise RuntimeError('the Keychain did not answer (locked?); unlock it (security unlock-keychain) and re-run')
    if CONFIG.exists():
        m = re.search(r'(?m)^port:\s*(\d+)', CONFIG.read_text())
        if m and int(m.group(1)) != PORT:
            msg = f'{tilde(CONFIG)} listens on {m.group(1)} but settings.json says {PORT}'
            if not st.dry:
                raise RuntimeError(msg + '; make them match')
            st.fail(msg, 'make them match')
        if have_key:
            st.ok(f'management key in the Keychain ({KEYCHAIN_SERVICE}); {tilde(CONFIG)} present')
        else:
            st.change(f'mint a new management key into the Keychain ({KEYCHAIN_SERVICE}) and {tilde(CONFIG)} '
                      f'(the file keeps only a hash of the old one; a copy goes to {tilde(STATE)})', rekey_config)
        return
    if have_key:
        st.ok(f'a management key is already in the Keychain ({KEYCHAIN_SERVICE}); reusing it')
        st.change(f'write {tilde(CONFIG)} (mode 600) from examples/config.yaml with that key and port {PORT}',
                  config_from_keychain)
    else:
        st.change(f'mint a random management key into the Keychain ({KEYCHAIN_SERVICE}) and write {tilde(CONFIG)} '
                  f'(mode 600) from examples/config.yaml: loopback, port {PORT}, api-keys: [], fill-first, '
                  'session affinity 24h', new_key_and_config)


def agent_templates():
    """(label, template) of each launchd agent; the lane bridge only while lane apply has written its config."""
    return ((POOL_JOB, 'pool.plist.template'), (GUARD_JOB, 'guard.plist.template'),
            (MENUBAR_JOB, 'menubar.plist.template')) + \
        (((BRIDGE_JOB, 'bridge.plist.template'),) if BRIDGE_CONFIG.exists() else ())


def render_plist(label, template):
    text = (CODE_DIR / 'launchd' / template).read_text()
    values = {'LABEL': label, 'ROOT': str(ROOT), 'PYTHON': str(python_bin()),
              'MENUBAR_PYTHON': str(menubar_python_bin())}
    for key, value in values.items():
        text = text.replace('{{' + key + '}}', xml_escape(value))
    left = re.search(r'\{\{[A-Z_]+\}\}', text)
    if left:
        raise RuntimeError(f'launchd/{template}: unknown placeholder {left.group(0)}')
    return text


def load_agent(label, plist, text, replace):
    LAUNCH_AGENTS.mkdir(parents=True, exist_ok=True)
    plist.write_text(text)
    if replace and launchd_loaded(label)[0]:
        subprocess.run(['launchctl', 'bootout', f'gui/{UID}/{label}'], capture_output=True)
        deadline = time.time() + 10
        while time.time() < deadline and launchd_loaded(label)[0]:
            time.sleep(0.3)
    if launchd_loaded(label)[0]:
        return
    r = subprocess.run(['launchctl', 'bootstrap', f'gui/{UID}', str(plist)], capture_output=True, text=True)
    if r.returncode != 0 and not launchd_loaded(label)[0]:
        raise RuntimeError(f'launchctl bootstrap {label} failed: {(r.stderr or "").strip()[-200:]}')


def remember_agents():
    rec = read_json(INSTALL_FILE, {})
    rec['agents'] = sorted(set(rec.get('agents') or []) | {label for label, _ in agent_templates()})
    if BRIDGE_CONFIG.exists():
        rec['bridge_fingerprint'] = bridge_fingerprint()  # the bridge now runs these files
    write_json(INSTALL_FILE, rec)


def install_agents(st):
    st.step('launchd agents (pool, guard, menu bar' + (', lane bridge)' if BRIDGE_CONFIG.exists() else ')'))
    menubar_ok = True
    mb = menubar_python_bin()
    if python_has(mb, 'AppKit'):
        st.ok(f'PyObjC available to {tilde(mb)}')
    else:
        try:
            st.change(f'install {" and ".join(MENUBAR_PACKAGES)} into {tilde(mb)} (for the menu bar app)',
                      pip_install, mb, MENUBAR_PACKAGES)
        except RuntimeError as e:
            menubar_ok = False
            st.warn(f'menu bar app skipped: {e}', 'fix it, then re-run codexpool install (the pool works without it)')
    for label, template in agent_templates():
        if label == MENUBAR_JOB and not menubar_ok:
            continue
        plist = LAUNCH_AGENTS / f'{label}.plist'
        text = render_plist(label, template)
        current = plist.read_text() if plist.exists() else None
        loaded, pid = launchd_loaded(label)
        if current == text and loaded:
            if label == BRIDGE_JOB and read_json(INSTALL_FILE, {}).get('bridge_fingerprint') != bridge_fingerprint():
                st.change(f'{label} loaded; restart it (its code, bridge.json or a key changed)', kick_agent, label)
                continue
            st.ok(f'{label} loaded' + (f' (pid {pid})' if pid else ''))
            continue
        what = (f'write {tilde(plist)} from launchd/{template}' if current is None else
                f'update {tilde(plist)} from launchd/{template}' if current != text else f'{tilde(plist)} is current')
        st.change(f'{what}; load it (launchctl bootstrap gui/{UID})', load_agent, label, plist, text,
                  current is not None and current != text)
        if label == POOL_JOB and not st.dry and not wait_healthy(30):
            raise RuntimeError(f'the pool did not answer on 127.0.0.1:{PORT} within 30 s; see: codexpool logs')
    if not st.dry:
        remember_agents()


def set_codex_key(key, value, cfg=CODEX_CONFIG):
    if not cfg.exists():
        cfg.parent.mkdir(parents=True, exist_ok=True)
        cfg.touch(mode=0o600)
    set_toml_top_level(key, value, cfg)


def remove_codex_key(key, cfg=CODEX_CONFIG):
    """--fix-config: remove a key and record that install removed it, so uninstall puts back only that."""
    set_codex_key(key, None, cfg)
    rec = read_json(INSTALL_FILE, {})
    rec['removed'] = sorted(set(rec.get('removed') or []) | {key})
    write_json(INSTALL_FILE, rec)


def record_codex_config(cfg, top, existed):
    """Once, before the first change: back up config.toml and record the keys install may touch."""
    ours = f'{BASE}/v1'
    original = {}
    for key in CODEX_KEYS:
        value = top.get(key)
        original[key] = None if key == 'openai_base_url' and unquote(value) == ours else value
    STATE.mkdir(parents=True, exist_ok=True)
    backup = STATE / CODEX_BACKUP.format(stamp=time.strftime('%Y%m%d-%H%M%S'))
    if existed:
        shutil.copyfile(cfg, backup)
        os.chmod(backup, 0o600)
    else:
        cfg.parent.mkdir(parents=True, exist_ok=True)
        cfg.touch(mode=0o600)
    rec = read_json(INSTALL_FILE, {})
    rec.update({'installed_at': now_utc().isoformat(), 'codex_config': str(cfg), 'created_config': not existed,
                'backup': str(backup) if existed else None, 'original': original, 'removed': []})
    write_json(INSTALL_FILE, rec)


def install_codex_config(st, fix):
    st.step('Codex config')
    cfg = CODEX_CONFIG
    existed = cfg.exists()
    top = toml_top_level(cfg) if existed else {}
    ours = f'{BASE}/v1'
    if isinstance(read_json(INSTALL_FILE, {}).get('original'), dict):
        st.ok(f'the original Codex settings are recorded in {tilde(INSTALL_FILE)}')
    elif existed:
        st.change(f'back up {tilde(cfg)} to {tilde(STATE / CODEX_BACKUP.format(stamp="<time>"))} and record its '
                  f'{", ".join(CODEX_KEYS)} in '
                  f'{tilde(INSTALL_FILE)} (uninstall puts them back)', record_codex_config, cfg, top, existed)
    else:
        st.change(f'create {tilde(cfg)} (it does not exist yet)', record_codex_config, cfg, top, existed)
    if unquote(top.get('openai_base_url')) == ours:
        st.ok(f'openai_base_url = "{ours}"')
    else:
        was = f' (was {top["openai_base_url"]})' if top.get('openai_base_url') else ''
        st.change(f'set openai_base_url = "{ours}" in {tilde(cfg)}{was}', set_codex_key, 'openai_base_url',
                  f'"{ours}"', cfg)
    for key, why in CONFIG_WARNINGS.items():
        if key not in top:
            continue
        if fix:
            st.change(f'remove {key} from {tilde(cfg)} ({why}; uninstall puts it back)', remove_codex_key, key, cfg)
        else:
            st.warn(f'{key} is set in {tilde(cfg)}: {why}',
                    'remove it, or re-run with --fix-config (uninstall puts it back)')


def wrapper_text():
    return (f'#!/bin/sh\n{WRAPPER_MARK}\n'
            f'exec {shlex.quote(str(python_bin()))} {shlex.quote(str(ROOT / "bin" / "codexpool"))} "$@"\n')


def wrapper_is_ours():
    if WRAPPER.is_symlink():
        try:
            return WRAPPER.resolve() == (ROOT / 'bin' / 'codexpool').resolve()
        except OSError:
            return False
    try:
        return WRAPPER_MARK in WRAPPER.read_text()
    except (OSError, UnicodeDecodeError):
        return False


def write_wrapper():
    WRAPPER.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=WRAPPER.parent, prefix='.codexpool.', suffix='.tmp')
    with os.fdopen(fd, 'w') as f:
        f.write(wrapper_text())
    os.chmod(tmp, 0o755)
    os.replace(tmp, WRAPPER)


def install_command(st):
    st.step('The codexpool command and a health check')
    how = f'runs bin/codexpool with {tilde(python_bin())}'
    if not (WRAPPER.exists() or WRAPPER.is_symlink()):
        st.change(f'write {tilde(WRAPPER)} ({how})', write_wrapper)
    elif not wrapper_is_ours():
        st.warn(f'{tilde(WRAPPER)} exists and is not codexpool\'s; left alone',
                f'remove it and re-run, or use {tilde(ROOT / "bin" / "codexpool")}')
    elif not WRAPPER.is_symlink() and WRAPPER.read_text() == wrapper_text():
        st.ok(f'{tilde(WRAPPER)}')
    else:  # a symlink of ours runs whatever python3 is first on PATH (under launchd: the system one)
        st.change(f'{"replace the symlink" if WRAPPER.is_symlink() else "update"} {tilde(WRAPPER)} ({how})',
                  write_wrapper)
    if str(WRAPPER.parent) not in os.environ.get('PATH', '').split(os.pathsep):
        st.warn(f'{tilde(WRAPPER.parent)} is not on your PATH',
                'echo \'export PATH="$HOME/.local/bin:$PATH"\' >> ~/.zshrc, then open a new terminal')
    me = [str(python_bin()), str(ROOT / 'bin' / 'codexpool')]

    def check():
        subprocess.run(me + ['guard'])
        print()
        subprocess.run(me + ['doctor'])
    st.change('run one guard pass, then codexpool doctor (no seats yet is expected on a fresh install)', check)


def headline_upgrade_note():
    """A note for the install that upgrades from a codexpool without the headline and display settings, when
    settings.json sets neither: the menu bar's number changes meaning, from % used of the regular seats to % left
    of all seats. That install is the one whose installed code, or whose guard's last status.json, predates them.
    Evaluated before the code is copied; the answer survives install's re-exec under another Python."""
    if os.environ.get('CODEXPOOL_HEADLINE_NOTE') != '1':
        raw = read_json(SETTINGS_FILE, None)
        if not isinstance(raw, dict) or 'headline' in raw or 'display' in raw:
            return None
        installed = ROOT / 'bin' / 'codexpool'
        try:
            old_code = CODE_DIR != ROOT.resolve() and 'used_pct_regular' not in installed.read_text()
        except OSError:
            old_code = False   # nothing installed yet: a first install, nothing changes meaning
        status = read_json(STATUS_FILE, {})
        pool = status.get('pool') if isinstance(status, dict) else None
        if not old_code and not (isinstance(pool, dict) and 'headline' not in pool):
            return None
        os.environ['CODEXPOOL_HEADLINE_NOTE'] = '1'
    return ('The menu bar now shows % left across all seats. For the old number (% used of the regular seats),\n'
            f'set "display": "used" and "headline": "regular" in {tilde(SETTINGS_FILE)}.\n'
            f'Restart the menu bar app to see the change: launchctl kickstart -k gui/$(id -u)/{MENUBAR_JOB}')


def cmd_install(args):
    """Set up everything, or repair it. Every step checks first and changes only what is missing or wrong."""
    note = headline_upgrade_note()
    st = Steps(args.dry_run)
    print(f'codexpool install{" --dry-run: nothing is changed; each step says what it would do" if st.dry else ""}'
          f'\n  home {tilde(ROOT)} · settings {tilde(SETTINGS_FILE)} · port {PORT} · '
          f'launchd {", ".join(label for label, _ in agent_templates())}')
    try:
        install_preflight(st)
        install_toolchain(st)
        install_build(st)
        install_key_and_config(st)
        install_agents(st)
        install_codex_config(st, args.fix_config)
        install_command(st)
    except RuntimeError as e:
        sys.exit(f'\ninstall stopped: {e}\nFix that and re-run codexpool install; every step is safe to repeat.')
    if st.dry:
        print('\nDry run: nothing was changed.'
              + (f' The {len(st.problems)} problem(s) marked ✗ would stop a real install.' if st.problems else '')
              + (f'\n\n{note}' if note else ''))
        sys.exit(1 if st.problems else 0)
    seat_files = list((ROOT / 'auth').glob('codex-*.json')) if (ROOT / 'auth').is_dir() else []
    if seat_files:
        print(f'\nUp to date: {len(seat_files)} seat(s) in the pool. codexpool status shows them; codexpool doctor checks '
              f'everything.\nDocs: {tilde(ROOT / "README.md")} or {REPO_URL}')
        if note:
            print(f'\n{note}')
        return
    if os.environ.get('CODEXPOOL_VIA_INSTALLER') == '1':  # install.sh prints the next steps itself, after this
        print('\nInstalled. The doctor check above lists 0 seats as a problem until you add one, and Codex requests\n'
              'fail until then. The installer shows the next steps below.')
        if note:
            print(f'\n{note}')
        return
    print('\nInstalled. The doctor check above lists 0 seats as a problem until you add one, and Codex requests\n'
          'fail until then (codexpool uninstall --yes undoes the install). codexpool setup walks you through the\n'
          'next steps; by hand:\n'
          '  1. Add each seat (browser sign-in; pick the workspace):  codexpool login "<Label>" --priority <n>\n'
          '     Higher priority is used first. For an account your browser is not signed in to, add --no-open\n'
          '     and open the printed link in a private window.\n'
          '  2. Quit the Codex app fully (Cmd-Q) and reopen it, so it picks up openai_base_url.\n'
          '  3. Optional: codexpool weight "<Label>" <n> (Plus = 1, Pro = 20), codexpool reserve "<Label>".\n'
          '  Then: send Codex a prompt and check codexpool status (the top seat shows active) or the menu bar item.\n'
          f'Docs: {tilde(ROOT / "README.md")} or {REPO_URL}')
    if note:
        print(f'\n{note}')


def cmd_uninstall(args):
    """Stop the agents and restore the Codex config keys recorded at install. Seats, config and data stay."""
    rec = read_json(INSTALL_FILE, {})
    original = rec.get('original') if isinstance(rec.get('original'), dict) else None
    removed = set(rec.get('removed') or [])  # what --fix-config took out; keys you removed yourself stay out
    cfg = pathlib.Path(rec.get('codex_config') or CODEX_CONFIG)
    top = toml_top_level(cfg)
    ours = f'{BASE}/v1'
    restores = []  # (key, TOML literal or None)
    if original is not None:
        for key, value in original.items():
            if key == 'openai_base_url':
                if unquote(top.get(key)) == ours:  # still ours; if you changed it since, leave it
                    restores.append((key, value))
            elif value is not None and key in removed and key not in top:
                restores.append((key, value))
    elif unquote(top.get('openai_base_url')) == ours:
        restores.append(('openai_base_url', None))
    bridge = {BRIDGE_JOB} if (LAUNCH_AGENTS / f'{BRIDGE_JOB}.plist').exists() else set()
    agents = sorted(set(rec.get('agents') or []) | {POOL_JOB, GUARD_JOB, MENUBAR_JOB} | bridge,
                    key=lambda j: (j == POOL_JOB, j))  # the pool last: the guard must not see it vanish
    plan = [f'stop the launchd agents {", ".join(agents)} and delete their plists from {tilde(LAUNCH_AGENTS)}']
    roles = lane_leftovers()
    roles_step = f'delete the generated lane role files {", ".join(tilde(p) for p in roles)}'
    if roles:
        plan.append(roles_step)
    lanes_block = agents_md_has_lanes()
    agents_step = f'remove the codexpool lanes block from {tilde(CODEX_AGENTS_MD)}'
    if lanes_block:
        plan.append(agents_step)
    if restores:
        plan.append(f'in {tilde(cfg)}: ' + '; '.join(f'remove {k}' if v is None else f'set {k} = {v} (as before install)'
                                                    for k, v in restores))
    else:
        plan.append(f'leave {tilde(cfg)} as it is (nothing of codexpool\'s left in it)')
    if wrapper_is_ours():
        plan.append(f'remove {tilde(WRAPPER)}')
    plan.append(f'keep {tilde(ROOT)}: seat logins, config.yaml, lanes.json, lanes/ and lane keys, history and builds '
                '(codexpool install brings it all back)')
    if not args.yes:
        print('Uninstall would:\n' + '\n'.join(f'  {i + 1}. {p}' for i, p in enumerate(plan))
              + '\nthen you quit and reopen the Codex app.\nRe-run with --yes.')
        return
    for job in agents:
        subprocess.run(['launchctl', 'bootout', f'gui/{UID}/{job}'], capture_output=True)
        with contextlib.suppress(FileNotFoundError):
            (LAUNCH_AGENTS / f'{job}.plist').unlink()
    if cfg.exists():
        for key, value in restores:
            set_toml_top_level(key, value, cfg)
        if rec.get('created_config') and not cfg.read_text().strip():
            cfg.unlink()
    if wrapper_is_ours():
        WRAPPER.unlink()
    failed = {}  # plan step -> why it did not happen
    stuck = []
    for path in roles:
        try:
            path.unlink()
        except FileNotFoundError:
            pass
        except OSError as e:
            stuck.append(f'{tilde(path)}: {e.strerror or e}')
    if stuck:
        failed[roles_step] = 'not deleted: ' + '; '.join(stuck)
    if lanes_block:
        try:
            remove_agents_md_lanes()
        except (LaneError, OSError) as e:
            failed[agents_step] = f'{e}; the lanes block stays'
    if INSTALL_FILE.exists():
        os.replace(INSTALL_FILE, STATE / f'install.json.uninstalled-{int(time.time())}')
    print('\n'.join(f'  ✗ {p} ({failed[p]})' if p in failed else f'  ✓ {p}' for p in plan))
    print(f'\nUninstalled. Quit and reopen the Codex app; it now talks to OpenAI directly.\n'
          f'To remove everything: rm -rf {tilde(ROOT)} && security delete-generic-password -s {KEYCHAIN_SERVICE}\n'
          '(this does not sign the seats out; do that at chatgpt.com if you want to).')


# ---------------------------------------------------------------- lanes

# A lane is a named third-party model tier that the Codex main agent spawns as a native subagent (agent_type
# "<lane>"). The pool serves the lane alias from an ordered list of members: the first while it is available, then
# the next. `codexpool lane apply` turns lanes.json into a config.yaml block, the bridge config, Codex role files and
# an AGENTS.md block; docs/LANES.md explains each piece. Lane text names models; nothing else in codexpool does.
LANE_NAME_OK = re.compile(r'^[a-z][a-z0-9-]{0,30}$')
MEMBER_ID_OK = re.compile(r'^[a-z0-9]{1,16}$')
MODEL_ID_OK = re.compile(r'^[A-Za-z0-9._:/-]+$')
KEY_NAME_OK = re.compile(r'^[a-z0-9][a-z0-9-]{0,63}$')
HEADER_OK = re.compile(r'^[A-Za-z0-9-]{1,64}$')
HTTPS_OK = re.compile(r'^https://[A-Za-z0-9.-]+(:\d+)?(/[A-Za-z0-9._~:/%+-]*)?$')
LANE_EFFORTS = ('low', 'medium', 'high', 'xhigh')
LANE_KEYS = ('role', 'effort', 'members')
MEMBER_KEYS = ('id', 'provider', 'model', 'name', 'context', 'base_url', 'session_header')
LANE_CONTEXT = 272000  # a member's context window when neither lanes.json nor the pool gives one
LANE_ROLE_DEFAULT = ('Token-heavy work that does not need the most capable model: codebase sweeps, bulk edits, log '
                     'and data digging, first drafts, second opinions.')
# How each provider is reached. xai is native to the pool (OAuth: codexpool lane login xai). The others go through
# the local bridge, which holds their key in lanes/secrets/<key>.key (a responses member's key is <lane>-<id>).
LANE_PROVIDERS = {
    'xai': {'kind': 'xai'},
    'opencode-go': {'kind': 'bridge', 'base_url': 'https://opencode.ai/zen/go/v1',
                    'session_header': 'x-opencode-session', 'key': 'opencode-go'},
    'opencode-zen': {'kind': 'bridge', 'base_url': 'https://opencode.ai/zen/v1',
                     'session_header': 'x-opencode-session', 'key': 'opencode-zen'},
    'responses': {'kind': 'bridge', 'base_url': None, 'session_header': None, 'key': None},
}
CATALOG_KEYS = {p['key'] for p in LANE_PROVIDERS.values() if p.get('key')}  # a responses member's key must differ
LANES_BEGIN = ('# >>> codexpool lanes (generated by `codexpool lane apply` from lanes.json; edit lanes.json, not this '
               'block) >>>')
LANES_END = '# <<< codexpool lanes <<<'
XAI_BEGIN = '# >>> codexpool lanes (xai): only the lane models are offered >>>'  # indented under oauth-excluded-models
XAI_END = '# <<< codexpool lanes (xai) <<<'
XAI_BEGIN_RE = re.compile(r'^\s+# >>> codexpool lanes \(xai\)')
XAI_END_RE = re.compile(r'^\s+# <<< codexpool lanes \(xai\) <<<')
EXCLUDED_KEY = re.compile(r'^(["\']?)oauth-excluded-models\1\s*:(.*)$')  # plain or quoted, at column 0
FLOAT_FIELDS = ('yield_time_ms', 'max_output_tokens', 'session_id', 'timeout_ms')  # integers Codex rejects as 30000.0
# A YAML key whose value may be key material (api-key, secret-key, api-keys, Authorization, *token*, ...), plain or
# quoted, block or flow style. lane apply --dry-run hides such values before it prints a config.yaml diff.
SECRET_KEY = re.compile(r'''(?i)(?<![\w.-])(["']?)[\w.-]*(?:key|secret|token|passw|authorization|bearer|credential)'''
                        r'''[\w.-]*\1\s*:(?=\s|$)''')
MAPPING_ITEM = re.compile(r'''^(["']?)[\w.-]+\1\s*:(\s|$)''')  # a "key: value" line, not a scalar
CLOSED_QUOTE = re.compile(r'''^(?:"(?:[^"\\]|\\.)*"|'(?:[^']|'')*')\s*(?:#.*)?$''')
FLOW_VALUE = re.compile(r'''\s*(?:"(?:[^"\\]|\\.)*"?|'(?:[^']|'')*'?|[^,}\]]*)''')
ROLE_MARK = '# Generated by codexpool'
ROLE_HEADER = f'{ROLE_MARK} (`codexpool lane apply`) from ~/.codexpool/lanes.json. Edit the lane there, not this file.'
ROLE_INSTRUCTIONS = '''\
You are a subagent running on a third-party model reached through codexpool. Do only the assigned task.
Run commands with the shell tool. Edit files by running apply_patch through the shell:
apply_patch <<'EOF'
*** Begin Patch
*** Update File: path/to/file
@@
-old line
+new line
*** End Patch
EOF
To create a file use "*** Add File: path/to/file" followed directly by the content lines, each prefixed by "+" (no \
@@ line in an Add File section). There is no separate apply_patch tool.
Do not spawn subagents. Finish with a short report: files changed, commands run and their results, anything uncertain.
'''
AGENTS_BEGIN = ('<!-- codexpool:lanes BEGIN (generated by codexpool; edit ~/.codexpool/lanes.json, not this block) '
                '-->')
AGENTS_END = '<!-- codexpool:lanes END -->'
TEST_ROLE_PREFIX = 'zz-codexpool-test-'
LANE_TEST_TASK = ('change the word alpha in a.txt to beta using apply_patch, create c.txt containing the line lane-ok '
                  'using apply_patch, then run cat a.txt c.txt and report the output.')
LANE_COMPACTION_TASK = ('read big1.txt through big8.txt one at a time, with a separate cat command for each file, and '
                        'after each file state the MARKER line it contains. Then create notes.txt with apply_patch, '
                        'containing the 8 markers in order, one per line, and reply with them.')


class LaneError(Exception):
    """lanes.json, or a file lane apply must change, is not as expected; .problems lists every reason."""

    def __init__(self, problems):
        self.problems = [problems] if isinstance(problems, str) else list(problems)
        super().__init__('; '.join(self.problems))


def plain_text(value):
    """A non-empty string without control characters: it lands in YAML, TOML and Markdown on one line."""
    return isinstance(value, str) and bool(value.strip()) and \
        not any(unicodedata.category(c) in ('Cc', 'Cs') for c in value)


def sentence(text):
    text = text.strip()
    return text if text[-1:] in '.!?' else text + '.'


def default_member_id(model, taken):
    """The first -/.-separated token of the model id, lowercased; a digit is added when another member has it."""
    base = re.sub(r'[^a-z0-9]', '', re.split(r'[-.]', model)[0].lower())[:16] or 'm'
    mid, n = base, 1
    while mid in taken:
        n += 1
        mid = base[:16 - len(str(n))] + str(n)
    return mid


def validate_lanes(raw):
    """The lanes of a parsed lanes.json, checked and completed with defaults (pure). Raises LaneError listing every
    problem, each starting with "lanes.json: ". Keys starting with _ are ignored at every level."""
    def fail(problems):
        raise LaneError([f'lanes.json: {p}' for p in problems])
    if not isinstance(raw, dict):
        fail(['must hold a JSON object like {"lanes": {...}} (see examples/lanes.json)'])
    errors = [f'unknown key "{k}" (known: lanes; keys starting with _ are ignored)' for k in raw
              if k != 'lanes' and not str(k).startswith('_')]
    body = raw.get('lanes', {})
    if not isinstance(body, dict):
        fail(errors + ['"lanes" must be an object: {"<lane name>": {"role": ..., "members": [...]}}'])
    lanes = []
    for name, spec in body.items():
        if name.startswith('_'):
            continue
        where = f'lane "{name}"'
        if not LANE_NAME_OK.match(name) or name == 'default' or name.startswith(TEST_ROLE_PREFIX):
            errors.append(f'{where}: a lane name is lowercase letters, digits and -, starts with a letter, has at most '
                          f'31 characters, is not "default" and does not start with "{TEST_ROLE_PREFIX}" (lane test '
                          'uses those role names)')
        if not isinstance(spec, dict):
            errors.append(f'{where} must be an object with "role", "effort" and "members"')
            continue
        errors += [f'{where}: unknown key "{k}" (known: {", ".join(LANE_KEYS)})' for k in spec
                   if k not in LANE_KEYS and not str(k).startswith('_')]
        role, effort, members = spec.get('role'), spec.get('effort', 'xhigh'), spec.get('members')
        if not plain_text(role) or '<!--' in role or '-->' in role:
            errors.append(f'{where}: "role" must be a non-empty one-line string (no <!-- -->): what the lane is for')
        if effort not in LANE_EFFORTS:
            errors.append(f'{where}: effort {json.dumps(effort)} is not one of: {", ".join(LANE_EFFORTS)}')
        if not isinstance(members, list) or not members:
            errors.append(f'{where}: "members" must be a non-empty list, in fill order')
            continue
        explicit = {m['id'] for m in members if isinstance(m, dict) and isinstance(m.get('id'), str)}
        taken, out, xai = set(), [], 0
        for i, m in enumerate(members, 1):
            if not isinstance(m, dict):
                errors.append(f'{where} member {i} must be an object with "provider" and "model"')
                continue
            provider, model = m.get('provider'), m.get('model')
            if 'id' in m:
                mid = m['id']
                if not isinstance(mid, str) or not MEMBER_ID_OK.match(mid):
                    errors.append(f'{where} member {i}: "id" must be 1 to 16 lowercase letters or digits')
                elif mid in taken:
                    errors.append(f'{where} member {i}: id "{mid}" is used twice in this lane')
            else:
                mid = default_member_id(model if isinstance(model, str) else '', taken | explicit)
            taken.add(mid if isinstance(mid, str) else '')
            at = f'{where} member {i} ({mid})'
            errors += [f'{at}: unknown key "{k}" (known: {", ".join(MEMBER_KEYS)})' for k in m
                       if k not in MEMBER_KEYS and not str(k).startswith('_')]
            if not isinstance(provider, str) or provider not in LANE_PROVIDERS:
                errors.append(f'{at}: provider {json.dumps(provider)} is not one of: {", ".join(LANE_PROVIDERS)}')
                provider = None
            if not isinstance(model, str) or not MODEL_ID_OK.match(model):
                errors.append(f'{at}: "model" must be the provider\'s model id (letters, digits and . _ : / -)')
            if 'name' in m and (not plain_text(m['name']) or '<!--' in m['name'] or '-->' in m['name']):
                errors.append(f'{at}: "name" must be a non-empty one-line string (the display name; no <!-- -->)')
            context = m.get('context')
            if context is not None and (isinstance(context, bool) or not isinstance(context, int) or context <= 0):
                errors.append(f'{at}: "context" must be a positive whole number of tokens')
            if provider == 'responses':
                if not isinstance(m.get('base_url'), str) or not HTTPS_OK.match(m['base_url']):
                    errors.append(f'{at}: a responses member needs "base_url", the https:// base URL of an OpenAI '
                                  'Responses API (the bridge POSTs <base_url>/responses)')
                header = m.get('session_header')
                if header is not None and (not isinstance(header, str) or not HEADER_OK.match(header)):
                    errors.append(f'{at}: "session_header" must be an HTTP header name, or null')
            else:
                errors += [f'{at}: "{k}" is only for responses members ({provider} has its own)'
                           for k in ('base_url', 'session_header') if k in m]
            xai += provider == 'xai'
            p = LANE_PROVIDERS.get(provider) or {}
            entry = {'id': mid, 'provider': provider, 'kind': p.get('kind'), 'model': model,
                     'name': m.get('name') or model, 'context': context}
            if p.get('kind') == 'bridge':
                own = provider == 'responses'
                entry.update(upstream_url=m.get('base_url') if own else p['base_url'],
                             session_header=m.get('session_header') if own else p['session_header'],
                             key_name=f'{name}-{mid}' if own else p['key'])
                if own and entry['key_name'] in CATALOG_KEYS:
                    errors.append(f'{at}: a responses member\'s key is named <lane>-<id>, and "{entry["key_name"]}" is '
                                  f'the {entry["key_name"]} provider\'s key, which would go to {m.get("base_url")}; '
                                  'give this member another "id"')
            out.append(entry)
        if xai > 1:
            errors.append(f'{where}: at most one xai member per lane (the pool has one xAI credential to fall back from)')
        lanes.append({'name': name, 'role': role, 'effort': effort, 'members': out})
    owners = {}  # every model name the lanes give the pool: each lane name and each <lane>-<id>
    for lane in lanes:
        owners.setdefault(lane['name'], {})[f'lane "{lane["name"]}"'] = None
        for m in lane['members']:  # an id used twice in one lane is reported above
            owners.setdefault(f'{lane["name"]}-{m["id"]}', {})[f'lane "{lane["name"]}" member {m["id"]}'] = None
    errors += [f'the model name "{alias}" would mean both {" and ".join(who)}; rename a lane or set another member '
               '"id" (each lane name and each <lane>-<id> must be unique)'
               for alias, who in owners.items() if len(who) > 1]
    if errors:
        fail(errors)
    return lanes


def read_lanes_raw():
    """The parsed lanes.json, or None when there is none."""
    try:
        return json.loads(LANES_FILE.read_text())
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as e:
        raise LaneError(f'lanes.json: cannot read {tilde(LANES_FILE)}: {e}') from None


def load_lanes():
    """The validated lanes of lanes.json, [] when there is no file. A broken file raises LaneError."""
    raw = read_lanes_raw()
    return [] if raw is None else validate_lanes(raw)


def dump_lanes(raw):
    """lanes.json text in the style of examples/lanes.json: two-space indent, one line per member."""
    def lane_text(lane):
        if not isinstance(lane, dict) or not lane:
            return json.dumps(lane, ensure_ascii=False)
        items = []
        for k, v in lane.items():
            if k == 'members' and isinstance(v, list) and v:
                inner = ',\n'.join('        ' + json.dumps(m, ensure_ascii=False) for m in v)
                items.append(f'      "members": [\n{inner}\n      ]')
            else:
                items.append(f'      {json.dumps(k)}: {json.dumps(v, ensure_ascii=False)}')
        return '{\n' + ',\n'.join(items) + '\n    }'
    parts = []
    for k, v in raw.items():
        if k == 'lanes' and isinstance(v, dict) and v:
            inner = ',\n'.join(f'    {json.dumps(n)}: {lane_text(lane)}' for n, lane in v.items())
            parts.append(f'  "lanes": {{\n{inner}\n  }}')
        else:
            parts.append(f'  {json.dumps(k)}: {json.dumps(v, ensure_ascii=False)}')
    return '{\n' + ',\n'.join(parts) + '\n}\n'


def lane_plan(lanes, xai_contexts=None, with_members=False):
    """The lanes with everything the generated files derive from them (pure): member aliases (<lane>-<id>), bridge
    model ids (lane-<lane>-<id>) and base URLs, display names, context windows and pool priorities.

    with_members: also offer each member under its own alias. Only lane test turns this on (it pins members through
    them); otherwise the Codex model picker would list every member next to the lane.

    A member's context comes from lanes.json, else (xAI) from the pool's model list, else LANE_CONTEXT; a lane's is
    the smallest of its members'. Fill order: the xAI credential keeps its own priority (0), so bridge members
    listed before it get 10, 20, ... and those after it -10, -20, ...; without an xAI member they count down from
    10 * the number of members."""
    plan = []
    for lane in lanes:
        name, members = lane['name'], lane['members']
        cap = name[:1].upper() + name[1:]
        x = next((i for i, m in enumerate(members) if m['kind'] == 'xai'), None)
        out = []
        for i, m in enumerate(members):
            e = dict(m, alias=f'{name}-{m["id"]}', display=f'{cap} lane: {m["name"]} only')
            if m['kind'] == 'xai':
                known = m['context'] or (xai_contexts or {}).get(m['model'])
                e['context'], e['context_known'] = known or LANE_CONTEXT, bool(known)
            else:
                e['context'], e['context_known'] = m['context'] or LANE_CONTEXT, True
                e['bridge_model'] = f'lane-{name}-{m["id"]}'
                e['base_url'] = f'http://127.0.0.1:{BRIDGE_PORT}/lane/{name}/{m["id"]}/v1'
                e['priority'] = 10 * (x - i) if x is not None else 10 * (len(members) - i)
            out.append(e)
        plan.append(dict(lane, members=out, context=min(m['context'] for m in out), member_aliases=bool(with_members),
                         display=f'{cap} lane ({", then ".join(m["name"] for m in members)})'))
    return plan


def member_aliases(lane):
    """The member aliases a planned lane offers: all of them while lane test runs, else none."""
    return [m['alias'] for m in lane['members']] if lane.get('member_aliases') else []


def lane_aliases(plan):
    """Every model name the lanes add to the pool: each lane alias, then its member aliases (if offered)."""
    return [a for lane in plan for a in [lane['name']] + member_aliases(lane)]


def yq(value):
    """A YAML double-quoted scalar (JSON's string syntax is valid YAML; text was checked for control characters)."""
    return json.dumps(value, ensure_ascii=False)


def _yaml_models(names, protocol):
    return '[ ' + ', '.join(f'{{ name: {yq(n)}, protocol: {yq(protocol)} }}' for n in names) + ' ]'


def render_lanes_block(plan, bridge_key, xai_hidden=None):
    """The config.yaml lanes block for a lane plan (pure; '' without lanes). xai_hidden: xAI model ids to hide inside
    the block, used when config.yaml has no top-level oauth-excluded-models: of its own."""
    if not plan:
        return ''
    out = [LANES_BEGIN]
    if xai_hidden:
        out += ['oauth-excluded-models:', '  # Only the lane models are offered from xAI.', '  xai:']
        out += [f'    - {yq(i)}' for i in xai_hidden]
    xai = [(lane, m) for lane in plan for m in lane['members'] if m['kind'] == 'xai']
    if xai:
        out += ['oauth-model-alias:', '  xai:']
        # The same display-name on every provider's entry for a lane alias: otherwise the picker shows whichever
        # provider registered last.
        for lane, m in xai:
            out.append(f'    - {{ name: {yq(m["model"])}, alias: {yq(lane["name"])}, fork: false, display-name: '
                       f'{yq(lane["display"])} }}')
            if lane['member_aliases']:
                out.append(f'    - {{ name: {yq(m["model"])}, alias: {yq(m["alias"])}, fork: false, display-name: '
                           f'{yq(m["display"])} }}')
    bridged = [(lane, m) for lane in plan for m in lane['members'] if m['kind'] == 'bridge']
    if bridged:
        out += ['meta-api-key:',
                '  # The local lane bridge (lanes/bridge.py) holds the provider keys; this key only admits the pool.']
        for lane, m in bridged:
            out += [f'  - api-key: {yq(bridge_key)}', f'    priority: {m["priority"]}', f'    base-url: {yq(m["base_url"])}',
                    '    models:',
                    f'      - {{ name: {yq(m["bridge_model"])}, alias: {yq(lane["name"])}, display-name: '
                    f'{yq(lane["display"])}, max-context-length: {lane["context"]} }}']
            if lane['member_aliases']:
                out.append(f'      - {{ name: {yq(m["bridge_model"])}, alias: {yq(m["alias"])}, display-name: '
                           f'{yq(m["display"])}, max-context-length: {m["context"]} }}')
    out += ['payload:', '  override:']
    codex = []
    for lane in plan:
        effort = f'      params: {{ "reasoning.effort": {yq(lane["effort"])} }}'
        for kind, protocol in (('xai', 'codex'), ('bridge', 'meta')):
            if any(m['kind'] == kind for m in lane['members']):
                names = [lane['name']] + [m['alias'] for m in lane['members']
                                          if m['kind'] == kind and lane['member_aliases']]
                out += [f'    - models: {_yaml_models(names, protocol)}', effort]
                if kind == 'xai':
                    codex += names
    if codex:
        out += ['    # xAI writes 30000.0 for "type":"number" fields, and Codex rejects floats for these integer arguments.',
                '    # Retype them to "integer" only where a field of that name is currently "number" (top level and in '
                'namespaces).',
                f'    - models: {_yaml_models(codex, "codex")}', '      params:']
        for f in FLOAT_FIELDS:
            path = f'parameters.properties.{f}.type'
            out += [f'        \'tools.#({path}=="number")#.{path}\': "integer"',
                    f'        \'tools.#(type=="namespace")#.tools.#({path}=="number")#.{path}\': "integer"']
        out += ['  filter:', f'    - models: {_yaml_models(codex, "codex")}', '      params: [ "service_tier" ]']
    out.append(LANES_END)
    return '\n'.join(out) + '\n'


def split_lanes_block(text):
    """(before, block, after) around config.yaml's lanes block; block is None when there is none."""
    lines = text.splitlines(keepends=True)
    begins = [i for i, line in enumerate(lines) if line.startswith('# >>> codexpool lanes')]
    ends = [i for i, line in enumerate(lines) if line.rstrip() == LANES_END]
    if not begins and not ends:
        return text, None, ''
    if len(begins) != 1 or len(ends) != 1 or ends[0] < begins[0]:
        raise LaneError(f'{tilde(CONFIG)}: the "# >>> codexpool lanes" and "{LANES_END}" markers are broken (each '
                        'must appear once, in that order); fix them by hand, then re-run')
    b, e = begins[0], ends[0]
    return ''.join(lines[:b]), ''.join(lines[b:e + 1]), ''.join(lines[e + 1:])


def _yaml_list_items(lines):
    """The scalars of '- item' lines ("double", 'single' or plain)."""
    out = []
    for line in lines:
        m = re.match(r'^\s*-\s+(.+?)\s*$', line)
        if not m:
            continue
        v = m.group(1)
        if v.startswith('"'):
            try:
                out.append(json.loads(v))
            except ValueError:
                out.append(v.strip('"'))
        elif v.startswith("'"):
            out.append(v[1:-1].replace("''", "'"))
        else:
            out.append(v.split(' #', 1)[0].strip())
    return out


def _mapping_end(lines, k):
    """Index just past the block mapping whose key is on line k: its indented lines, blank lines and comments."""
    j = k + 1
    while j < len(lines) and (not lines[j].strip() or lines[j][0] in ' \t#'):
        j += 1
    return j


def _strip_xai_subblock(lines):
    """(lines without the lanes (xai) sub-block, its model ids or None when there is none)."""
    b = next((i for i, line in enumerate(lines) if XAI_BEGIN_RE.match(line)), None)
    if b is None:
        return lines, None
    e = next((i for i in range(b + 1, len(lines)) if XAI_END_RE.match(lines[i])), None)
    if e is None:
        raise LaneError(f'{tilde(CONFIG)}: "{XAI_BEGIN}" has no "{XAI_END}"; fix it by hand, then re-run')
    return lines[:b] + lines[e + 1:], _yaml_list_items(lines[b + 1:e])


def _place_xai_subblock(lines, ids):
    """(lines with the lanes (xai) sub-block right under a top-level oauth-excluded-models:, whether there was one)."""
    k = next((i for i, line in enumerate(lines) if EXCLUDED_KEY.match(line)), None)
    if k is None:
        return lines, False
    inline = EXCLUDED_KEY.match(lines[k]).group(2).strip()
    if inline and not inline.startswith('#'):
        raise LaneError(f'{tilde(CONFIG)}: oauth-excluded-models is written on one line ({short(inline, 40)}); '
                        'write it as a block mapping (each provider on its own indented line) so lane apply can add '
                        'the xAI list, then re-run')
    body = lines[k + 1:_mapping_end(lines, k)]
    if any(re.match(r'^\s+(["\']?)xai\1\s*:', line) for line in body):
        raise LaneError(f'{tilde(CONFIG)}: oauth-excluded-models already has an xai: list of its own. With an xai lane '
                        'member, lane apply hides every other xAI model itself: delete that list, then re-run')
    indent = next((re.match(r'^(\s*)', line).group(1) for line in body
                   if line.strip() and not line.lstrip().startswith('#')), '') or '  '
    sub = [f'{indent}{XAI_BEGIN}\n', f'{indent}xai:\n'] + [f'{indent}  - {yq(i)}\n' for i in ids] + \
          [f'{indent}{XAI_END}\n']
    head = lines[k] if lines[k].endswith('\n') else lines[k] + '\n'
    return lines[:k] + [head] + sub + lines[k + 1:], True


def existing_xai_hidden(text):
    """The xAI model ids config.yaml hides now (the lanes (xai) sub-block, else the lanes block's own list), or None."""
    with contextlib.suppress(LaneError):
        before, block, after = split_lanes_block(text)
        for part in (before, after):
            ids = _strip_xai_subblock(part.splitlines(keepends=True))[1]
            if ids is not None:
                return ids
        lines = (block or '').splitlines()
        k = next((i for i, line in enumerate(lines) if EXCLUDED_KEY.match(line)), None)
        if k is not None:
            return _yaml_list_items(lines[k + 1:_mapping_end(lines, k)])
    return None


def lanes_config_text(text, plan, bridge_key, xai_hidden):
    """config.yaml with its lanes block rendered for plan (pure). xai_hidden: the xAI model ids to hide (None or []
    for none). They go into a marked sub-block under config.yaml's own top-level oauth-excluded-models: when it has
    one, else into the lanes block. Raises LaneError where it would have to guess."""
    before, old, after = split_lanes_block(text)
    parts = [_strip_xai_subblock(p.splitlines(keepends=True))[0] for p in (before, after)]
    outside = parts[0] + parts[1]
    own_excluded = any(EXCLUDED_KEY.match(line) for line in outside)
    block = render_lanes_block(plan, bridge_key, xai_hidden if xai_hidden and not own_excluded else None)
    clash = [key for key in ('oauth-model-alias', 'meta-api-key', 'payload')
             if re.search(rf'(?m)^{key}:', block) and any(re.match(rf'(["\']?){key}\1\s*:', line) for line in outside)]
    if clash:
        raise LaneError(f'{tilde(CONFIG)} has its own top-level {", ".join(clash)} outside the lanes block, and the lanes '
                        f'block needs {"that section" if len(clash) == 1 else "those sections"} to itself (YAML allows '
                        'each key once, and lane apply does not merge them). Remove or comment out your own '
                        f'{" and ".join(k + ":" for k in clash)} entries, then re-run; lanes.json cannot hold them. '
                        'See docs/TROUBLESHOOTING.md')
    if xai_hidden and own_excluded:
        placed = False
        for n in (0, 1):
            if not placed:
                parts[n], placed = _place_xai_subblock(parts[n], xai_hidden)
    before, after = ''.join(parts[0]), ''.join(parts[1])
    if old is None:
        if not block:
            return before
        return (before.rstrip('\n') + '\n\n' if before.strip() else '') + block
    if block:
        return before + block + after
    if before.endswith('\n\n') and (not after.strip() or after.startswith('\n')):
        before = before[:-1]  # the blank line lane apply put before the block
    return before + after


def block_aliases(text):
    """The model names config.yaml's current lanes block gives the pool (its alias: values), even a hand-built one."""
    try:
        block = split_lanes_block(text)[1] or ''
    except LaneError:
        return set()
    out = set()
    for v in re.findall(r'(?<![\w-])alias\s*:[ \t]*("(?:[^"\\\n]|\\.)*"|\'[^\'\n]*\'|[^,}\s]+)', block):
        with contextlib.suppress(ValueError):
            out.add(json.loads(v) if v.startswith('"') else v.strip("'"))
    return out


def masked(text):
    """config.yaml text with every value that may be key material replaced, for printing diffs: block and flow
    style, quoted keys, scalar items listed under such a key (api-keys:) and multi-line values. It hides too much
    rather than too little; a section such as meta-api-key: stays readable, and its api-key: lines are hidden."""
    out, under = [], None  # under: (column, everything) of a secret key whose value is on the lines below
    for line in text.splitlines(keepends=True):
        body = line.rstrip('\r\n')
        end, stripped = line[len(body):], body.lstrip()
        col = len(body) - len(stripped)
        if under is not None and stripped:
            if col > under[0] or (col == under[0] and stripped.startswith('-')):
                item = stripped[1:].lstrip() if stripped.startswith('-') else stripped
                if under[1] or not (item.startswith('{') or MAPPING_ITEM.match(item) or stripped.startswith('#')):
                    out.append(body[:col] + ('- ' if stripped.startswith('-') else '') + '"<hidden>"' + end)
                    continue
            else:
                under = None
        pos, parts = 0, []
        while True:
            m = SECRET_KEY.search(body, pos)
            if not m:
                break
            parts.append(body[pos:m.end()])
            rest = body[m.end():]
            value = rest.strip()
            if body.count('{', 0, m.start()) > body.count('}', 0, m.start()):  # inside a flow mapping
                pos = m.end() + FLOW_VALUE.match(rest).end()
                parts.append(' "<hidden>"')
                continue
            if not value or value.startswith('#') or value[:1] in ('|', '>'):
                under = (m.start(), value[:1] in ('|', '>'))  # a block scalar: every line below is the value
            elif value[:1] in ('"', "'") and not CLOSED_QUOTE.match(value):
                under = (m.start(), True)  # a quoted value that goes on over the next lines
            if value and not value.startswith('#') and value not in ('[]', '{}'):
                parts.append(' "<hidden>"')
                pos = len(body)
            else:
                pos = m.end()
            break
        out.append(''.join(parts) + body[pos:] + end if parts else line)
    return ''.join(out)


def render_bridge_config(plan):
    """lanes/bridge.json for a lane plan (pure), or None when no member goes through the bridge."""
    upstreams, models = {}, {}
    for lane in plan:
        for m in lane['members']:
            if m['kind'] != 'bridge':
                continue
            up = m['provider'] if m['provider'] != 'responses' else f'responses-{m["key_name"]}'
            upstreams[up] = {'base_url': m['upstream_url'], 'key_file': f'lanes/secrets/{m["key_name"]}.key',
                             'session_header': m['session_header']}
            models[m['bridge_model']] = {'upstream': up, 'upstream_model': m['model']}
    if not models:
        return None
    return json.dumps({'port': BRIDGE_PORT, 'key_file': 'lanes/secrets/bridge.key',
                       'seal_key_file': 'lanes/secrets/seal.key', 'upstreams': upstreams, 'models': models},
                      indent=2) + '\n'


def toml_str(value):
    """A TOML basic string. JSON's string syntax is valid TOML once control characters are ruled out."""
    if not plain_text(value):
        raise LaneError(f'cannot write {value!r} into a role file (empty, or control characters)')
    return json.dumps(value, ensure_ascii=False)


def lane_description(lane, members):
    """'Bulk lane: X at xhigh; Y (xhigh) takes over when X is unavailable or used up. <role>'"""
    names, e = [m['name'] for m in members], lane['effort']
    if len(names) == 1:
        head = f'{names[0]} at {e}.'
    elif len(names) == 2:
        head = f'{names[0]} at {e}; {names[1]} ({e}) takes over when {names[0]} is unavailable or used up.'
    else:
        head = f'{names[0]} at {e}; then {", then ".join(names[1:])} ({e}) when the earlier ones are unavailable or used up.'
    return f'{lane["name"][:1].upper() + lane["name"][1:]} lane: {head} {sentence(lane["role"])}'


def render_role(lane, role_name=None, model=None, members=None):
    """A Codex subagent role file (~/.codex/agents/<lane>.toml) for a lane (pure). lane test pins one member with
    role_name, model (the member alias) and members."""
    return '\n'.join([
        ROLE_HEADER,
        f'name = {toml_str(role_name or lane["name"])}',
        f'description = {toml_str(lane_description(lane, members or lane["members"]))}',
        f'model = {toml_str(model or lane["name"])}',
        f'model_reasoning_effort = {toml_str(lane["effort"])}',
        'developer_instructions = """',
        ROLE_INSTRUCTIONS.rstrip('\n'),
        '"""',
        '',
        '# Connector (apps) tool schemas cost ~130k tokens per request on third-party models (they get no deferred tool',
        '# search), and a lane subagent does not need them.',
        '[features]',
        'apps = false',
        ''])


def role_is_ours(path):
    try:
        with open(path) as f:
            return f.readline().startswith(ROLE_MARK)
    except (OSError, UnicodeDecodeError):
        return False


def render_agents_block(plan):
    """The ~/.codex/AGENTS.md block that tells the main agent which lanes exist (pure; '' without lanes)."""
    if not plan:
        return ''
    wrap = dict(width=118, break_long_words=False, break_on_hyphens=False)
    out = [AGENTS_BEGIN, '## Subagent lanes', '']
    out += textwrap.wrap('codexpool serves these third-party models as native subagents. This list is current and '
                         'replaces any older notes about alternative model providers.', **wrap)
    out.append('')
    for lane in plan:
        ms, e = lane['members'], lane['effort']
        text = f'`{lane["name"]}`: {ms[0]["name"]} at {e} reasoning'
        if len(ms) > 1:
            text += (f'; when it is unavailable or used up, the pool serves it from '
                     f'{", then ".join(m["name"] for m in ms[1:])} at {e} instead.')
        else:
            text += '.'
        text += (f' {sentence(lane["role"])} Use the default model when a task needs top capability. Spawn it with '
                 f'spawn_agent, agent_type "{lane["name"]}", fork_turns "none", and a self-contained task. Check what '
                 'it returns before relying on it. If a spawn fails, do the work yourself rather than retrying in a '
                 'loop.')
        out += textwrap.wrap(text, initial_indent='- ', subsequent_indent='  ', **wrap)
    out.append(AGENTS_END)
    return '\n'.join(out) + '\n'


def splice_agents_md(text, block):
    """AGENTS.md text with the lanes block replaced, appended after a blank line, or removed when block is ''."""
    lines = text.splitlines(keepends=True)
    begins = [i for i, line in enumerate(lines) if line.lstrip().startswith('<!-- codexpool:lanes BEGIN')]
    ends = [i for i, line in enumerate(lines) if line.strip() == AGENTS_END]
    if not begins and not ends:
        if not block:
            return text
        return (text.rstrip('\n') + '\n\n' if text.strip() else '') + block
    if len(begins) != 1 or len(ends) != 1 or ends[0] < begins[0]:
        raise LaneError(f'{tilde(CODEX_AGENTS_MD)}: the codexpool:lanes BEGIN/END markers are broken (each must appear '
                        'once, in that order); fix them by hand, then re-run')
    before, after = ''.join(lines[:begins[0]]), ''.join(lines[ends[0] + 1:])
    if block:
        return before + block + after
    if before.endswith('\n\n') and (not after.strip() or after.startswith('\n')):
        before = before[:-1]
    return '' if not (before + after).strip() else before + after


def write_text_keep_mode(path, text, mode=0o644):
    """Atomic write that keeps an existing file's mode (a new file gets mode); a symlink is written where it points."""
    path = pathlib.Path(path)
    if path.is_symlink():
        path = path.resolve()
    with contextlib.suppress(OSError):
        mode = path.stat().st_mode & 0o777
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix='.' + path.name + '.', suffix='.tmp')
    try:
        with os.fdopen(fd, 'w') as f:
            f.write(text)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


def read_text(path):
    try:
        return pathlib.Path(path).read_text()
    except FileNotFoundError:
        return None


def local_json(url, timeout=5):
    """GET a loopback URL without credentials: the parsed JSON, or None when nothing (valid) answers."""
    try:
        with _LOCAL.open(urllib.request.Request(url), timeout=timeout) as r:
            return json.loads(r.read() or b'null')
    except urllib.error.HTTPError as e:
        e.close()
        return None
    except (urllib.error.URLError, http.client.HTTPException, OSError, ValueError):  # HTTPException: not HTTP
        return None


def pool_model_ids(timeout=5):
    """The model names the pool offers (GET /v1/models, no key needed), or None when it does not answer."""
    data = local_json(f'{BASE}/v1/models', timeout)
    if not isinstance(data, dict) or not isinstance(data.get('data'), list):
        return None
    return {d.get('id') for d in data['data'] if isinstance(d, dict)}


def bridge_health(timeout=3):
    """The model ids the lane bridge serves (GET /healthz, no key needed), or None when it does not answer."""
    data = local_json(f'http://127.0.0.1:{BRIDGE_PORT}/healthz', timeout)
    if isinstance(data, dict) and data.get('ok') and isinstance(data.get('models'), list):
        return set(data['models'])
    return None


def xai_model_defs():
    """{model id: context length or None} for every xAI model the pool knows (management API)."""
    data = api('GET', '/v0/management/model-definitions/xai', timeout=10)
    items = data
    if isinstance(data, dict):
        items = next((v for v in (data.get('models'), data.get('data')) if isinstance(v, list)), None)
        if items is None:
            items = next((v for v in data.values() if isinstance(v, list)), [])
    out = {}
    for d in items if isinstance(items, list) else []:
        if isinstance(d, dict) and isinstance(d.get('id'), str):
            ctx = d.get('context_length')
            out[d['id']] = ctx if isinstance(ctx, int) and not isinstance(ctx, bool) and ctx > 0 else None
    return out


def pool_facts(want_defs, seats=None, want_seats=True):
    """What the lane commands read from the pool, without touching the Keychain while the pool is down:
    {'seats': auth files or None, 'defs': {xAI model: context} or None, 'error': why something is missing}."""
    facts = {'seats': seats, 'defs': None, 'error': None}
    if not want_defs and (seats is not None or not want_seats):
        return facts
    if not port_open(PORT):
        facts['error'] = f'the pool is not answering on 127.0.0.1:{PORT}'
        return facts
    try:
        if facts['seats'] is None and want_seats:
            facts['seats'] = load_seats()
        if want_defs:
            facts['defs'] = xai_model_defs()
    except (PoolDown, ApiError, KeyUnavailable) as e:
        facts['error'] = short(str(e), 120)
    return facts


def xai_credential_state(seats):
    """The best state among the pool's xAI credentials: ready, cooldown, exhausted, blocked, disabled, or missing."""
    creds = [s for s in seats if s['provider'] == 'xai']
    if not creds:
        return 'missing', None
    order = ('ready', 'cooldown', 'exhausted', 'blocked', 'parked', 'disabled')
    now = now_utc()
    states = [(seat_state(s, {}, now), s) for s in creds]
    (state, detail, until), seat = min(states, key=lambda x: order.index(x[0][0]) if x[0][0] in order else 9)
    return ('disabled' if state == 'parked' else state), seat


def lane_key_path(name):
    return LANE_SECRETS / f'{name}.key'


def bridge_fingerprint(config_text=None, code=None):
    """What a running bridge was started with: its code, bridge.json and the key files it read (their size and
    mtime, never their contents). A change means the bridge must restart to see it."""
    if code is None:
        code = (ROOT / 'lanes' / 'bridge.py').read_bytes() if (ROOT / 'lanes' / 'bridge.py').exists() else b''
    if config_text is None:
        config_text = read_text(BRIDGE_CONFIG) or ''
    h = hashlib.sha256(code + b'\0' + config_text.encode() + b'\0')
    try:
        cfg = json.loads(config_text)
    except ValueError:
        cfg = {}
    cfg = cfg if isinstance(cfg, dict) else {}
    files = [cfg.get('key_file') or 'lanes/secrets/bridge.key'] + \
            [u.get('key_file') for u in (cfg.get('upstreams') or {}).values() if isinstance(u, dict)]
    for rel in files:
        try:
            s = (ROOT / str(rel)).stat()
            h.update(f'{rel}:{s.st_mtime_ns}:{s.st_size}\0'.encode())
        except OSError:
            h.update(f'{rel}:-\0'.encode())
    return h.hexdigest()[:16]


def ensure_bridge_key():
    LANE_SECRETS.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(LANE_SECRETS, 0o700)
    try:
        fd = os.open(BRIDGE_KEY, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        return
    with os.fdopen(fd, 'w') as f:
        f.write(secrets.token_urlsafe(32) + '\n')


def kick_agent(label):
    r = subprocess.run(['launchctl', 'kickstart', '-k', f'gui/{UID}/{label}'], capture_output=True, text=True)
    if r.returncode != 0:
        raise RuntimeError(f'launchctl kickstart {label} failed: {r.stderr.strip() or r.returncode}')


def unload_agent(label):
    subprocess.run(['launchctl', 'bootout', f'gui/{UID}/{label}'], capture_output=True)
    with contextlib.suppress(FileNotFoundError):
        (LAUNCH_AGENTS / f'{label}.plist').unlink()


def record_install(**fields):
    """Merge fields into state/install.json; None removes a field."""
    rec = read_json(INSTALL_FILE, {})
    rec = rec if isinstance(rec, dict) else {}
    for k, v in fields.items():
        if v is None:
            rec.pop(k, None)
        else:
            rec[k] = v
    write_json(INSTALL_FILE, rec)


def record_bridge_agent(on):
    rec = read_json(INSTALL_FILE, {})
    agents = set((rec.get('agents') if isinstance(rec, dict) else None) or [])
    (agents.add if on else agents.discard)(BRIDGE_JOB)
    record_install(agents=sorted(agents), bridge_fingerprint=bridge_fingerprint() if on else None)


def lane_prepare(lanes, facts, members=False):
    """Everything lane apply would write, computed without writing anything. Raises LaneError where lane apply must
    stop before changing anything; provider keys that are missing are listed in 'missing_keys'. members: offer the
    member aliases too (lane test)."""
    xai_models = sorted({m['model'] for lane in lanes for m in lane['members'] if m['kind'] == 'xai'})
    defs = facts.get('defs')
    plan = lane_plan(lanes, defs, with_members=members)
    warnings = []
    config_old = read_text(CONFIG) or ''
    if not xai_models:
        hidden = None
    elif defs is not None:
        hidden = sorted(set(defs) - set(xai_models))
        warnings += [f'the pool knows no xAI model "{mod}"; check the model id (codexpool lane list, or '
                     f'curl -s {BASE}/v1/models)' for mod in xai_models if mod not in defs]
    else:
        hidden = existing_xai_hidden(config_old)
        warnings.append(f'cannot read the pool\'s xAI model list ({facts.get("error") or "no answer"}): the xAI '
                        + ('exclusions stay as they are' if hidden is not None else 'models other than the lane '
                           'models stay visible') + '; re-run codexpool lane apply once the pool answers')
        hidden = [i for i in hidden if i not in xai_models] if hidden is not None else None
    if xai_models and facts.get('seats') is not None and xai_credential_state(facts['seats'])[0] == 'missing':
        warnings.append('the pool has no xAI credential yet, so the xai members cannot serve: codexpool lane login xai')
    warnings += [f'{lane["name"]}/{m["id"]}: the pool did not give the context window of {m["model"]}; using '
                 f'{LANE_CONTEXT} until lane apply runs with the pool up (or set "context" in lanes.json)'
                 for lane in plan for m in lane['members'] if not m['context_known']]
    bridged = [m for lane in plan for m in lane['members'] if m['kind'] == 'bridge']
    key = (BRIDGE_KEY.read_text().strip() if BRIDGE_KEY.is_file() else '<new bridge key>') if bridged else ''
    config_new = lanes_config_text(config_old, plan, key, hidden)
    errors, roles = [], []
    served = pool_model_ids(3) if plan else set()
    if served is None:
        warnings.append(f'the pool is not answering on 127.0.0.1:{PORT}, so lane apply cannot check that no lane name '
                        'is a model the pool already serves; codexpool doctor checks it once the pool answers')
    else:
        ours = block_aliases(config_old)
        errors += [f'the pool already serves a model named "{a}" (a seat or provider model); a lane or member of that '
                   'name would take its requests. Rename the lane or set another member "id"'
                   for a in lane_aliases(plan) if a in served and a not in ours]
    for lane in plan:
        path = CODEX_AGENTS_DIR / f'{lane["name"]}.toml'
        old = read_text(path)
        if old is not None and not old.startswith(ROLE_MARK):
            errors.append(f'{tilde(path)} exists and was not generated by codexpool; move it away or rename the lane')
        roles.append((lane['name'], path, old, render_role(lane)))
    names = {lane['name'] for lane in plan}
    recorded = read_json(INSTALL_FILE, {}).get('lane_roles') or []
    stale = [CODEX_AGENTS_DIR / f'{n}.toml' for n in recorded if isinstance(n, str) and LANE_NAME_OK.match(n)
             and n not in names and role_is_ours(CODEX_AGENTS_DIR / f'{n}.toml')]
    agents_old = read_text(CODEX_AGENTS_MD)
    agents_new = splice_agents_md(agents_old or '', render_agents_block(plan))
    if errors:
        raise LaneError(errors)
    return {'lanes': lanes, 'plan': plan, 'facts': facts, 'warnings': warnings, 'hidden': hidden,
            'config_old': config_old, 'config_new': config_new,
            'bridge_old': read_text(BRIDGE_CONFIG), 'bridge_new': render_bridge_config(plan),
            'missing_keys': sorted({m['key_name'] for m in bridged if not lane_key_path(m['key_name']).is_file()}),
            'roles': roles, 'stale_roles': stale, 'agents_old': agents_old, 'agents_new': agents_new}


class LaneSteps(Steps):
    TOTAL = 4


def print_diff(old, new, name):
    for line in difflib.unified_diff((old or '').splitlines(), (new or '').splitlines(), f'a/{name}', f'b/{name}',
                                     lineterm=''):
        print(f'      {line}')


def lane_summary(lanes):
    return ', '.join(f'{lane["name"]} ({" → ".join(m["id"] for m in lane["members"])})' for lane in lanes) or 'none'


def write_lane_config(text):
    write_private(CONFIG_BEFORE_LANES, CONFIG.read_text())  # mode 600: config.yaml holds keys
    write_private(CONFIG, text)


def wait_for(fn, timeout):
    """Call fn until it returns a truthy value or timeout seconds pass; its last value."""
    deadline = time.time() + timeout
    while True:
        value = fn()
        if value or time.time() > deadline:
            return value
        time.sleep(1)


def lane_apply(lanes, dry, lanes_change=None):
    """Write everything lanes.json implies, or with dry print each change and a diff. lanes_change: (old, new)
    lanes.json text from lane add/remove, written only once nothing stands in the way."""
    require_installed('lane apply')
    has_xai = any(m['kind'] == 'xai' for lane in lanes for m in lane['members'])
    try:
        prep = lane_prepare(lanes, pool_facts(has_xai, want_seats=has_xai))
        if prep['missing_keys'] and not dry:
            raise LaneError([f'no API key for {k}: codexpool lane key {k} <file> (or pipe the key in, or paste it at '
                             'the prompt)' for k in prep['missing_keys']])
    except LaneError as e:
        sys.exit('codexpool lane apply stopped; nothing was changed:\n' + '\n'.join(f'  ✗ {p}' for p in e.problems))
    plan = prep['plan']
    st = LaneSteps(dry)
    if lanes_change:
        st.TOTAL = 5
    print(f'codexpool lane apply{" --dry-run: nothing is changed; each step says what it would do" if dry else ""}'
          f'\n  lanes: {lane_summary(lanes)} · pool 127.0.0.1:{PORT} · bridge 127.0.0.1:{BRIDGE_PORT}')
    try:
        lane_apply_steps(st, prep, dry, lanes_change)
    except RuntimeError as e:
        sys.exit(f'\nlane apply stopped: {e}\nFix that and re-run codexpool lane apply; every step is safe to repeat.')
    if dry:
        print('\nDry run: nothing was changed.'
              + (f' The {len(st.problems)} problem(s) marked ✗ would stop a real lane apply.' if st.problems else ''))
        sys.exit(1 if st.problems else 0)
    print(f'\nLanes applied: {lane_summary(lanes)}.' if plan else '\nNo lanes: everything lane apply generated is gone.')
    print('Start a new Codex thread (or restart the app) so it sees role and AGENTS.md changes.')
    if plan:
        print('Check them: codexpool lane list; codexpool lane test (spends a little lane quota).')


def lane_apply_steps(st, prep, dry, lanes_change):
    """The four steps of lane apply (five with a lanes.json edit), in order."""
    plan = prep['plan']

    if lanes_change:
        old, new = lanes_change
        st.step('lanes.json')
        st.change(f'{"write" if old is None else "update"} {tilde(LANES_FILE)}', write_text_keep_mode, LANES_FILE, new)
        if dry:
            print_diff(old, new, 'lanes.json')

    st.step('Pool config (config.yaml)')
    for w in prep['warnings']:
        st.warn(w)
    bridged = [m for lane in plan for m in lane['members'] if m['kind'] == 'bridge']
    if bridged and not BRIDGE_KEY.is_file():
        st.change(f'create {tilde(BRIDGE_KEY)} (mode 600): the key that admits the pool to the bridge', ensure_bridge_key)
        if not dry:
            prep['config_new'] = lanes_config_text(prep['config_old'], plan, BRIDGE_KEY.read_text().strip(),
                                                   prep['hidden'])
    old, new = prep['config_old'], prep['config_new']
    if old == new:
        st.ok('the lanes block in config.yaml is current' if plan else 'no lanes block in config.yaml (no lanes)')
    else:
        verb = ('replace the lanes block in' if split_lanes_block(old)[1] is not None and plan else
                'remove the lanes block from' if not plan else 'add the lanes block to')
        st.change(f'{verb} {tilde(CONFIG)} (the previous file is kept as {tilde(CONFIG_BEFORE_LANES)}); the pool '
                  'reloads it by itself', write_lane_config, new)
        if dry:
            print_diff(masked(old), masked(new), 'config.yaml')
    if not dry and plan:
        want = lane_aliases(plan)

        def served():
            ids = pool_model_ids(3)
            return ids is not None and all(a in ids for a in want)
        if wait_for(served, 15):
            st.ok(f'the pool offers {", ".join(want)}')
        else:
            ids = pool_model_ids(3) or set()
            st.warn(f'the pool does not list {", ".join(a for a in want if a not in ids)} after 15 s',
                    'codexpool logs -n 30 (the reload), codexpool lane list (member state)')

    st.step('Lane bridge')
    if prep['bridge_new']:
        src, dest = CODE_DIR / 'lanes' / 'bridge.py', ROOT / 'lanes' / 'bridge.py'
        code = src.read_bytes() if src.exists() else (dest.read_bytes() if dest.exists() else b'')
        if CODE_DIR != ROOT.resolve() and src.exists() and (not dest.exists() or dest.read_bytes() != code):
            st.change(f'copy lanes/bridge.py to {tilde(dest)}', lambda: (dest.parent.mkdir(parents=True, exist_ok=True),
                                                                           shutil.copy2(src, dest)))
        if LANE_SECRETS.is_dir() and LANE_SECRETS.stat().st_mode & 0o777 != 0o700:
            st.change(f'chmod 700 {tilde(LANE_SECRETS)}', os.chmod, LANE_SECRETS, 0o700)
        for name in sorted({m['key_name'] for m in bridged}):
            path = lane_key_path(name)
            if not path.is_file():
                st.fail(f'no API key for {name} ({tilde(path)})', f'codexpool lane key {name} <file>')
            elif path.stat().st_mode & 0o777 != 0o600:
                st.change(f'chmod 600 {tilde(path)}', os.chmod, path, 0o600)
            else:
                st.ok(f'key {name}: {tilde(path)} (mode 600)')
        if prep['bridge_old'] == prep['bridge_new']:
            st.ok(f'{tilde(BRIDGE_CONFIG)} is current')
        else:
            models = ', '.join(m['bridge_model'] for m in bridged)
            st.change(f'{"write" if prep["bridge_old"] is None else "update"} {tilde(BRIDGE_CONFIG)} (mode 600; models '
                      f'{models})', write_private, BRIDGE_CONFIG, prep['bridge_new'])
            if dry:
                print_diff(prep['bridge_old'], prep['bridge_new'], 'lanes/bridge.json')
        plist = LAUNCH_AGENTS / f'{BRIDGE_JOB}.plist'
        text = render_plist(BRIDGE_JOB, 'bridge.plist.template')
        current = read_text(plist)
        loaded, pid = launchd_loaded(BRIDGE_JOB)
        if current == text and loaded:
            recorded = read_json(INSTALL_FILE, {}).get('bridge_fingerprint')
            now_fp = bridge_fingerprint() if not dry else bridge_fingerprint(prep['bridge_new'], code)
            if recorded != now_fp:
                st.change(f'restart {BRIDGE_JOB} (its code, bridge.json or a key changed): launchctl kickstart -k',
                          kick_agent, BRIDGE_JOB)
            else:
                st.ok(f'{BRIDGE_JOB} running' + (f' (pid {pid})' if pid else ''))
        else:
            what = (f'write {tilde(plist)}' if current is None else
                    f'update {tilde(plist)}' if current != text else f'{tilde(plist)} is current')
            st.change(f'{what} from launchd/bridge.plist.template; load it (launchctl bootstrap gui/{UID})',
                      load_agent, BRIDGE_JOB, plist, text, current is not None and current != text)
        if not dry:
            want = {m['bridge_model'] for m in bridged}
            if wait_for(lambda: want <= (bridge_health(2) or set()), 10):
                st.ok(f'bridge answers on 127.0.0.1:{BRIDGE_PORT} for {", ".join(sorted(want))}')
            else:
                st.warn(f'the bridge does not answer on 127.0.0.1:{BRIDGE_PORT} for every lane model after 10 s',
                        f'tail {tilde(LOGS / "bridge.log")} ; codexpool doctor')
            record_bridge_agent(True)
    else:
        plist = LAUNCH_AGENTS / f'{BRIDGE_JOB}.plist'
        running, leftover = plist.exists() or launchd_loaded(BRIDGE_JOB)[0], BRIDGE_CONFIG.exists()
        if running:
            st.change(f'stop {BRIDGE_JOB} and delete {tilde(plist)} (no lane has a bridge member; the keys in '
                      f'{tilde(LANE_SECRETS)} stay)', unload_agent, BRIDGE_JOB)
        if leftover:
            st.change(f'delete {tilde(BRIDGE_CONFIG)}', BRIDGE_CONFIG.unlink)
        if not running and not leftover:
            st.ok('no lane has a bridge member; the bridge is not needed')
        if not dry:
            record_bridge_agent(False)

    st.step(f'Codex role files ({tilde(CODEX_AGENTS_DIR)})')
    for name, path, old, new in prep['roles']:
        if old == new:
            st.ok(f'{tilde(path)} is current')
        else:
            st.change(f'{"write" if old is None else "update"} {tilde(path)} (agent_type "{name}"; apps off)',
                      write_text_keep_mode, path, new)
            if dry:
                print_diff(old, new, path.name)
    for path in prep['stale_roles']:
        st.change(f'delete {tilde(path)} (its lane is no longer in lanes.json)', path.unlink)
    if not prep['roles'] and not prep['stale_roles']:
        st.ok('no lanes, no role files')
    if not dry:
        record_install(lane_roles=sorted(name for name, _, _, _ in prep['roles']) or None)

    st.step(f'Codex instructions ({tilde(CODEX_AGENTS_MD)})')
    old, new = prep['agents_old'], prep['agents_new']
    if (old or '') == new:
        st.ok('the lanes block is current' if plan else 'no lanes block (no lanes)')
    elif not new.strip() and read_json(INSTALL_FILE, {}).get('agents_md_created'):
        st.change(f'delete {tilde(CODEX_AGENTS_MD)} (lane apply created it and only the lanes block was in it)',
                  lambda: (CODEX_AGENTS_MD.unlink(), record_install(agents_md_created=None)))
    else:
        verb = 'create' if old is None else ('update the lanes block in' if plan else 'remove the lanes block from')
        st.change(f'{verb} {tilde(CODEX_AGENTS_MD)}', lambda: (
            write_text_keep_mode(CODEX_AGENTS_MD, new),
            record_install(agents_md_created=True) if old is None else None))
        if dry:
            print_diff(old, new, 'AGENTS.md')


def cmd_lane(args):
    """`codexpool lane` alone lists the lanes."""
    (getattr(args, 'lane_fn', None) or cmd_lane_list)(args)


def lane_state_cell(member, lane, seats, health):
    """(icon, state) of one member for lane list and status."""
    if member['kind'] == 'xai':
        if seats is None:
            return '?', 'unknown'
        state = xai_credential_state(seats)[0]
        return {'ready': '●', 'cooldown': '◌', 'exhausted': '◌', 'disabled': '–'}.get(state, '✕'), state
    if not lane_key_path(member['key_name']).is_file():
        return '✕', 'no key'
    if health is None:
        return '✕', 'bridge down'
    if f'lane-{lane["name"]}-{member["id"]}' not in health:
        return '✕', 'not in bridge'
    return '●', 'bridge ok'


def lane_test_cell(t):
    if not isinstance(t, dict) or 'ok' not in t:
        return 'never'
    comp = {True: ' +compaction', False: ' compaction FAIL'}.get(t.get('compaction'), '')
    return f'{"PASS" if t["ok"] else "FAIL"}{comp} {t.get("seconds", 0):.0f}s {when(t.get("when"))}'


def lane_test_json(t):
    """A lane-tests.json entry the way lane list --json gives it: {ok, when, reason}, or None (never tested)."""
    if not isinstance(t, dict) or 'ok' not in t:
        return None
    return {'ok': bool(t['ok']), 'when': t.get('when'), 'reason': str(t.get('reason') or '')}


def lane_list_facts(lanes):
    """What lane list shows next to lanes.json: (pool facts, bridge health, lane-tests.json). Quick checks only."""
    has_xai = any(m['kind'] == 'xai' for lane in lanes for m in lane['members'])
    facts = pool_facts(False) if has_xai else {'seats': [], 'error': None}
    health = bridge_health(2) if any(m['kind'] == 'bridge' for lane in lanes for m in lane['members']) else None
    tests = read_json(LANE_TESTS, {})
    return facts, health, tests if isinstance(tests, dict) else {}


def lane_list_data():
    """What codexpool lane list --json prints (the Settings window reads it): each lane with its members in fill
    order, each member's state in the words lane list uses, and the last lane test. {"lanes": []} without
    lanes.json; a broken lanes.json raises LaneError."""
    raw = read_lanes_raw()
    lanes = [] if raw is None else validate_lanes(raw)
    facts, health, tests = lane_list_facts(lanes)
    out = []
    for lane in lanes:
        t = tests.get(lane['name']) if isinstance(tests.get(lane['name']), dict) else {}
        out.append({'name': lane['name'], 'effort': lane['effort'], 'role': lane['role'], 'agent_type': lane['name'],
                    'last_test': lane_test_json(t.get('*')),
                    'members': [{'id': m['id'], 'provider': m['provider'], 'model': m['model'], 'name': m['name'],
                                 'state': lane_state_cell(m, lane, facts['seats'], health)[1],
                                 'last_test': lane_test_json(t.get(m['id']))} for m in lane['members']]})
    return {'lanes': out}


def cmd_lane_list(args):
    if getattr(args, 'json', False):
        print(json.dumps(lane_list_data(), indent=2))
        return
    raw = read_lanes_raw()
    if raw is None:
        print(f'No lanes yet ({tilde(LANES_FILE)} does not exist).\n'
              'A lane is a third-party model tier that Codex spawns as a native subagent; the pool serves it from its\n'
              'members in order. To start one:\n'
              '  codexpool lane login xai                        an xAI member (OAuth sign-in)\n'
              '  codexpool lane key opencode-go <file>           an OpenCode Go member (its API key)\n'
              '  codexpool lane add <name> --member xai:<model> --member opencode-go:<model> --role "<what it is for>"\n'
              '  codexpool lane test <name>\n'
              f'Format: {tilde(ROOT / "examples" / "lanes.json")}. Everything else: {tilde(ROOT / "docs" / "LANES.md")}.')
        return
    lanes = validate_lanes(raw)
    if not lanes:
        print(f'{tilde(LANES_FILE)} defines no lanes. Add one: codexpool lane add <name> --member PROVIDER:MODEL ...')
        return
    facts, health, tests = lane_list_facts(lanes)
    hints = []
    for lane in lanes:
        t = tests.get(lane['name']) if isinstance(tests.get(lane['name']), dict) else {}
        print(f'\n{lane["name"]}  ·  effort {lane["effort"]}  ·  agent_type "{lane["name"]}"  ·  lane test: '
              f'{lane_test_cell(t.get("*"))}')
        print(f'  {"#":>2}  {"member":<8} {"provider":<13} {"model":<32} {"state":<15} last test')
        for i, m in enumerate(lane['members'], 1):
            icon, state = lane_state_cell(m, lane, facts['seats'], health)
            print(f'  {i:>2}  {m["id"]:<8} {m["provider"]:<13} {m["model"]:<32} {icon} {state:<13} '
                  f'{lane_test_cell(t.get(m["id"]))}')
            if state == 'missing':
                hints.append('no xAI credential in the pool: codexpool lane login xai')
            elif state in ('disabled', 'blocked'):
                hints.append(f'the xAI credential is {state}: codexpool lane login xai, or codexpool enable <its name>')
            elif state == 'unknown':
                hints.append(f'xAI state unknown: {facts["error"]}')
            elif state == 'no key':
                hints.append(f'no key for {m["key_name"]}: codexpool lane key {m["key_name"]} <file>')
            elif state in ('bridge down', 'not in bridge'):
                hints.append('the bridge does not serve every lane model: codexpool lane apply ; codexpool doctor')
    for h in dict.fromkeys(hints):
        print(f'\n  → {h}' if h == hints[0] else f'  → {h}')


def cmd_lane_apply(args):
    lanes = load_lanes()
    if not LANES_FILE.exists():
        print(f'({tilde(LANES_FILE)} does not exist: applying no lanes, which removes anything lane apply generated)')
    lane_apply(lanes, args.dry_run)


def cmd_lane_add(args):
    raw = read_lanes_raw()
    old = read_text(LANES_FILE)
    raw = {'lanes': {}} if raw is None else raw
    if not isinstance(raw, dict) or not isinstance(raw.get('lanes', {}), dict):
        validate_lanes(raw)  # says what is wrong with it
    if args.name in (raw.get('lanes') or {}):
        sys.exit(f'codexpool: lane "{args.name}" is already in lanes.json. Edit it there and run codexpool lane apply, '
                 f'or codexpool lane remove {args.name} first.')
    members = []
    for spec in args.member:
        provider, sep, rest = spec.partition(':')
        model, _, name = rest.partition(':')
        if not sep or not model:
            sys.exit(f'codexpool: --member {spec!r}: write PROVIDER:MODEL or PROVIDER:MODEL:DISPLAY NAME '
                     f'(providers: {", ".join(LANE_PROVIDERS)})')
        m = {'provider': provider, 'model': model}
        if name:
            m['name'] = name
        if provider == 'responses':
            if args.base_url:
                m['base_url'] = args.base_url
            if args.session_header:
                m['session_header'] = args.session_header
        members.append(m)
    new_raw = dict(raw, lanes=dict(raw.get('lanes') or {}))
    new_raw['lanes'][args.name] = {'role': args.role or LANE_ROLE_DEFAULT, 'effort': args.effort, 'members': members}
    lanes = validate_lanes(new_raw)
    resolved = next(lane for lane in lanes if lane['name'] == args.name)['members']
    new_raw['lanes'][args.name]['members'] = [dict({'id': r['id']}, **m) for m, r in zip(members, resolved)]
    lane_apply(lanes, args.dry_run, lanes_change=(old, dump_lanes(new_raw)))


def cmd_lane_remove(args):
    raw = read_lanes_raw()
    if not isinstance(raw, dict) or not isinstance(raw.get('lanes'), dict) or args.name not in raw['lanes']:
        sys.exit(f'codexpool: there is no lane "{args.name}" in lanes.json (codexpool lane list)')
    new_raw = dict(raw, lanes={k: v for k, v in raw['lanes'].items() if k != args.name})
    lane_apply(validate_lanes(new_raw), args.dry_run, lanes_change=(read_text(LANES_FILE), dump_lanes(new_raw)))


def cmd_lane_key(args):
    """Save a provider API key for the bridge. The key is never printed or echoed."""
    name = args.keyname
    if not KEY_NAME_OK.match(name) or name in ('bridge', 'seal'):
        sys.exit(f'codexpool: "{name}" is not a key name: use opencode-go, opencode-zen, or <lane>-<id> for a '
                 'responses member (lowercase letters, digits and -)')
    if args.file and args.file != '-':
        try:
            secret = pathlib.Path(args.file).expanduser().read_text()
        except (OSError, UnicodeDecodeError) as e:
            sys.exit(f'codexpool: cannot read {args.file}: {type(e).__name__}')
    elif args.file == '-' or not sys.stdin.isatty():
        secret = sys.stdin.read()
    else:
        secret = getpass.getpass(f'API key for {name} (not shown): ')
    secret = secret.strip()
    if not secret or any(c.isspace() or unicodedata.category(c) == 'Cc' for c in secret):
        sys.exit('codexpool: that is not a key (empty, or it has spaces or line breaks); nothing was saved')
    LANE_SECRETS.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(LANE_SECRETS, 0o700)
    path = lane_key_path(name)
    existed = path.exists()
    write_private(path, secret + '\n')
    print(f'{"replaced" if existed else "saved"} the {name} key in {tilde(path)} (mode 600; it is not shown)')
    try:
        users = [f'{lane["name"]}-{m["id"]}' for lane in load_lanes() for m in lane['members']
                 if m.get('key_name') == name]
    except LaneError:
        users = []
    print(f'used by {", ".join(users)}; ' if users else 'no lane member uses it yet; ', end='')
    print('run codexpool lane apply so the bridge reads it')


def cmd_lane_login(args):
    """Sign the pool in to xAI (CLIProxyAPI's own OAuth flow), like codexpool login does for seats."""
    require_installed('lane login')
    print('Opening the xAI sign-in in your browser. (If it does not open, use the URL printed below.)\n'
          if not args.no_open else 'Open the xAI sign-in link printed below.\n')
    p = subprocess.Popen([str(cpa_binary()), '-config', str(CONFIG), '-xai-login'] + (['-no-browser'] if args.no_open
                                                                                      else []),
                         cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
    saved = None
    for line in p.stdout:
        sys.stdout.write(line)
        sys.stdout.flush()
        m = re.match(r'Authentication saved to (.+\.json)\s*$', line.strip())
        if m:
            saved = pathlib.Path(m.group(1))
    p.wait()
    if not saved or not saved.exists():  # CLIProxyAPI exits 0 on failure; only this line proves success
        sys.exit('\nxAI login did not complete; nothing changed')
    print(f'\nxAI credential {saved.name} is in the pool. It serves only lane models: lane apply hides every other '
          'xAI model and gives the lane models their lane names.\nNext: codexpool lane apply (or codexpool lane add '
          '...), then codexpool lane test.')


def lane_test_prompt(role, task):
    return (f'Spawn exactly one subagent with spawn_agent: agent_type "{role}", task_name "lane_test", fork_turns '
            f'"none". Its task: {task} Wait for it and print its final message verbatim. Do not edit files yourself.')


def _child_rollout(parent_id, since):
    """The rollout of the subagent a test thread spawned: written after since, its session_meta naming the parent."""
    found = []
    for path in (HOME / '.codex' / 'sessions').glob('**/rollout-*.jsonl'):
        with contextlib.suppress(OSError):
            if path.stat().st_mtime >= since:
                found.append(path)
    for path in sorted(found, key=lambda p: p.stat().st_mtime, reverse=True):
        with contextlib.suppress(OSError, ValueError, AttributeError, TypeError, KeyError):
            with path.open(errors='replace') as f:
                for _ in range(5):
                    e = json.loads(f.readline() or 'null')
                    if isinstance(e, dict) and e.get('type') == 'session_meta':
                        spawn = e['payload']['source']['subagent']['thread_spawn']
                        if spawn.get('parent_thread_id') == parent_id:
                            return path
                        break
    return None


def _child_facts(path):
    """Models the subagent's turns ran on, compactions, and tool calls Codex could not parse."""
    facts = {'models': set(), 'compactions': 0, 'parse_failures': 0}
    for line in path.read_text(errors='replace').splitlines():
        with contextlib.suppress(ValueError, AttributeError):
            e = json.loads(line)
            kind, payload = e.get('type'), e.get('payload') or {}
            if kind == 'turn_context' and payload.get('model'):
                facts['models'].add(payload['model'])
            elif kind == 'compacted':
                facts['compactions'] += 1
            elif kind == 'response_item' and payload.get('type') == 'function_call_output' and \
                    'failed to parse function arguments' in json.dumps(payload.get('output')):
                facts['parse_failures'] += 1
    return facts


def _lane_test_run(codex, role, want_model, compaction, seed):
    """One test: a throwaway Codex thread spawns the role once. (ok, one-line reason, seconds)."""
    work = pathlib.Path(tempfile.mkdtemp(prefix='codexpool-lanetest-'))
    try:
        markers = None
        if compaction:
            rng, markers = random.Random(seed), []
            for i in range(1, 9):
                lines = ['%04d ' % n + 'lorem ipsum dolor sit amet consectetur adipiscing elit sed do' for n in range(450)]
                lines[225] = f'MARKER-{i}-{rng.randrange(10 ** 6):06d}'
                markers.append(lines[225])
                (work / f'big{i}.txt').write_text('\n'.join(lines) + '\n')
        else:
            (work / 'a.txt').write_text('alpha\n')
        argv = [codex, 'exec', '--json', '--skip-git-repo-check', '-s', 'workspace-write', '-C', str(work),
                '-c', 'notify=[]'] + (['-c', 'model_auto_compact_token_limit=70000'] if compaction else []) + \
               [lane_test_prompt(role, LANE_COMPACTION_TASK if compaction else LANE_TEST_TASK)]
        start = time.time()
        try:
            r = _run_codex(argv, timeout=1500 if compaction else 600)
        except subprocess.TimeoutExpired:
            return False, 'codex exec timed out', time.time() - start
        seconds = time.time() - start

        def content(name):
            p = work / name
            return p.read_text(errors='replace').strip() if p.exists() else None
        if r['code'] != 0:
            return False, f'codex exec exit {r["code"]}: {short(" ".join(r["errors"]), 100)}', seconds
        if markers is None and content('a.txt') != 'beta':
            return False, 'a.txt was not changed to beta', seconds
        if markers is None and content('c.txt') != 'lane-ok':
            return False, 'c.txt does not hold lane-ok', seconds
        if markers is not None and [x.strip() for x in (content('notes.txt') or '').splitlines() if x.strip()] != markers:
            return False, 'notes.txt does not list the 8 markers in order', seconds
        child = _child_rollout(r['thread_id'], start - 1) if r['thread_id'] else None
        if not child:
            return False, 'no subagent rollout found (did the spawn fail?)', seconds
        facts = _child_facts(child)
        if facts['models'] != {want_model}:
            return False, f'the subagent ran on {", ".join(sorted(facts["models"])) or "no model"}, not {want_model}', seconds
        if facts['parse_failures']:
            return False, f'{facts["parse_failures"]} tool call(s) failed to parse (run codexpool lane apply)', seconds
        if compaction and not facts['compactions']:
            return False, 'the subagent never compacted', seconds
        return True, (f'compacted {facts["compactions"]}x, all 8 markers kept' if compaction else
                      'edited both files with apply_patch'), seconds
    finally:
        shutil.rmtree(work, ignore_errors=True)


def set_member_aliases(lanes, on, want=()):
    """Offer (on) or withdraw the member aliases in config.yaml's lanes block, changing nothing else. With on, wait
    up to 15 s for the pool to list every alias in want; withdrawing, wait up to 15 s until it lists none of the
    aliases the write removed (the pool reloads config.yaml about a second later). Failures here never stop lane
    test's cleanup."""
    has_xai = any(m['kind'] == 'xai' for lane in lanes for m in lane['members'])
    try:
        prep = lane_prepare(lanes, pool_facts(has_xai, want_seats=False), members=on)
    except LaneError as e:
        msg = '; '.join(e.problems)
        if on:
            sys.exit(f'codexpool: cannot offer the member aliases for the test: {msg}')
        print(f'warning: could not withdraw the member aliases ({msg}); run codexpool lane apply')
        return
    if prep['config_new'] != prep['config_old']:
        write_private(CONFIG, prep['config_new'])
    removed = set() if on else block_aliases(prep['config_old']) - block_aliases(prep['config_new'])
    deadline = time.time() + 15
    while (want if on else removed) and time.time() < deadline:
        served = pool_model_ids(3)
        if on and set(want) <= (served or set()):
            return
        if not on and (served is None or not removed & served):  # gone, or the pool is down and reloads on start
            return
        time.sleep(1)
    left = sorted(removed & (pool_model_ids(3) or set())) if not on and removed else []
    if left:
        print(f'warning: the pool still lists {", ".join(left)} 15 s after lane test withdrew them; if codexpool doctor '
              'still reports them, run codexpool lane apply')


def cmd_lane_test(args):
    """Real subagents through Codex: each member pinned, then the lane itself (spends lane and a little seat quota)."""
    require_installed('lane test')
    lanes = load_lanes()
    if args.member and not args.lane:
        sys.exit('codexpool: --member needs the lane: codexpool lane test <lane> --member <id>')
    picked = [lane for lane in lanes if not args.lane or lane['name'] == args.lane]
    if not picked:
        sys.exit(f'codexpool: no lane "{args.lane}" in lanes.json' if args.lane else
                 'codexpool: lanes.json defines no lanes (codexpool lane add ...)')
    codex = codex_bin()
    if not codex:
        sys.exit('codexpool: the Codex CLI was not found (not in the Codex app, not on PATH); '
                 f'set "codex_bin" in {SETTINGS_FILE}')
    plan = lane_plan(picked, with_members=True)
    jobs = []  # (lane, member or None for the lane itself, compaction)
    for lane in plan:
        members = [m for m in lane['members'] if not args.member or m['id'] == args.member]
        if not members:
            sys.exit(f'codexpool: lane {lane["name"]} has no member "{args.member}" '
                     f'({", ".join(m["id"] for m in lane["members"])})')
        for m in members:
            jobs += [(lane, m, False)] + ([(lane, m, True)] if args.compaction else [])
        if not args.member:
            if read_text(CODEX_AGENTS_DIR / f'{lane["name"]}.toml') != render_role(lane):
                sys.exit(f'codexpool: the role file for {lane["name"]} is missing or out of date: codexpool lane apply')
            jobs.append((lane, None, False))
    want = {m['alias'] if m else lane['name'] for lane, m, _ in jobs}  # only what the chosen tests spawn
    for lane, m, _ in jobs:  # a temporary role never replaces a file lane test did not write
        path = CODEX_AGENTS_DIR / f'{TEST_ROLE_PREFIX}{lane["name"]}-{m["id"]}.toml' if m else None
        if path and path.exists() and not role_is_ours(path):
            sys.exit(f'codexpool: {tilde(path)} exists and was not written by codexpool; lane test needs that name '
                     'for a temporary role. Move it away, then re-run.')
    if pool_model_ids(5) is None:
        sys.exit(f'codexpool: the pool is not answering on 127.0.0.1:{PORT}; try codexpool doctor')
    pinned = any(m for _, m, _ in jobs)
    temp_roles, results = [], []
    try:
        if pinned:  # member aliases exist only while lane test runs; the finally below withdraws them
            set_member_aliases(lanes, True, want)
        served = pool_model_ids(5) or set()
        if not want & served:
            sys.exit(f'codexpool: the pool does not offer {", ".join(sorted(want))}. Run codexpool lane apply, and '
                     'check codexpool lane list for member state.')
        print(f'lane test: {len(jobs)} test(s) through Codex ({tilde(codex)}); this spends lane-provider quota and a '
              'little seat quota')
        for lane, m, compaction in jobs:
            alias = m['alias'] if m else lane['name']
            label = f'{lane["name"]}/{m["id"]}' if m else f'{lane["name"]} (lane)'
            label += ' compaction' if compaction else ''
            if alias not in served:
                print(f'  {label} ... FAIL')
                results.append((lane['name'], m['id'] if m else '*', compaction, label, False,
                                f'the pool does not offer {alias} (codexpool lane list shows why)', 0.0))
                continue
            if m:
                role = f'{TEST_ROLE_PREFIX}{lane["name"]}-{m["id"]}'
                path = CODEX_AGENTS_DIR / f'{role}.toml'
                if path not in temp_roles:
                    temp_roles.append(path)  # absent or a leftover test role (checked above), so ours to delete
                    write_text_keep_mode(path, render_role(lane, role_name=role, model=m['alias'], members=[m]))
            else:
                role = lane['name']
            print(f'  {label} ...', end='', flush=True)
            ok, reason, seconds = _lane_test_run(codex, role, alias, compaction,
                                                 f'{lane["name"]}/{m["id"] if m else "*"}')
            print(f' {"PASS" if ok else "FAIL"}')
            results.append((lane['name'], m['id'] if m else '*', compaction, label, ok, reason, seconds))
    finally:
        for sig in (signal.SIGHUP, signal.SIGTERM, signal.SIGINT):
            signal.signal(sig, signal.SIG_IGN)  # a second signal must not leave a temporary role behind
        for path in temp_roles:
            with contextlib.suppress(OSError):
                path.unlink()
        if pinned:
            set_member_aliases(lanes, False)
    print(f'\n  {"test":<34} {"result":<7} {"seconds":>7}  reason')
    for _, _, _, label, ok, reason, seconds in results:
        print(f'  {label:<34} {"PASS" if ok else "FAIL":<7} {seconds:>7.0f}  {reason}')
    rec = read_json(LANE_TESTS, {})
    rec = rec if isinstance(rec, dict) else {}
    stamp = now_utc().isoformat()
    for lane_name, key, compaction, _, ok, reason, seconds in results:
        lane_rec = rec.get(lane_name) if isinstance(rec.get(lane_name), dict) else {}
        rec[lane_name] = lane_rec
        if not compaction:
            lane_rec[key] = {'ok': ok, 'when': stamp, 'seconds': round(seconds, 1), 'reason': reason, 'compaction': None}
        else:
            entry = lane_rec.setdefault(key, {'ok': True, 'when': stamp, 'seconds': 0, 'reason': '', 'compaction': None})
            entry.update(ok=bool(entry.get('ok')) and ok, compaction=ok, seconds=round(entry.get('seconds', 0) + seconds, 1),
                         reason=(entry.get('reason') + '; ' if entry.get('reason') else '') + f'compaction: {reason}')
    write_json(LANE_TESTS, rec)
    failed = [r for r in results if not r[4]]
    print(f'\n{"FAIL" if failed else "PASS"}: {len(results) - len(failed)} of {len(results)} test(s) passed '
          f'(saved in {tilde(LANE_TESTS)})')
    sys.exit(1 if failed else 0)


def lane_status_lines(st):
    """One line per lane for codexpool status: 'lane bulk: grok ● ready → muse ● bridge ok'. Quick checks only."""
    try:
        lanes = load_lanes()
    except LaneError:
        return ['lanes: lanes.json is invalid (codexpool lane list says why)']
    if not lanes:
        return []
    order = ('ready', 'cooldown', 'exhausted', 'blocked', 'parked', 'disabled')
    xai_state = min((r.get('state') for r in st.get('seats', []) if r.get('provider') == 'xai'),
                    key=lambda s: order.index(s) if s in order else 9, default='missing')
    xai_state = 'disabled' if xai_state == 'parked' else xai_state
    health = bridge_health(1) if any(m['kind'] == 'bridge' for lane in lanes for m in lane['members']) else None
    lines = []
    for lane in lanes:
        cells = []
        for m in lane['members']:
            if m['kind'] == 'xai':
                icon = {'ready': '●', 'cooldown': '◌', 'exhausted': '◌', 'disabled': '–'}.get(xai_state, '✕')
                cells.append(f'{m["id"]} {icon} {xai_state}')
            else:
                icon, state = lane_state_cell(m, lane, [], health)
                cells.append(f'{m["id"]} {icon} {state}')
        lines.append(f'lane {lane["name"]}: ' + ' → '.join(cells))
    return lines


def lane_leftovers():
    """Generated role files that uninstall removes: the recorded ones and those of lanes.json, if they still carry
    the codexpool marker, plus any lane test role left behind."""
    names = {n for n in (read_json(INSTALL_FILE, {}).get('lane_roles') or [])
             if isinstance(n, str) and LANE_NAME_OK.match(n)}
    with contextlib.suppress(LaneError):
        names |= {lane['name'] for lane in load_lanes()}
    files = [CODEX_AGENTS_DIR / f'{n}.toml' for n in sorted(names)]
    files += sorted(CODEX_AGENTS_DIR.glob(f'{TEST_ROLE_PREFIX}*.toml'))
    return [p for p in files if role_is_ours(p)]


def agents_md_has_lanes():
    return any(line.lstrip().startswith('<!-- codexpool:lanes BEGIN')
               for line in (read_text(CODEX_AGENTS_MD) or '').splitlines())


def remove_agents_md_lanes():
    new = splice_agents_md(read_text(CODEX_AGENTS_MD) or '', '')
    if not new.strip() and read_json(INSTALL_FILE, {}).get('agents_md_created'):
        CODEX_AGENTS_MD.unlink()
    else:
        write_text_keep_mode(CODEX_AGENTS_MD, new)


def doctor_lanes(check, seats):
    """The Lanes section of codexpool doctor (run only when lanes.json exists)."""
    try:
        lanes = load_lanes()
    except LaneError as e:
        for p in e.problems:
            check(False, p, f'fix {tilde(LANES_FILE)} ({tilde(ROOT / "examples" / "lanes.json")} shows the format)')
        return
    check(True, f'lanes.json: {lane_summary(lanes)}')
    if not lanes:
        return
    has_xai = any(m['kind'] == 'xai' for lane in lanes for m in lane['members'])
    facts = pool_facts(has_xai, seats=seats or None)
    plan = lane_plan(lanes, facts['defs'])
    try:
        prep = lane_prepare(lanes, facts)
    except LaneError as e:  # the generated files cannot be compared; the live checks below still run
        prep = None
        for p in e.problems:
            check(False, f'lane apply would stop: {p}', 'fix that, then codexpool lane apply')
    if prep and has_xai and facts['defs'] is None:
        check(False, f'config.yaml lanes block: not checked without the pool\'s xAI model list ({facts["error"]})',
              'run codexpool doctor again once the pool answers', warn=True)
    elif prep:
        check(prep['config_new'] == prep['config_old'], 'config.yaml lanes block matches lanes.json',
              'codexpool lane apply')
    for name, path, old, new in (prep['roles'] if prep else []):
        check(old == new, f'role file {tilde(path)} ' + ('in sync' if old == new else 'missing' if old is None
                                                          else 'out of date'), 'codexpool lane apply')
    if prep:
        check((prep['agents_old'] or '') == prep['agents_new'], f'lanes block in {tilde(CODEX_AGENTS_MD)} in sync',
              'codexpool lane apply')
    if has_xai:
        if facts['seats'] is None:
            check(False, f'xAI credential: cannot tell ({facts["error"]})', 'codexpool doctor once the pool answers',
                  warn=True)
        else:
            state, seat = xai_credential_state(facts['seats'])
            text = f'xAI credential: {state}' + (f' ({seat["name"]})' if seat else '')
            if state == 'missing':
                check(False, text, 'codexpool lane login xai')
            elif state == 'disabled':
                check(False, text, f'codexpool enable {shlex.quote(seat["name"])}')
            elif state == 'blocked':
                check(False, text, 'codexpool lane login xai (sign in again)')
            else:
                check(state == 'ready', text, 'the pool serves the next lane member meanwhile', warn=True)
    bridged = [m for lane in plan for m in lane['members'] if m['kind'] == 'bridge']
    if bridged:
        loaded, pid = launchd_loaded(BRIDGE_JOB)
        check(loaded and pid, f'launchd job {BRIDGE_JOB} ' + (f'running (pid {pid})' if pid else
                                                              'loaded, not running' if loaded else 'not loaded'),
              f'codexpool lane apply (log: {tilde(LOGS / "bridge.log")})')
        check(read_text(BRIDGE_CONFIG) == render_bridge_config(plan), 'lanes/bridge.json matches lanes.json',
              'codexpool lane apply')
        want = sorted(m['bridge_model'] for m in bridged)
        health = bridge_health(3)
        missing = [w for w in want if w not in (health or set())]
        check(health is not None and not missing, f'bridge on 127.0.0.1:{BRIDGE_PORT}: ' +
              ('not answering' if health is None else f'does not serve {", ".join(missing)}' if missing else
               f'serves {", ".join(want)}'), f'codexpool lane apply ; tail {tilde(LOGS / "bridge.log")}')
        for name in ['bridge'] + sorted({m['key_name'] for m in bridged}):
            path = lane_key_path(name)
            if not path.is_file():
                check(False, f'key {name}: {tilde(path)} missing',
                      'codexpool lane apply' if name == 'bridge' else f'codexpool lane key {name} <file>')
                continue
            mode = path.stat().st_mode & 0o777
            check(mode == 0o600, f'key {name}: present, mode {mode:o}', f'chmod 600 {tilde(path)}')
    ids = pool_model_ids(5)
    if ids is None:
        check(False, '/v1/models: the pool does not answer', 'codexpool restart ; codexpool logs')
        return
    gone = [lane['name'] for lane in plan if lane['name'] not in ids]
    check(not gone, 'every lane is offered by the pool (/v1/models)' if not gone else
          f'/v1/models does not list {", ".join(gone)}', 'codexpool lane apply ; codexpool lane list')
    left = sorted(a for lane in plan for a in (m['alias'] for m in lane['members']) if a in ids
                  and a not in lane_aliases(plan))
    if left:  # member aliases exist only while lane test runs; a crash there can leave them behind
        check(False, f'/v1/models still lists the member alias(es) {", ".join(left)} from a lane test',
              'codexpool lane apply (they belong in the Codex model picker only while lane test runs)', warn=True)


# ---------------------------------------------------------------- version, set, the Settings window, setup

def cmd_version(args):
    print(f'codexpool {VERSION}')


@contextlib.contextmanager
def settings_lock():
    """Held for each read-modify-write of settings.json, so two codexpool set runs at once (the Settings window can
    start them back to back) cannot lose one change. It waits: what it guards takes milliseconds."""
    STATE.mkdir(parents=True, exist_ok=True)
    with open(STATE / 'settings.lock', 'a') as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(f, fcntl.LOCK_UN)


def write_setting(key, value):
    """Set key to value in settings.json, atomically and under settings_lock, keeping every other key, their order
    and the _ notes (a missing file is created). The result must pass the checks load_settings makes. Returns (the
    new settings, whether the file changed)."""
    with settings_lock():
        try:
            raw = json.loads(SETTINGS_FILE.read_text())
        except FileNotFoundError:
            raw = {}
        except (OSError, ValueError) as e:
            raise SettingsError(f'cannot read {SETTINGS_FILE}: {e}') from None
        parse_settings(raw)  # refuses a file that is already broken, before anything is written
        changed = raw.get(key) != value
        raw[key] = value     # an existing key keeps its place; a new one goes last
        new = parse_settings(raw)
        if changed:
            write_text_keep_mode(SETTINGS_FILE, json.dumps(raw, indent=2, ensure_ascii=False) + '\n')
        return new, changed


def settable_now():
    """display and headline as settings.json has them now: another codexpool set may have changed one since this
    process read it. Empty when the file cannot be read."""
    with contextlib.suppress(OSError, ValueError, SettingsError):
        return {k: v for k, v in parse_settings(json.loads(SETTINGS_FILE.read_text())).items() if k in SETTABLE}
    return {}


def show_settings_now(timeout=90):
    """Rewrite status.json for the current settings under the guard lock, waiting up to timeout seconds for a guard
    pass to finish: from the pool, as enable and disable do, else from status.json as it is. False when neither
    worked (the guard's next pass writes it anyway)."""
    deadline = time.monotonic() + timeout
    while True:
        with guard_lock(wait=False) as got:
            if got:
                SETTINGS.update(settable_now())  # the last of two set runs at once writes both changes
                return refresh_status_file() or restamp_status_file()
        if time.monotonic() > deadline:
            return False
        time.sleep(0.5)


def cmd_set(args):
    """Change one of the menu bar's two settings in settings.json and show it at once."""
    if args.key is None:
        for key, choices in SETTABLE.items():
            print(f'{key:<9} {SETTINGS[key]:<8} ({" or ".join(choices)})')
        return
    choices = SETTABLE.get(args.key)
    if choices is None:
        sys.exit(f'codexpool set: "{args.key}" is not one of the settings it changes ({", ".join(SETTABLE)}); '
                 f'the others are in {tilde(SETTINGS_FILE)}')
    if args.value not in choices:
        sys.exit(f'codexpool set: {args.key} is {" or ".join(choices)}'
                 + (f', not "{args.value}"' if args.value else ''))
    old = SETTINGS[args.key]
    try:
        new, _ = write_setting(args.key, args.value)
    except SettingsError as e:
        sys.exit(f'codexpool: {e}')
    except OSError as e:
        sys.exit(f'codexpool set: cannot write {SETTINGS_FILE}: {e}')
    SETTINGS.update(new)
    shown = show_settings_now()
    print((f'{args.key}: {old} → {args.value}.' if old != args.value else f'{args.key} is already {args.value}.')
          + (' The menu bar shows it within a few seconds.' if shown else
             " The menu bar shows it after the guard's next pass (within a minute)."))


GUI_PANES = ('overview', 'seats', 'lanes', 'general', 'health', 'about', 'setup-welcome')


def settings_app():
    """The Settings window: menubar/codexpool_settings.py in the install (install copies it with the menu bar)."""
    return ROOT / 'menubar' / 'codexpool_settings.py'


def gui_argv(pane='overview'):
    """How codexpool gui starts the Settings window: the menu bar app's interpreter (the one with PyObjC) running
    the installed codexpool_settings.py, opened on pane."""
    if pane not in GUI_PANES:
        raise ValueError(f'unknown pane {pane!r} (one of: {", ".join(GUI_PANES)})')
    return [str(menubar_python_bin()), str(settings_app()), '--pane', pane]


def cmd_gui(args):
    argv = gui_argv(args.pane)
    python, script = argv[0], pathlib.Path(argv[1])
    if not script.is_file():
        sys.exit(f'codexpool gui: the Settings window is not installed ({tilde(script)} is missing). Install codexpool '
                 'first: the one-line installer, or ./bin/codexpool install from a checkout.')
    if not (os.access(python, os.X_OK) or shutil.which(python)):
        sys.exit(f'codexpool gui: {tilde(python)}, the interpreter with PyObjC, is missing: run codexpool install (or '
                 f'set "menubar_python" in {tilde(SETTINGS_FILE)})')
    LOGS.mkdir(parents=True, exist_ok=True)
    with open(LOGS / 'settings.log', 'a') as log:  # detached: it outlives this command and the terminal
        subprocess.Popen(argv, cwd=ROOT, stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
    print(f'Opening the codexpool Settings window ({args.pane}). If nothing appears, see '
          f'{tilde(LOGS / "settings.log")}.')


CPA_PASTE_PROMPT = 'Paste the Codex callback URL (or press Enter to keep waiting): '  # CLIProxyAPI, after 15 s
PRIVATE_WINDOW_NOTE = (
    '  codexpool now gets a sign-in link from the pool. Open it, sign in to the ChatGPT account for this seat and\n'
    '  pick its workspace. Your browser is probably signed in to one account already: for any other account, open\n'
    '  the link in a private (incognito) window, or you get the account the browser knows once more.')


class Prompter:
    """setup's questions. The answers come from stdin when it is a terminal, else from /dev/tty (the one-line
    installer runs setup with stdin on a pipe). src is None when there is no terminal at all; tests pass a stream."""

    def __init__(self, src=None):
        self.src = src
        if self.src is None:
            if sys.stdin.isatty():
                self.src = sys.stdin
            else:
                with contextlib.suppress(OSError):
                    self.src = open('/dev/tty')

    def ask(self, question):
        """One line of answer, stripped. EOFError when the input ends (Ctrl-D)."""
        if self.src is None:
            raise EOFError
        sys.stdout.write(question)
        sys.stdout.flush()
        line = self.src.readline()
        if not line:
            raise EOFError
        return line.strip()

    def yes(self, question, default):
        while True:
            answer = self.ask(f'{question} {"[Y/n]" if default else "[y/N]"} ').lower()
            if not answer:
                return default
            if answer in ('y', 'yes'):
                return True
            if answer in ('n', 'no'):
                return False
            print('  Please answer y or n.')


def chrome_app():
    """Google Chrome's app bundle, or None. setup offers a Chrome incognito window when it is there."""
    for folder in APP_FOLDERS:
        if (folder / 'Google Chrome.app').is_dir():
            return folder / 'Google Chrome.app'
    return None


def open_url_argv(url, incognito=False):
    """open(1) arguments for the sign-in link: a new Chrome incognito window, or the default browser."""
    return ['open', '-na', 'Google Chrome', '--args', '--incognito', url] if incognito else ['open', url]


def open_url(url, incognito=False):
    with contextlib.suppress(OSError, subprocess.SubprocessError):
        if subprocess.run(open_url_argv(url, incognito), capture_output=True, timeout=30).returncode == 0:
            return True
    print('  Could not open it; copy the link into a private window yourself.')
    return False


def reopen_codex_app(timeout=20):
    """Quit the Codex app the way Cmd-Q does, wait until it is gone, and open it again, so it reads
    ~/.codex/config.toml afresh. False when that did not work."""
    app = f'application id "{CODEX_BUNDLE_ID}"'

    def running():
        r = subprocess.run(['osascript', '-e', f'{app} is running'], capture_output=True, text=True, timeout=10)
        return r.returncode == 0 and r.stdout.strip() == 'true'
    try:
        if running():
            subprocess.run(['osascript', '-e', f'tell {app} to quit'], capture_output=True, timeout=30)
            deadline = time.time() + timeout
            while running():
                if time.time() > deadline:
                    return False
                time.sleep(0.5)
        return subprocess.run(['open', '-b', CODEX_BUNDLE_ID], capture_output=True, timeout=30).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def setup_seats(term):
    """setup step 1: the pool's seats, once it answers. When it does not, offers one restart."""
    for attempt in (1, 2):
        try:
            return load_seats()
        except PoolDown:
            print(f'  ✗ the pool is not answering on 127.0.0.1:{PORT}')
            if attempt == 2 or not term.yes('  Restart it now?', True):
                break
            try:
                kick_pool()
            except RuntimeError as e:
                print(f'  ✗ {e}')
                break
            print('  restarting the pool ...')
            wait_healthy()
        except KeyUnavailable as e:
            sys.exit(f'  ✗ {e}\n    fix: {e.fix}')
        except ApiError as e:
            sys.exit(f'  ✗ management API error: {short(str(e), 200)}\n    codexpool doctor says more.')
    sys.exit('\nSetup cannot add seats while the pool is down. codexpool doctor says why; then run codexpool setup '
             'again.')


def print_seats(seats):
    codex = [s for s in seats if s['provider'] == 'codex']
    if not codex:
        print('  No ChatGPT accounts in the pool yet: Codex requests fail until you add one.')
        return
    print(f'  {len(codex)} ChatGPT account{"s" if len(codex) != 1 else ""} in the pool, in fill order:')
    for s in codex:
        tags = [s['plan'] or 'plan unknown', f'size {s["weight"]:g}×'] + (['reserve'] if s['reserve'] else []) + \
            (['off'] if s['disabled'] else [])
        print(f'    {s["label"]}  ({", ".join(tags)})')


def setup_add_seat(term, seats, added):
    """One round of setup's add-an-account loop: a label, the sign-in, the reserve question. A seat added goes into
    added at once, so a Ctrl-C later still lists it. Returns 'added', 'again' (an account already in the pool) or
    'failed' (the sign-in did not finish)."""
    taken = {s['label'].lower() for s in seats}
    while True:
        label = term.ask('  Name for this seat, e.g. Work or Personal (Enter: named after its email): ')
        problem = label_problem(label) if label else None
        if not problem and label and label.lower() in taken:
            problem = f'a seat is already called {label} (codexpool login {shlex.quote(label)} signs it in again)'
        if not problem:
            break
        print(f'  That name will not do: {problem}.')
    print(PRIVATE_WINDOW_NOTE)
    before = {p.name for p in AUTH.glob('codex-*.json')}
    chrome = chrome_app()

    def offer(url):
        print(f'\n  Sign-in link (it expires after about 5 minutes):\n  {url}\n')
        if chrome and term.yes('  Open it in a Chrome incognito window?', True):
            open_url(url, incognito=True)
        elif not chrome and term.yes('  Open it in your default browser?', True):
            open_url(url)
        print('  Waiting for the sign-in to finish (Ctrl-C stops) ...')
    mark = log_mark()
    # stdin: not the terminal, which CLIProxyAPI's own paste prompt would read at the same time as these questions
    saved, lines = login_seat(no_open=True, echo=False, on_url=offer, stdin=subprocess.DEVNULL)
    if not saved:
        said = sign_in_failure(lines, mark)
        if said:
            print('  The sign-in did not finish; nothing changed. The pool said:')
            for line in said:
                print(f'    {line}')
        else:
            print('  The sign-in did not finish; nothing changed. The link may have expired (links last about 5\n'
                  f'  minutes), or the sign-in was stopped. {tilde(MAIN_LOG)} may say more.')
        return 'failed'
    if saved.name in before:
        again = next((s['label'] for s in seats if s['name'] == saved.name), saved.name)
        print(f'  That was {again} once more (the same ChatGPT account and workspace): its login is refreshed and '
              'nothing was added.\n  For another account, open the link in a private window.')
        return 'again'
    c = file_claims(saved)
    fresh_seat_meta(saved.name, label)
    shown = label or default_label(c['email'], c['plan'])
    seat = {'label': shown, 'plan': c['plan'] or 'plan unknown', 'size': default_weight(c['plan']), 'reserve': False}
    added.append(seat)
    print(f'\n  ✓ Added {shown}: {c["email"] or "email unknown"}, plan {seat["plan"]}, size {seat["size"]}× '
          f'(codexpool weight {shlex.quote(shown)} <n> changes the size).')
    for warning in duplicate_seat_warnings():
        print(f'  {warning}')
    seat['reserve'] = term.yes('  Use it as the reserve (last resort)?', False)
    update_meta(saved.name, reserve=True if seat['reserve'] else None)
    set_priority_when_loaded(saved.name, new_seat_place(saved.name, seat['reserve']), shown)
    return 'added'


def setup_summary(added):
    if not added:
        return 'No seats were added this time. Run codexpool setup again whenever you like.'
    seats = ', '.join(f'{s["label"]} ({s["plan"]}, {s["size"]}×{", reserve" if s["reserve"] else ""})' for s in added)
    return (f'Added {len(added)} seat{"s" if len(added) != 1 else ""} this time: {seats}.\n'
            'codexpool status lists every seat; the menu bar item next to the clock shows what is left.')


def cmd_setup(args):
    """The guided setup in the terminal (the installer runs it with --no-gui, or when there is no GUI)."""
    missing = missing_install()
    if missing:
        sys.exit(f'codexpool setup: codexpool is not installed yet ({", ".join(missing)} missing). Install it first: '
                 'the one-line installer, or ./bin/codexpool install from a checkout; then run codexpool setup.')
    term = Prompter()
    if term.src is None:
        sys.exit('codexpool setup asks questions, so it needs a terminal: run it in Terminal. (The Settings window '
                 'has the same steps: codexpool gui setup-welcome)')
    print('codexpool setup: add your ChatGPT accounts to the pool, check everything and reopen Codex. Ctrl-C stops '
          'at any point.')
    added = []
    try:
        print('\n[1/4] The pool')
        seats = setup_seats(term)
        print(f'  ✓ the pool answers on 127.0.0.1:{PORT}')
        print_seats(seats)

        print('\n[2/4] ChatGPT accounts')
        question = 'Add a ChatGPT account?'
        while term.yes(question, True):
            outcome = setup_add_seat(term, seats, added)
            with contextlib.suppress(PoolDown, ApiError, KeyUnavailable):
                seats = load_seats()
            print()
            question = 'Try again, with a new sign-in link?' if outcome == 'failed' else 'Add another ChatGPT account?'

        print('\n[3/4] Subagent lanes (optional)')
        docs = ROOT / 'docs' / 'LANES.md'
        print('  Lanes let Codex hand token-heavy work to third-party models (xAI, OpenCode, any Responses API) as\n'
              '  native subagents. Nothing to do now; to set one up later, read '
              f'{tilde(docs) if docs.exists() else REPO_URL + "/blob/main/docs/LANES.md"}.')

        print('\n[4/4] Check everything (codexpool doctor)')
        rep = DoctorReport()
        doctor_checks(rep)
        print(f'\n{rep.verdict()}\n')
        if term.yes('Quit and reopen the Codex app now, so it goes through the pool? Anything running in it stops.',
                    False):
            print('  ✓ the Codex app reopened' if reopen_codex_app() else
                  '  ✗ could not reopen the Codex app: quit it with Cmd-Q and open it again')
        else:
            print('  When it suits you, quit the Codex app fully (Cmd-Q) and open it again: until then it may still '
                  'talk to OpenAI directly.')
    except (KeyboardInterrupt, EOFError):
        print(f'\n\nSetup stopped. {setup_summary(added)}')
        sys.exit(130)
    print(f'\nSetup done. {setup_summary(added)}')


# ---------------------------------------------------------------- main

def build_parser():
    p = argparse.ArgumentParser(prog='codexpool', description=__doc__.split('\n\n')[0],
                                epilog='New here? codexpool setup walks you through adding your ChatGPT accounts.')
    p.add_argument('--version', action='version', version=f'codexpool {VERSION}')
    sub = p.add_subparsers(dest='cmd', required=True)
    s = sub.add_parser('status', help='seat table (the default)')
    s.add_argument('--live', action='store_true', help='poll every seat now instead of the guard cache')
    s.add_argument('--json', action='store_true', help='print what the menu bar reads (status.json) as JSON')
    s.set_defaults(fn=cmd_status)
    s = sub.add_parser('doctor', help='check the whole setup and say how to fix problems')
    s.add_argument('--json', action='store_true',
                   help='print the checks as JSON, and nothing else, on stdout (the Settings window reads it); the '
                        'exit status is the same')
    s.set_defaults(fn=cmd_doctor)
    s = sub.add_parser('setup', help='guided setup in the terminal: add your ChatGPT accounts, check, reopen Codex',
                       description='A guided setup for the terminal: checks that the pool answers, lists your seats, '
                                   'adds ChatGPT accounts one by one (the same sign-in as codexpool login --no-open), '
                                   'runs codexpool doctor and offers to reopen the Codex app. Asks before each step; '
                                   'Ctrl-C stops at any point.')
    s.set_defaults(fn=cmd_setup)
    s = sub.add_parser('gui', help='open the Settings window (codexpool gui lanes opens it on the Lanes pane)',
                       description='Open the codexpool Settings window, detached from the terminal. setup-welcome '
                                   'opens the Setup assistant.')
    s.add_argument('pane', nargs='?', default='overview', choices=GUI_PANES, metavar='PANE',
                   help=f'the pane to show: {", ".join(GUI_PANES)} (default: %(default)s)')
    s.set_defaults(fn=cmd_gui)
    s = sub.add_parser('set', help='change a menu bar setting: display (left|used) or headline (all|regular)',
                       description='Change one of the menu bar settings in settings.json (the other keys stay as they '
                                   'are) and rewrite status.json, so the menu bar shows it within seconds. Without '
                                   'KEY: print both settings.')
    s.add_argument('key', nargs='?', metavar='KEY',
                   help='display: what numbers count, left (down from 100%%) or used (up from 0%%); headline: what the '
                        'headline %% covers, all seats or the regular ones (reserve seats left out)')
    s.add_argument('value', nargs='?', metavar='VALUE', help='left or used for display; all or regular for headline')
    s.set_defaults(fn=cmd_set)
    sub.add_parser('version', help='print the codexpool version').set_defaults(fn=cmd_version)
    s = sub.add_parser('login', help='add or re-login a seat (browser sign-in; --device for a device code)')
    s.add_argument('label', nargs='?', help='label for the seat')
    s.add_argument('--device', action='store_true', help='device-code flow (needs device sign-in enabled on the account)')
    s.add_argument('--no-open', action='store_true',
                   help='print the sign-in link instead of opening it (open it in a private window to use another account)')
    s.add_argument('--priority', type=int,
                   help='higher is used first (default for a new seat: after the seats already in the pool, before '
                        'the reserve)')
    s.set_defaults(fn=cmd_login)
    for name, fn, hlp in (('enable', cmd_enable, 'put a seat back in rotation (overrides the credit guard)'),
                          ('disable', cmd_disable, 'take a seat out of rotation')):
        s = sub.add_parser(name, help=hlp)
        s.add_argument('seat')
        s.set_defaults(fn=fn)
    s = sub.add_parser('priority', help='change fill order (higher first)')
    s.add_argument('seat')
    s.add_argument('priority', type=int)
    s.set_defaults(fn=cmd_priority)
    s = sub.add_parser('label', help='rename a seat')
    s.add_argument('seat')
    s.add_argument('label')
    s.set_defaults(fn=cmd_label)
    s = sub.add_parser('weight', help="set a seat's share of the pool total (Plus = 1, Pro = 20)")
    s.add_argument('seat')
    s.add_argument('weight', type=float)
    s.set_defaults(fn=cmd_weight)
    s = sub.add_parser('reset', help='redeem one banked free reset for a seat (never buys one)')
    s.add_argument('seat')
    s.add_argument('--yes', action='store_true', help='skip the confirmation prompt')
    s.set_defaults(fn=cmd_reset)
    s = sub.add_parser('reserve', help='mark a seat as reserve: it fills last, red when serving, left out of a '
                                       '"regular" headline')
    s.add_argument('seat')
    s.add_argument('--off', action='store_true', help='make it a regular seat again (it moves before any reserve)')
    s.set_defaults(fn=cmd_reserve)
    s = sub.add_parser('remove', help='delete a seat file from the pool')
    s.add_argument('seat')
    s.add_argument('--yes', action='store_true')
    s.set_defaults(fn=cmd_remove)
    s = sub.add_parser('refresh', help='force a token refresh (clears auth blocks)')
    s.add_argument('seat', nargs='?')
    s.set_defaults(fn=cmd_refresh)
    sub.add_parser('restart', help='restart the pool process').set_defaults(fn=cmd_restart)
    s = sub.add_parser('logs', help='tail the pool log')
    s.add_argument('-f', '--follow', action='store_true')
    s.add_argument('-n', '--lines', type=int, default=60)
    s.add_argument('--guard', action='store_true', help='tail the guard log instead')
    s.set_defaults(fn=cmd_logs)
    s = sub.add_parser('selftest', help='move a real thread between two seats and check it survives')
    s.add_argument('from_seat')
    s.add_argument('to_seat')
    s.add_argument('--model', default='gpt-6-astra', help='model for the test turns (default: %(default)s)')
    s.add_argument('--compact', action='store_true', help='also carry a native compaction across')
    s.add_argument('--effort', default='high', help='reasoning effort for the test turns (must produce reasoning items)')
    s.set_defaults(fn=cmd_selftest)
    s = sub.add_parser('build', help='build a CLIProxyAPI release with the origin gate (no install)')
    s.add_argument('version', help='e.g. 7.3.18 or latest')
    s.set_defaults(fn=cmd_build)
    s = sub.add_parser('upgrade', help='build, switch, health-check, and switch back on failure')
    s.add_argument('version', help='e.g. 7.3.18 or latest')
    s.add_argument('--force', action='store_true')
    s.set_defaults(fn=cmd_upgrade)
    s = sub.add_parser('install', help='set up or repair everything (Go, the gated build, key, launchd, Codex config)')
    s.add_argument('--dry-run', action='store_true', help='print every step without changing anything')
    s.add_argument('--fix-config', action='store_true',
                   help='also remove model_provider / model_catalog_json from the Codex config (uninstall restores them)')
    s.set_defaults(fn=cmd_install)
    s = sub.add_parser('uninstall', help='stop the agents and restore the Codex config (keeps seats and data)')
    s.add_argument('--yes', action='store_true', help='do it (without --yes it only prints the plan)')
    s.set_defaults(fn=cmd_uninstall)
    s = sub.add_parser('lane', help='third-party models that Codex spawns as subagents (see docs/LANES.md)',
                       description='Lanes: third-party model tiers that the Codex main agent spawns as native subagents '
                                   '(agent_type "<lane>"). The pool serves a lane from its members in order. Lanes '
                                   'live in ~/.codexpool/lanes.json; `lane apply` writes the rest. With no subcommand: '
                                   'lane list.')
    s.set_defaults(fn=cmd_lane)
    lane = s.add_subparsers(dest='lane_cmd', metavar='{list,apply,add,remove,key,login,test}')
    x = lane.add_parser('list', help='each lane, its members in order, their state and last test (the default)')
    x.add_argument('--json', action='store_true', help='print the lanes as JSON (the Settings window reads it)')
    x.set_defaults(lane_fn=cmd_lane_list)
    x = lane.add_parser('apply', help='write the pool config block, the bridge, the Codex role files and the AGENTS.md '
                                      'block from lanes.json')
    x.add_argument('--dry-run', action='store_true', help='print each change and a diff; write nothing')
    x.set_defaults(lane_fn=cmd_lane_apply)
    x = lane.add_parser('add', help='add a lane to lanes.json, then apply')
    x.add_argument('name', metavar='NAME', help='the lane name, which is also the agent_type (e.g. bulk)')
    x.add_argument('--member', action='append', required=True, metavar='PROVIDER:MODEL[:DISPLAY NAME]',
                   help=f'a member, in fill order (repeat it). Providers: {", ".join(LANE_PROVIDERS)}')
    x.add_argument('--role', metavar='TEXT', help='what the lane is for; the main agent reads it (one sentence or two)')
    x.add_argument('--effort', choices=LANE_EFFORTS, default='xhigh', help='reasoning effort (default: %(default)s)')
    x.add_argument('--base-url', metavar='URL', help='responses members: the https:// base URL of the Responses API')
    x.add_argument('--session-header', metavar='NAME', help='responses members: header that carries a session id')
    x.add_argument('--dry-run', action='store_true', help='print the lanes.json change and what apply would do')
    x.set_defaults(lane_fn=cmd_lane_add)
    x = lane.add_parser('remove', help='remove a lane from lanes.json, then apply')
    x.add_argument('name', metavar='NAME')
    x.add_argument('--dry-run', action='store_true', help='print the lanes.json change and what apply would do')
    x.set_defaults(lane_fn=cmd_lane_remove)
    x = lane.add_parser('key', help='save a provider API key for the bridge (mode 600; never printed)')
    x.add_argument('keyname', metavar='KEYNAME', help='opencode-go, opencode-zen, or <lane>-<id> for a responses member')
    x.add_argument('file', nargs='?', metavar='FILE',
                   help='read the key from FILE (- for stdin); without FILE: stdin, or a prompt that does not echo')
    x.set_defaults(lane_fn=cmd_lane_key)
    x = lane.add_parser('login', help='sign the pool in to a lane provider (xai: browser OAuth)')
    x.add_argument('provider', choices=['xai'])
    x.add_argument('--no-open', action='store_true', help='print the sign-in link instead of opening it')
    x.set_defaults(lane_fn=cmd_lane_login)
    x = lane.add_parser('test', help='spawn real lane subagents through Codex and check them (spends lane quota)')
    x.add_argument('lane', nargs='?', metavar='LANE', help='only this lane (default: every lane)')
    x.add_argument('--member', metavar='ID', help='only this member, pinned (skips the lane-level test)')
    x.add_argument('--compaction', action='store_true', help='also force a compaction in each member\'s subagent')
    x.set_defaults(lane_fn=cmd_lane_test)
    sub.add_parser('guard', help='one guard pass (run by launchd every minute)').set_defaults(fn=cmd_guard)
    sub.add_parser('menubar', help='SwiftBar output').set_defaults(fn=cmd_menubar)
    return p


def main():
    args = build_parser().parse_args(sys.argv[1:] or ['status'])
    ensure_python(args.cmd)
    for sig in (signal.SIGHUP, signal.SIGTERM):
        signal.signal(sig, _raise_exit)  # closing the terminal or launchd stopping us still runs cleanup
    try:
        args.fn(args)
    except PoolDown as e:
        sys.exit(f'codexpool: pool not reachable on :{PORT} ({e}). Try: codexpool restart ; codexpool doctor')
    except ApiError as e:
        sys.exit(f'codexpool: management API error: {short(str(e), 200)}')
    except KeyUnavailable as e:
        sys.exit(f'codexpool: {e}\n  fix: {e.fix}')
    except LaneError as e:
        sys.exit('\n'.join(f'codexpool: {p}' for p in e.problems))


if __name__ == '__main__':
    main()
