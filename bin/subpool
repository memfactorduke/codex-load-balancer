VERSION = '1.4.0'  # subpool's own version (subpool version); CLIProxyAPI has its own

HOME = pathlib.Path.home()
ROOT = HOME / '.subpool'
CODE_DIR = pathlib.Path(__file__).resolve().parent.parent  # the checkout this file runs from (ROOT once installed)
AUTH = ROOT / 'auth'
STATE = ROOT / 'state'
LOGS = ROOT / 'logs'
BIN = ROOT / 'bin'
VERSIONS = BIN / 'versions'
CURRENT = BIN / 'current'  # the Codex pool's build
BUILD = ROOT / 'build'
GATE_SOURCE = BUILD / 'codexpool_gate.go'
TOOLCHAIN = ROOT / 'toolchain'
CONFIG = ROOT / 'config.yaml'
SEATS_META = ROOT / 'seats.json'  # per seat file: {label, weight, reserve}
HISTORY_FILE = STATE / 'history.jsonl'  # headline usage samples for the menu bar chart
HISTORY_EVERY = 10 * 60
HISTORY_KEEP_DAYS = 8
STATUS_FILE = STATE / 'status.json'
GUARD_FILE = STATE / 'guard.json'
LOCK_FILE = STATE / 'guard.lock'  # the Codex pool's guard state, and the settings
SELFTEST_JOURNAL = STATE / 'selftest.json'
INSTALL_FILE = STATE / 'install.json'  # what `subpool install` changed outside ROOT, for uninstall
LANES_FILE = ROOT / 'lanes.json'  # lane definitions (never committed); examples/lanes.json shows the format
LANES_DIR = ROOT / 'lanes'
BRIDGE_CONFIG = LANES_DIR / 'bridge.json'  # written by `subpool lane apply` while a lane has a bridge member
LANE_SECRETS = LANES_DIR / 'secrets'  # provider keys and the bridge key: files 600 in a 700 directory
BRIDGE_KEY = LANE_SECRETS / 'bridge.key'  # admits the pool to the bridge; the only key config.yaml holds for lanes
LANE_TESTS = STATE / 'lane-tests.json'  # `subpool lane test` results
CONFIG_BEFORE_LANES = STATE / 'config.yaml.before-lane-apply'
MAIN_LOG = LOGS / 'main.log'
GUARD_LOG = LOGS / 'guard.log'

# Per-machine settings. settings.json is never committed; examples/settings.json shows every key.
LEGACY_ROOT = HOME / '.codexpool'
_settings_default = ROOT / 'settings.json'
if not ROOT.exists() and (LEGACY_ROOT / 'settings.json').is_file():
    _settings_default = LEGACY_ROOT / 'settings.json'
SETTINGS_FILE = pathlib.Path(os.environ.get('SUBPOOL_SETTINGS') or os.environ.get('CODEXPOOL_SETTINGS')
                             or _settings_default).expanduser()
LEGACY_INSTALL = LEGACY_ROOT.exists() and (not ROOT.exists() or LEGACY_ROOT.resolve() == ROOT.resolve())
_default_label_prefix = 'com.codexpool' if LEGACY_INSTALL else 'com.subpool'
SETTINGS_DEFAULTS = {
    'pool_label': _default_label_prefix + '.pool',        # launchd label of the pool (CLIProxyAPI)
    'guard_label': _default_label_prefix + '.guard',      # launchd label of `subpool guard` (every 60 s)
    'menubar_label': _default_label_prefix + '.menubar',  # launchd label of the menu bar app
    'bridge_label': _default_label_prefix + '.bridge',    # launchd label of the lane bridge (only while a lane needs it)
    'port': 8319,                              # loopback port the pool listens on
    'bridge_port': 8320,                       # loopback port of the lane bridge (lanes/bridge.py)
    'python': None,           # interpreter for the guard and the wrapper; null: ~/.subpool/.venv/bin/python
    'menubar_python': None,   # interpreter with PyObjC for the menu bar app; null: same as python
    'codex_bin': None,        # the codex CLI; null: the one inside the Codex app, else codex on PATH
    'headline': 'all',        # the headline %: "all" non-disabled seats, reserve included, or "regular" (no reserve)
    'display': 'left',        # numbers count "left" (down from 100%) or "used" (up from 0%)
    'balancing': 'priority',  # which seat new threads get: "priority" (your fill order) or "reset" (soonest reset first)
}
HEADLINES = ('all', 'regular')
DISPLAYS = ('left', 'used')
BALANCINGS = ('priority', 'reset')
SETTABLE = {'display': DISPLAYS, 'headline': HEADLINES, 'balancing': BALANCINGS}
LABEL_OK = re.compile(r'^[A-Za-z0-9][A-Za-z0-9._-]*$')


# Add-ons bootstrap in two phases: JSON metadata before settings; executable hooks only
# after the complete core module exists. This is fault isolation for trusted local code,
# not a sandbox for hostile Python. Loading must be free of external side effects.
ADDON_DIRS = (CODE_DIR / 'addons', ROOT / 'addons')
ADDON_REGISTRY = STATE / 'addons.json'  # durable namespace reservations, including removed code
ADDON_ID_OK = re.compile(r'^[a-z][a-z0-9]{1,15}$')
ADDONS, ADDON_ERRORS = [], {}
ADDON_MANIFESTS, ADDON_PATHS, ADDON_NAMESPACES = {}, {}, {}
ADDON_FAILED_HOOKS = set()
ADDON_READY = False
_LOADED_ADDONS = {}
_ADDON_PARSERS = weakref.WeakSet()
CORE_SETTINGS_DEFAULTS = dict(SETTINGS_DEFAULTS)
CORE_SETTABLE = dict(SETTABLE)


def parse_version(value):
    match = re.fullmatch(r'(\d+)\.(\d+)\.(\d+)', value) if isinstance(value, str) else None
    if not match:
        raise ValueError('version must be major.minor.patch')
    return tuple(int(part) for part in match.groups())


def addon_error(aid, phase, error):
    message = f'{phase}: {type(error).__name__}: {error}'
    old = ADDON_ERRORS.get(aid, '')
    if message not in old:
        ADDON_ERRORS[aid] = old + ('; ' if old else '') + message


def read_addon_manifest(directory):
    """Read addon.json without importing code. Legacy prefixes are explicit metadata."""
    data = json.loads((pathlib.Path(directory) / 'addon.json').read_text())
    if not isinstance(data, dict) or not isinstance(data.get('id'), str) or not ADDON_ID_OK.fullmatch(data['id']):
        raise ValueError('manifest needs a valid id')
    for key in ('version', 'core_min'):
        parse_version(data.get(key))
    prefixes = data.setdefault('settings_prefixes', [data['id'] + '_'])
    if not isinstance(prefixes, list) or not prefixes or any(
            not isinstance(p, str) or not re.fullmatch(r'[a-z][a-z0-9]*_', p) for p in prefixes):
        raise ValueError('settings_prefixes must be a nonempty list of namespaces ending in _')
    defaults, settable = data.setdefault('settings', {}), data.setdefault('settable', {})
    if not isinstance(defaults, dict) or any(not k.startswith(tuple(prefixes)) for k in defaults):
        raise ValueError('settings keys must belong to settings_prefixes')
    if not isinstance(settable, dict) or any(k not in defaults or not isinstance(v, list) or not v
                                          or any(not isinstance(c, str) for c in v) or defaults[k] not in v
                                          for k, v in settable.items()):
        raise ValueError('settable must name settings with nonempty string choices and a valid default')
    if not isinstance(data.get('auto_ports', []), list) or any(
            key not in defaults or not key.endswith('_port') for key in data.get('auto_ports', [])):
        raise ValueError('auto_ports must name declared port settings')
    files = data.setdefault('code_files', ['addon.py'])
    if not isinstance(files, list) or 'addon.py' not in files or any(
            not isinstance(p, str) or not p or pathlib.PurePosixPath(p).is_absolute()
            or any(part in ('.', '..') for part in p.split('/')) for p in files):
        raise ValueError('code_files must include addon.py and contain only relative code paths')
    return data


def discover_addons():
    """Reserve persisted namespaces, then discover JSON metadata; checkout wins, even if broken."""
    try:
        registry = json.loads(ADDON_REGISTRY.read_text())
        if not isinstance(registry, dict):
            raise ValueError('namespace registry must be an object')
        for aid, prefixes in registry.items():
            if not ADDON_ID_OK.fullmatch(aid) or not isinstance(prefixes, list) or not prefixes or any(
                    not isinstance(p, str) or not re.fullmatch(r'[a-z][a-z0-9]*_', p) for p in prefixes):
                raise ValueError('invalid namespace reservation')
        ADDON_NAMESPACES.update(registry)
    except FileNotFoundError:
        pass
    except (OSError, ValueError) as error:
        addon_error('registry', 'manifest', error)
    for base in ADDON_DIRS:
        try:
            entries = sorted(base.iterdir()) if base.is_dir() else []
        except OSError as error:
            addon_error('discovery', 'manifest', error)
            continue
        for directory in entries:
            aid = directory.name
            if not ADDON_ID_OK.fullmatch(aid) or aid in ADDON_PATHS or not directory.is_dir():
                continue
            ADDON_PATHS[aid] = directory
            ADDON_NAMESPACES.setdefault(aid, [aid + '_'])
            try:
                manifest = read_addon_manifest(directory)
                if manifest['id'] != aid:
                    raise ValueError('manifest id must match directory name')
                # Reserve before compatibility or executable checks. Retain historical prefixes.
                ADDON_NAMESPACES[aid] = sorted(set(ADDON_NAMESPACES[aid] + manifest['settings_prefixes']))
                ADDON_MANIFESTS[aid] = manifest
                if parse_version(manifest['core_min']) > parse_version(VERSION):
                    raise ValueError(f'needs subpool {manifest["core_min"]} or later')
                if set(manifest['settings']) & set(CORE_SETTINGS_DEFAULTS):
                    raise ValueError('add-on settings collide with core settings')
                for other, prefixes in ADDON_NAMESPACES.items():
                    if other != aid and set(prefixes) & set(manifest['settings_prefixes']):
                        raise ValueError(f'settings namespace already reserved by {other}')
                defaults = dict(manifest['settings'])
                if LEGACY_INSTALL:
                    defaults = {k: v.replace('com.subpool.', 'com.codexpool.', 1)
                                if k.endswith('_label') and isinstance(v, str) and v.startswith('com.subpool.')
                                else v for k, v in defaults.items()}
                SETTINGS_DEFAULTS.update(defaults)
                SETTABLE.update(manifest['settable'])
            except (OSError, ValueError, TypeError) as error:
                addon_error(aid, 'manifest', error)
    for aid in ADDON_NAMESPACES:
        if aid not in ADDON_PATHS:
            addon_error(aid, 'discovery', ValueError('code absent; settings namespace retained'))


def reserved_addon_setting(key):
    active = {a.id for a in ADDONS} if ADDON_READY else set()
    if any(aid in active and key.startswith(tuple(prefixes)) for aid, prefixes in ADDON_NAMESPACES.items()):
        return False
    return any(key.startswith(tuple(prefixes)) for prefixes in ADDON_NAMESPACES.values())


def addon_call(addon, hook, *args, default=None, transform=None):
    """Isolate lookup, execution AND result consumption, including SystemExit and lazy iterators.
    A failed hook is skipped for the rest of this process; other hooks and the core continue."""
    aid = addon.id
    if (aid, hook) in ADDON_FAILED_HOOKS:
        return default
    try:
        fn = getattr(addon, hook, None)
        if fn is None:
            return default
        with contextlib.redirect_stdout(sys.stderr):
            result = fn(*args)
            return transform(result) if transform else result
    except (Exception, SystemExit) as error:
        ADDON_FAILED_HOOKS.add((aid, hook))
        addon_error(aid, hook, error)
        return default


def check_addon_settings(addon, settings):
    """Validate a private settings copy; return only the add-on's derived values."""
    manifest = addon.manifest
    keys = set(manifest['settings'])
    candidate = copy.deepcopy(settings)
    fn = getattr(addon, 'settings_problems', None)
    with contextlib.redirect_stdout(sys.stderr):
        problems = list(fn(candidate) or []) if fn else []
    if {k: v for k, v in candidate.items() if k not in keys} != {
            k: v for k, v in settings.items() if k not in keys}:
        raise ValueError('settings hook changed settings it does not own')
    if not keys <= candidate.keys():
        raise ValueError('settings hook removed a setting')
    for key in keys:
        value = candidate[key]
        if key.endswith('_port') and (type(value) is not int or not 0 < value < 65536):
            problems.append(f'invalid {key}')
        if key.endswith('_label') and (not isinstance(value, str) or not LABEL_OK.fullmatch(value)):
            problems.append(f'invalid {key}')
        if key in manifest['settable'] and value not in manifest['settable'][key]:
            problems.append(f'invalid {key}')
    for suffix in ('_port', '_label'):
        entries = [(k, v) for k, v in candidate.items() if k.endswith(suffix) or
                   (suffix == '_port' and k == 'port')]
        for key in keys:
            if key.endswith(suffix) and any(key != other and candidate[key] == v for other, v in entries):
                problems.append(f'{key} must differ from other {suffix[1:]} settings')
    if problems:
        raise ValueError('; '.join(map(str, problems)))
    return {k: candidate[k] for k in keys}


def addon_settings(s):
    for addon in ADDONS:
        values = addon_operation(addon, 'settings_problems', lambda: check_addon_settings(addon, s), {})
        s.update(values)
    return s


def addon_operation(addon, hook, operation, default=None):
    """Apply the same isolation to a hook plus its core-side transaction."""
    if (addon.id, hook) in ADDON_FAILED_HOOKS:
        return default
    try:
        return operation()
    except (Exception, SystemExit) as error:
        ADDON_FAILED_HOOKS.add((addon.id, hook))
        addon_error(addon.id, hook, error)
        return default


# A reader never creates runtime state. Once an add-on writer has made this lock,
# hold it across both bootstrap phases to avoid observing a partial code publication.
_ADDON_READ_LOCK = None
try:
    _ADDON_READ_LOCK = (STATE / 'addon-code.lock').open('r')
    fcntl.flock(_ADDON_READ_LOCK, fcntl.LOCK_SH)
except FileNotFoundError:
    pass
except OSError as error:
    addon_error('discovery', 'lock', error)
discover_addons()


class SettingsError(Exception):
    """settings.json is not valid; the message says what is wrong and names the file."""


def load_settings():
    """settings.json over the defaults. A broken file stops every command, the guard included, rather than
    letting it run against the wrong port or launchd labels."""
    try:
        raw = json.loads(SETTINGS_FILE.read_text())
    except FileNotFoundError:
        raw = {}
    except (OSError, ValueError) as e:
        sys.exit(f'subpool: cannot read {SETTINGS_FILE}: {e}')
    try:
        return parse_settings(raw)
    except SettingsError as e:
        sys.exit(f'subpool: {e}')


def parse_settings(raw, where=None):
    """The settings a parsed settings.json gives, over the defaults (pure). Raises SettingsError for anything
    load_settings must refuse: not an object, an unknown key, a bad label, port, interpreter or choice."""
    where = where or SETTINGS_FILE
    if not isinstance(raw, dict):
        raise SettingsError(f'{where} must hold a JSON object')
    unknown = [k for k in raw if k not in SETTINGS_DEFAULTS and not str(k).startswith('_')
               and not reserved_addon_setting(str(k))]
    if unknown:
        raise SettingsError(f'unknown key(s) {", ".join(map(str, unknown))} in {where} '
                            f'(known: {", ".join(SETTINGS_DEFAULTS)}; keys starting with _ are ignored)')
    s = {**SETTINGS_DEFAULTS, **{k: v for k, v in raw.items() if k in SETTINGS_DEFAULTS}}
    if 'bridge_port' not in raw and s['port'] == SETTINGS_DEFAULTS['bridge_port']:
        s['bridge_port'] = s['port'] + 1  # a pool moved to 8320 before bridge_port existed keeps working
    # Missing add-on ports take the next unused port, in manifest/default order.
    ports = ['port', 'bridge_port']
    for key in SETTINGS_DEFAULTS:
        if key.endswith('_port') and key not in ports:
            if key not in raw and any(key in m.get('auto_ports', []) for m in ADDON_MANIFESTS.values()) and \
                    all(type(s[k]) is int for k in ports + [key]):
                while s[key] in [s[k] for k in ports]:
                    s[key] += 1
            ports.append(key)
    labels = tuple(k for k in CORE_SETTINGS_DEFAULTS if k.endswith('_label'))
    bad = [k for k in labels if not isinstance(s[k], str) or not LABEL_OK.match(s[k])]
    if not bad and len({s[k] for k in labels}) != len(labels):
        bad.append('launchd labels (must all differ)')
    bad += [k for k in ('python', 'menubar_python', 'codex_bin')
            if s[k] is not None and (not isinstance(s[k], str) or not s[k].strip())]
    for k in ('port', 'bridge_port'):
        if isinstance(s[k], bool) or not isinstance(s[k], int) or not 0 < s[k] < 65536:
            bad.append(k)
    if 'port' not in bad and 'bridge_port' not in bad and s['bridge_port'] == s['port']:
        bad.append('bridge_port (must differ from port)')
    bad += [f'{k} (one of: {", ".join(choices)})' for k, choices in CORE_SETTABLE.items() if s[k] not in choices]
    if bad:
        raise SettingsError(f'invalid {", ".join(bad)} in {where}')
    return addon_settings(s) if ADDON_READY else s


SETTINGS = load_settings()
PORT = SETTINGS['port']
BASE = f'http://127.0.0.1:{PORT}'
POOL_JOB = SETTINGS['pool_label']
GUARD_JOB = SETTINGS['guard_label']
