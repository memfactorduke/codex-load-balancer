PROBE_ORIGIN = 'https://codexpool-probe.invalid'  # doctor/upgrade probes; excluded from blocked-request counts
LOG_LINE = re.compile(r'^\[(\d{4}-\d\d-\d\d \d\d:\d\d):\d\d\] \[[^\]]*\] \[[^\]]*\] \[([A-Za-z0-9_.-]+\.go):\d+\] (.*)$')
