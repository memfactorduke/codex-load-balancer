    add_addon_parser(sub)
    if _track:
        _ADDON_PARSERS.add(p)
    return p


def main():
    try:
        args = build_parser().parse_args(sys.argv[1:] or ['status'])
        ensure_python(args.cmd)
        for sig in (signal.SIGHUP, signal.SIGTERM):
            signal.signal(sig, _raise_exit)  # closing the terminal or launchd stopping us still runs cleanup
        try:
            args.fn(args)
        except PoolDown as e:
            sys.exit(f'subpool: pool not reachable on :{PORT} ({e}). Try: subpool restart ; subpool doctor')
        except ApiError as e:
            sys.exit(f'subpool: management API error: {short(str(e), 200)}')
        except KeyUnavailable as e:
            sys.exit(f'subpool: {e}\n  fix: {e.fix}')
        except LaneError as e:
            sys.exit('\n'.join(f'subpool: {p}' for p in e.problems))
    finally:
        addon_warnings(lambda message: print(message, file=sys.stderr))


# ---------------------------------------------------------------- optional local add-ons

class LoadedAddon:
    """Stable metadata from JSON, with optional executable hooks delegated to load(cp)'s result."""
    def __init__(self, manifest, path, implementation, fingerprint=None):
        self.id, self.version, self.core_min = (manifest[k] for k in ('id', 'version', 'core_min'))
        self.manifest, self.path, self.implementation = copy.deepcopy(manifest), path, implementation
        self.fingerprint = fingerprint

    def __getattr__(self, name):
        return getattr(self.implementation, name, self.manifest.get(name))


class AddonSourceLoader(importlib.machinery.SourceFileLoader):
    """A content-checked reload must not execute timestamp-cached bytecode."""
    def get_code(self, fullname):
        return compile(self.get_data(self.path), self.path, 'exec', dont_inherit=True)


class AddonSourceFinder:
    def __init__(self, name):
        self.prefix = name + '.'

    def find_spec(self, fullname, path=None, target=None):
        if fullname.startswith(self.prefix):
            spec = importlib.machinery.PathFinder.find_spec(fullname, path)
            if spec and isinstance(spec.loader, importlib.machinery.SourceFileLoader):
                spec.loader = AddonSourceLoader(fullname, spec.origin)
            return spec
        return None


def load_addon(path, manifest, *, reload=False, _prepare=False):
    """Reuse unchanged packages; publish replacements to every core-owned registry.

    Install/remove validation uses a separate package namespace, so even a failed
    installation cannot disturb active callbacks or their lazy relative imports.
    """
    path = pathlib.Path(path).absolute()
    files = addon_code_files(path, manifest)  # validate the entire payload before executing Python
    fingerprint = (str(path.resolve()), json.dumps(manifest, sort_keys=True),
                   tuple((str(rel), hashlib.sha256(src.read_bytes()).hexdigest()) for src, rel in files))
    aid = manifest['id']
    existing = _LOADED_ADDONS.get(aid)
    if not _prepare and not reload and existing is not None and existing.fingerprint == fingerprint:
        return existing
    name = ('subpool_prepared_addon_' if _prepare else 'subpool_addon_') + aid
    spec = importlib.util.spec_from_file_location(name, path / 'addon.py',
        loader=AddonSourceLoader(name, str(path / 'addon.py')), submodule_search_locations=[str(path)])
    module = importlib.util.module_from_spec(spec)
    prior = {k: v for k, v in sys.modules.items() if k == name or k.startswith(name + '.')}
    for key in prior:
        del sys.modules[key]
    sys.modules[name] = module
    finder = AddonSourceFinder(name)
    sys.meta_path.insert(0, finder)
    try:
        with contextlib.redirect_stdout(sys.stderr):
            spec.loader.exec_module(module)
            implementation = module.load(sys.modules[__name__])
        for key in ('id', 'version', 'core_min'):
            if getattr(implementation, key, None) != manifest[key]:
                raise ValueError(f'load(cp).{key} differs from manifest')
        for key in ('settings', 'settable', 'code_files'):
            value = getattr(implementation, key, None)
            if value is not None and (list(value) if key == 'code_files' else value) != manifest[key]:
                raise ValueError(f'{key} must be declared in addon.json')
        addon = LoadedAddon(manifest, path, implementation, fingerprint)
    except (Exception, SystemExit):
        for key in list(sys.modules):
            if key == name or key.startswith(name + '.'):
                del sys.modules[key]
        sys.modules.update(prior)
        raise
    finally:
        sys.meta_path.remove(finder)
    if not _prepare:
        _LOADED_ADDONS[aid] = addon
        if any(a.id == aid for a in ADDONS):
            ADDONS[:] = [addon if a.id == aid else a for a in ADDONS]
            ADDON_MANIFESTS[aid], ADDON_PATHS[aid] = addon.manifest, path
            ADDON_ERRORS.pop(aid, None)
            ADDON_FAILED_HOOKS.difference_update({entry for entry in ADDON_FAILED_HOOKS if entry[0] == aid})
            register_addon_extensions()
            # Callers may retain a root parser; replace its tree in place so its
            # command and provider callbacks all refer to the same generation.
            for parser in list(_ADDON_PARSERS):
                fresh = build_parser(_track=False)
                parser.__dict__.clear()
                parser.__dict__.update(fresh.__dict__)
    return addon


def prepare_addon(path, manifest):
    """Validate install/remove code with its declared settings, without changing the current registry."""
    global SETTINGS
    original = SETTINGS
    try:
        SETTINGS = {**manifest['settings'], **original}
        addon = load_addon(path, manifest, reload=True, _prepare=True)
        check_addon_settings(addon, SETTINGS)
        return addon
    finally:
        SETTINGS = original


def initialize_addons():
    global ADDON_READY
    for aid, manifest in sorted(ADDON_MANIFESTS.items()):
        if aid in ADDON_ERRORS:
            continue
        try:
            addon = load_addon(ADDON_PATHS[aid], manifest)
            if not any(a.id == aid for a in ADDONS):
                ADDONS.append(addon)
        except (Exception, SystemExit) as error:
            addon_error(aid, 'load', error)
    ADDON_READY = True
    prune_addon_settings()
    with contextlib.redirect_stdout(sys.stderr):
        SETTINGS.update(load_settings())
    # A broken settings validator disables the add-on, not the core settings/guard.
    ADDONS[:] = [a for a in ADDONS if (a.id, 'settings_problems') not in ADDON_FAILED_HOOKS]
    prune_addon_settings()


def prune_addon_settings():
    active = {a.id for a in ADDONS}
    owned = {key for aid in active for key in ADDON_MANIFESTS[aid]['settings']}
    for aid, manifest in ADDON_MANIFESTS.items():
        if aid not in active:
            for key in manifest['settings']:
                if key not in CORE_SETTINGS_DEFAULTS and key not in owned:
                    SETTINGS.pop(key, None)
                    SETTINGS_DEFAULTS.pop(key, None)
                    SETTABLE.pop(key, None)


def addon_warnings(sink):
    for aid, error in sorted(ADDON_ERRORS.items()):
        sink(f'subpool add-on {aid}: {error}')


def doctor_addons(rep):
    for addon in ADDONS:
        # Buffer each report so a half-written section cannot corrupt the core report.
        def report(a=addon):
            extra = DoctorReport(echo=False)
            fn = getattr(a, 'doctor', None)
            if fn:
                with contextlib.redirect_stdout(sys.stderr):
                    fn(extra)
            for section in extra.sections:
                rep.section(section['title'])
                for check in section['checks']:
                    rep.check(check['status'] == 'ok', check['text'], check['fix'], warn=check['status'] == 'warn')
        addon_operation(addon, 'doctor', report)
    if ADDONS or ADDON_ERRORS:
        rep.section('Add-ons')
        for addon in ADDONS:
            rep.check(True, f'{addon.id} {addon.version}')
        for aid, error in sorted(ADDON_ERRORS.items()):
            rep.check(False, f'{aid}: {error}', 'repair or reinstall the add-on; Codex core remains available', warn=True)


def addon_parsers(sub):
    for addon in ADDONS:
        def register(a=addon):
            # A private parser tree prevents a partial/failed hook from reserving a command,
            # mutating a core parser, or replacing an alias. Publish only after success.
            parser = argparse.ArgumentParser(prog='subpool')
            stage = parser.add_subparsers(dest='cmd', required=True)
            fn = getattr(a, 'add_parser', None)
            if fn:
                with contextlib.redirect_stdout(sys.stderr):
                    fn(stage, sys.modules[__name__])
            if set(stage.choices) & (set(sub.choices) | {'addon'}):
                raise ValueError('command or alias collides with a core/registered command')
            sub.choices.update(stage.choices)
            sub._choices_actions.extend(stage._choices_actions)
        addon_operation(addon, 'add_parser', register)


def addon_guard_passes():
    # This runs only AFTER the existing core passes, never while constructing their list.
    for addon in ADDONS:
        def run(a=addon):
            fn = getattr(a, 'guard_passes', None)
            passes = list(fn() or []) if fn else []
            for name, callback, pool in passes:
                if not isinstance(pool, SeatPool) or pool.name in CORE_POOL_IDS or pool.lock == LOCK_FILE:
                    raise ValueError('add-on guard requires its own SeatPool and lock')
                with guard_lock(wait=False, pool=pool) as got:
                    if got:
                        callback()
        addon_operation(addon, 'guard_passes', run)
    addon_warnings(log_line)


def addon_status(live, existing):
    entries = []
    for addon in ADDONS:
        def status(a=addon):
            fn = getattr(a, 'status', None)
            with contextlib.redirect_stdout(sys.stderr):
                result = fn(live) if fn else None
            if result is None:
                return
            key, data, printer = result
            if not isinstance(key, str) or key in existing or key in {r[1] for r in entries}:
                raise ValueError('status key collides with an existing field')
            json.dumps(data)  # malformed data must not break the core JSON output
            if not callable(printer):
                raise ValueError('status print_fn must be callable (no arguments)')
            entries.append((a, key, data, printer))
        addon_operation(addon, 'status', status)
    return entries


def addon_objects(hook, mapping=False):
    """Materialize hook collections inside the failure boundary, including generators."""
    for addon in ADDONS:
        values = addon_call(addon, hook, default={} if mapping else [], transform=dict if mapping else list)
        yield addon, values


def addon_code_files(path, manifest):
    """Only declared code; no escaping paths, symlinks, bytecode, or runtime state."""
    files = {path / 'addon.json'}
    for relative in manifest['code_files']:
        src = path / relative
        if not src.exists():
            raise ValueError(f'missing code file {relative}')
        files.update([src] if src.is_file() else src.rglob('*'))
    result = []
    for src in sorted(files):
        if src.is_symlink() or path.resolve() not in src.resolve().parents:
            raise ValueError('code_files may not contain symlinks or escape the add-on')
        if '__pycache__' in src.parts or src.suffix == '.pyc':
            continue
        if src.is_file():
            result.append((src, pathlib.Path('addons') / manifest['id'] / src.relative_to(path)))
    return result


def reserve_addon_namespaces(manifest):
    try:
        registry = json.loads(ADDON_REGISTRY.read_text())
    except FileNotFoundError:
        registry = {}
    if not isinstance(registry, dict):
        raise ValueError('namespace registry must be an object')
    aid = manifest['id']
    prefixes = set(manifest['settings_prefixes'])
    for other, claimed in {**ADDON_NAMESPACES, **registry}.items():
        if other != aid and prefixes & set(claimed):
            raise ValueError(f'settings namespace already reserved by {other}')
    if set(manifest['settings']) & set(CORE_SETTINGS_DEFAULTS):
        raise ValueError('add-on settings collide with core settings')
    registry[aid] = sorted(prefixes | set(registry.get(aid, [])))
    write_json(ADDON_REGISTRY, registry)


@contextlib.contextmanager
def addon_code_lock():
    """Writers publish complete staged code under one lock; discovery readers hold a shared lock."""
    STATE.mkdir(parents=True, exist_ok=True)
    with (STATE / 'addon-code.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)


def copy_code_with_addons():
    """Stage all code before publishing. Add-on directories precede the CLI; rollback on failure.
    State, config, auth, build links and running processes never participate in this transaction.
    Readers that discover add-ons wait until the directory/CLI rename batch is complete."""
    with addon_code_lock():
        stage = pathlib.Path(tempfile.mkdtemp(prefix='.addon-code-', dir=ROOT))
        committed, cleanup = [], True
        try:
            pairs = code_files()
            if any((a.id, 'code_files') in ADDON_FAILED_HOOKS for a in ADDONS):
                raise RuntimeError('add-on code is incomplete; no code was installed')
            payload, backups = stage / 'payload', stage / 'backups'
            for src, dest in pairs:
                target = payload / dest.relative_to(ROOT)
                target.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(src, target)
            bridge_dest = None
            if BRIDGE_CONFIG.is_file():
                old = read_text(BRIDGE_CONFIG)
                config = json.loads(old)
                changed = False
                for addon in ADDONS:
                    fn = getattr(addon, 'install_bridge_config', None)
                    if fn:
                        changed = bool(fn(config)) or changed
                if changed:
                    bridge_dest = BRIDGE_CONFIG
                    target = payload / bridge_dest.relative_to(ROOT)
                    target.parent.mkdir(parents=True, exist_ok=True)
                    target.write_text(json.dumps(config, indent=2) + '\n')
                    os.chmod(target, BRIDGE_CONFIG.stat().st_mode & 0o777)
            # Reservations are written first so even a killed writer cannot orphan settings.
            for addon in ADDONS:
                reserve_addon_namespaces(addon.manifest)
            destinations = [dest for _, dest in pairs if 'addons' != dest.relative_to(ROOT).parts[0]]
            destinations += [ROOT / 'addons' / a.id for a in ADDONS]
            if bridge_dest is not None:
                destinations.append(bridge_dest)
            destinations = sorted(set(destinations), key=lambda p: (p == ROOT / 'bin/subpool', str(p)))
            for dest in destinations:
                rel = dest.relative_to(ROOT)
                source, backup = payload / rel, backups / rel
                dest.parent.mkdir(parents=True, exist_ok=True)
                existed = dest.exists() or dest.is_symlink()
                if existed:
                    if source.is_file() and not dest.is_symlink() and source.read_bytes() == dest.read_bytes():
                        continue
                    backup.parent.mkdir(parents=True, exist_ok=True)
                    if dest.is_dir() or dest.is_symlink():
                        os.replace(dest, backup)
                    else:
                        shutil.copy2(dest, backup)
                committed.append((dest, backup, existed))
                os.replace(source, dest)
        except BaseException:
            try:
                for dest, backup, existed in reversed(committed):
                    if dest.is_dir() and not dest.is_symlink():
                        shutil.rmtree(dest)
                    elif dest.exists() or dest.is_symlink():
                        dest.unlink()
                    if existed:
                        os.replace(backup, dest)
            except BaseException as error:
                cleanup = False
                raise RuntimeError(f'code rollback failed; recovery files retained at {stage}: {error}') from error
            raise
        finally:
            if cleanup:
                shutil.rmtree(stage)


def cmd_addon(args):
    if args.addon_cmd == 'list':
        active = {a.id: a for a in ADDONS}
        for aid in sorted(set(ADDON_NAMESPACES) | set(ADDON_ERRORS)):
            version = active[aid].version if aid in active else ADDON_MANIFESTS.get(aid, {}).get('version', '-')
            print(f'{aid} {version}: ' + (ADDON_ERRORS[aid] if aid in ADDON_ERRORS else 'loaded'))
        if not ADDON_NAMESPACES and not ADDON_ERRORS:
            print('No add-ons installed.')
        return
    try:
        with settings_lock(), addon_code_lock():
            if args.addon_cmd == 'install':
                source = pathlib.Path(args.path).expanduser().resolve()
                manifest = read_addon_manifest(source)
                if parse_version(manifest['core_min']) > parse_version(VERSION):
                    raise ValueError(f'needs subpool {manifest["core_min"]} or later')
                files = addon_code_files(source, manifest)
                # Validate executable code only after metadata and the complete core are available.
                addon = prepare_addon(source, manifest)
                parent = ROOT / 'addons'
                parent.mkdir(parents=True, exist_ok=True)
                stage = pathlib.Path(tempfile.mkdtemp(prefix='.addon-stage-', dir=parent))
                dest = parent / manifest['id']
                backup = stage / 'previous'
                cleanup = True
                try:
                    payload = stage / 'payload'
                    payload.mkdir()
                    for src, rel in files:
                        target = payload / rel.relative_to(pathlib.Path('addons') / manifest['id'])
                        target.parent.mkdir(parents=True, exist_ok=True)
                        shutil.copy2(src, target)
                    # Reservation survives incomplete installs and missing code. Never stores settings values.
                    reserve_addon_namespaces(manifest)
                    if dest.exists() or dest.is_symlink():
                        os.replace(dest, backup)
                    try:
                        os.replace(payload, dest)
                    except BaseException:
                        if backup.exists() or backup.is_symlink():
                            try:
                                os.replace(backup, dest)
                            except BaseException as error:
                                cleanup = False
                                raise RuntimeError(f'rollback failed; previous code retained at {backup}: {error}') from error
                        raise
                finally:
                    if cleanup:
                        shutil.rmtree(stage)
                print(f'Installed add-on {addon.id} {addon.version}.')
                hint = getattr(addon, 'install_hint', None)
                if hint:
                    print(hint)
            else:
                aid = args.id
                if not ADDON_ID_OK.fullmatch(aid):
                    raise ValueError('invalid add-on id')
                dest = ROOT / 'addons' / aid
                if not dest.exists():
                    raise ValueError(f'{aid} has no installed code')
                manifest = read_addon_manifest(dest)
                if manifest['id'] != aid or parse_version(manifest['core_min']) > parse_version(VERSION):
                    raise ValueError('installed add-on is incompatible; repair it before removal')
                addon = prepare_addon(dest, manifest)
                fn = getattr(addon, 'uninstall_plan', None)
                if fn and list(fn() or []):
                    raise ValueError(f'{aid} still has installed components; run its uninstall command first')
                # Keep the namespaces and every runtime file; only the code directory goes away.
                reserve_addon_namespaces(addon.manifest)
                if dest.is_symlink():
                    dest.unlink()
                else:
                    shutil.rmtree(dest)
                print(f'Removed add-on {aid} code; settings namespaces and runtime state retained.')
    except (Exception, SystemExit) as error:
        sys.exit(f'subpool addon: {error}')


def add_addon_parser(sub):
    # Step 1 keeps the existing root --help byte-for-byte. Management is available through
    # `subpool addon --help`; expose it in root help when the extraction lands.
    sub.metavar = '{' + ','.join(sub.choices) + '}'
    parser = sub.add_parser('addon')
    actions = parser.add_subparsers(dest='addon_cmd', required=True)
    actions.add_parser('list', help='list loaded and unavailable add-ons').set_defaults(fn=cmd_addon)
    install = actions.add_parser('install', help='install a local add-on code tree')
    install.add_argument('path', metavar='PATH')
    install.set_defaults(fn=cmd_addon)
    remove = actions.add_parser('remove', help='remove inactive add-on code, keeping state')
    remove.add_argument('id', metavar='ID')
    remove.set_defaults(fn=cmd_addon)


def addon_bridge_extension(plan, config):
    """Declare installed extension paths only for providers contributing routes to this plan."""
    used = {m['provider'] for lane in plan for m in lane['members']}
    for addon in ADDONS:
        def contribute(a=addon):
            extension = getattr(a, 'bridge_extension', None)
            if extension is None:
                return
            fn = getattr(a, 'lane_providers', None)
            providers = dict(fn() or {}) if fn else {}
            if not used.intersection(providers):
                return
            path = pathlib.Path(extension)
            if not path.is_absolute() or not path.is_file() or a.path.resolve() not in path.resolve().parents:
                raise ValueError('bridge extension must be an absolute file path inside the add-on')
            installed = ROOT / 'addons' / a.id / path.relative_to(a.path)
            config.setdefault('extensions', {})[a.id] = str(installed)
        addon_operation(addon, 'bridge_extension', contribute)


def addon_gate_contributions():
    contributions, profiles, names = [], set(('', 'codex')), {'codexpool_gate.go'}
    for addon in ADDONS:
        def collect(a=addon):
            fn = getattr(a, 'gate', None)
            gate = fn() if fn else None
            if gate is None:
                return
            own_profiles = dict(getattr(gate, 'profiles', {}))
            sources = [pathlib.Path(p) for p in getattr(gate, 'sources', ())]
            inputs = [pathlib.Path(p) for p in getattr(gate, 'hash_inputs', ())]
            if any(not isinstance(k, str) or not k or k.strip() != k or not callable(v) for k, v in own_profiles.items()):
                raise ValueError('gate profiles must map names to case functions')
            if profiles & own_profiles.keys() or names & {p.name for p in sources}:
                raise ValueError('gate profile or source collides with another contribution')
            if len({p.name for p in sources}) != len(sources):
                raise ValueError('duplicate gate source filename')
            for path in sources + inputs:
                if not path.is_file() or a.path.resolve() not in path.resolve().parents:
                    raise ValueError('gate files must exist inside the add-on')
            contributions.append((a, gate, own_profiles, sources, inputs))
            profiles.update(own_profiles)
            names.update(p.name for p in sources)
        addon_operation(addon, 'gate', collect)
    return contributions


def addon_uninstall_steps():
    steps = []
    for addon in ADDONS:
        def collect(a=addon):
            fn = getattr(a, 'uninstall_plan', None)
            plan = list(fn() or []) if fn else []
            if any(not isinstance(text, str) or not callable(action) for text, action in plan):
                raise ValueError('uninstall_plan must return (text, callable) pairs')
            steps.extend((a, text, action) for text, action in plan)
        addon_operation(addon, 'uninstall_plan', collect)
    return steps


def register_addon_extensions():
    global GUI_POOLS, GATE_PROFILES
    # Rebuild derived registries rather than retaining callbacks from an older
    # package or reporting our own earlier registrations as collisions.
    for key, provider in list(LANE_PROVIDERS.items()):
        if isinstance(provider, LaneProvider) and provider.addon is not None:
            del LANE_PROVIDERS[key]
    GUI_POOLS, GATE_PROFILES = CORE_GUI_POOLS, CORE_GATE_PROFILES
    for addon in ADDONS:
        def register(a=addon):
            fn = getattr(a, 'lane_providers', None)
            providers = dict(fn() or {}) if fn else {}
            if providers.keys() & LANE_PROVIDERS.keys():
                raise ValueError('lane provider collides with an existing provider')
            entries = {}
            for key, provider in providers.items():
                # Preserve provider methods behind the isolated callback adapter.
                entry = LaneProvider(provider, a)
                if not isinstance(key, str) or not isinstance(entry.get('kind'), str):
                    raise ValueError('lane provider needs a string id and kind')
                entries[key] = entry
            LANE_PROVIDERS.update(entries)
        addon_operation(addon, 'lane_providers', register)
        def ui(a=addon):
            global GUI_POOLS
            if getattr(a, 'menubar_extension', None):
                ids = tuple(getattr(a, 'ui_pool_ids', None) or (a.id,))
                if any(not isinstance(i, str) or not i for i in ids):
                    raise ValueError('ui_pool_ids must be non-empty strings')
                if set(ids) & set(GUI_POOLS):
                    raise ValueError('UI pool id collides with a core pool')
                GUI_POOLS += ids
        addon_operation(addon, 'menubar_extension', ui)
    GATE_PROFILES += tuple(profile for _, _, profiles, _, _ in addon_gate_contributions() for profile in profiles)


try:
    with contextlib.redirect_stdout(sys.stderr):
        initialize_addons()
        register_addon_extensions()
finally:
    if _ADDON_READ_LOCK is not None:
        _ADDON_READ_LOCK.close()


if __name__ == '__main__':
    main()
