<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>{{LABEL}}</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{ROOT}}/bin/claude-current/cli-proxy-api</string>
		<string>-config</string>
		<string>{{ROOT}}/config-claude.yaml</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>CODEXPOOL_GATE_PROFILE</key>
		<string>claude</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>{{ROOT}}/claude</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>{{ROOT}}/claude/logs/launchd.log</string>
	<key>StandardErrorPath</key>
	<string>{{ROOT}}/claude/logs/launchd.log</string>
</dict>
</plist>
