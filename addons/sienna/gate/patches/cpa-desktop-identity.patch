+// Desktop uses the same engine protocol. Native recognition must retain its
+// session while still requiring the existing version and strong-signal checks.
+func TestDesktopThirdPartyNativeSession(t *testing.T) {
+	headers := confirmedClaudeCodeHeaders()
+	headers.Set("User-Agent", "claude-cli/2.1.281 (external, claude-desktop-3p)")
+	const session = "11111111-2222-4333-8444-555555555555"
+	headers.Set("X-Claude-Code-Session-Id", session)
+	payload := claudeCodeDetectionPayload(validClaudeCodeMetadataUserID)
+	detection := DetectClaudeCodeRequest(headers, payload, false)
+	if !detection.Confirmed || !detection.NativeClient {
+		t.Fatal("desktop third-party engine was not confirmed")
+	}
+	if got := ClaudeAgentSessionUUIDForRequest(headers, payload, payload, detection.Confirmed); got != session {
+		t.Fatal("native desktop session was not preserved")
+	}
+	if !DetectClaudeCodeRequest(headers, nil, true).Confirmed {
+		t.Fatal("desktop token-count headers were not confirmed")
+	}
+	for _, name := range []string{"X-App", "Anthropic-Beta", "User-Agent"} {
+		incomplete := headers.Clone()
+		incomplete.Del(name)
+		if DetectClaudeCodeRequest(incomplete, payload, false).Confirmed {
+			t.Fatalf("confirmed without %s", name)
+		}
+	}
+	if DetectClaudeCodeRequest(headers, []byte(`{"messages":[]}`), false).Confirmed {
+		t.Fatal("confirmed without message metadata")
+	}
+	headers.Set("X-App", "cli-bg")
+	if DetectClaudeCodeRequest(headers, payload, false).Confirmed {
+		t.Fatal("confirmed background caller")
+	}
+	headers.Set("X-App", "cli")
+	headers.Set("User-Agent", "claude-cli/99.0.0 (external, claude-desktop-3p)")
+	if DetectClaudeCodeRequest(headers, payload, false).Confirmed {
+		t.Fatal("confirmed unmeasured release line")
+	}
+}
